@@ -0,0 +1,167 @@
+"""Bounded immutable published stripe history; no images, acquisition or SDK I/O."""
+from collections import deque
+import copy
+import sys
+import threading
+import time
+
+import numpy as np
+
+
+class FrozenCloud(dict):
+    """A JSON-compatible immutable mapping whose children are immutable too."""
+    def _readonly(self, *args, **kwargs):
+        raise TypeError('Published native cloud is immutable')
+    __setitem__ = __delitem__ = clear = pop = popitem = setdefault = update = __ior__ = _readonly
+
+    def __deepcopy__(self, memo):
+        return copy.deepcopy(dict(self), memo)
+
+
+def freeze(value):
+    if isinstance(value, FrozenCloud):
+        return value
+    if isinstance(value, dict):
+        return FrozenCloud({key: freeze(item) for key, item in value.items()})
+    if isinstance(value, (list, tuple)):
+        return tuple(freeze(item) for item in value)
+    if isinstance(value, np.ndarray):
+        result = np.array(value, copy=True)
+        result.flags.writeable = False
+        return result
+    return value
+
+
+def _memory_size(value, seen=None):
+    seen = set() if seen is None else seen
+    if id(value) in seen:
+        return 0
+    seen.add(id(value))
+    size = sys.getsizeof(value)
+    if isinstance(value, np.ndarray):
+        return size+value.nbytes  # Conservatively count array storage twice.
+    if isinstance(value, dict):
+        return size+sum(_memory_size(key, seen)+_memory_size(item, seen) for key,item in value.items())
+    if isinstance(value, tuple):
+        return size+sum(_memory_size(item, seen) for item in value)
+    return size
+
+
+class NativeCloudHistory:
+    def __init__(self, capacity=128, *, max_points=100000, max_bytes=32*1024*1024, max_age_s=3.):
+        if type(capacity) is not int or not 1 <= capacity <= 128 or type(max_points) is not int or not 1 <= max_points <= 100000 or type(max_bytes) is not int or not 1 <= max_bytes <= 32*1024*1024:
+            raise ValueError('Native history count/point/byte limits exceed bounds')
+        self.capacity,self.max_points,self.max_bytes,self.max_age_s=capacity,max_points,max_bytes,max_age_s
+        self._lock=threading.Lock()
+        self._entries=deque()
+        self._points=self._bytes=0
+        self._identity=None
+        self._evicted_key=None
+        self._invalidated_key=None
+        self._epoch=0
+        self._error=None
+        self._published_total=self._evicted_total=0
+
+    def clear(self, reason=None):
+        with self._lock:
+            if self._entries:
+                self._invalidated_key=self._entries[-1][0]
+            self._entries.clear()
+            self._points=self._bytes=0
+            self._epoch+=1
+            self._error=reason
+
+    def publish(self, cloud, optical_id):
+        metadata=cloud.metadata
+        timing=metadata.get('timing') or {}
+        device=timing.get('device_frame_id')
+        session=metadata.get('acquisition_session_id')
+        if type(device) is not int or not 0 <= device < 2**64 or not isinstance(session,str) or not session:
+            return False  # Ordinary previews may exist without physical frame IDs.
+        count=len(cloud.xyz_mm)
+        if count>20000:
+            raise ValueError('Native history cloud exceeds 20000 stripe points')
+        for value,shape in ((cloud.xyz_mm,(count,3)),(cloud.uv,(count,2)),
+                            (cloud.strength,(count,)),(cloud.width_px,(count,))):
+            if value.shape != shape or not np.isfinite(value).all():
+                raise ValueError('Native stripe channels must align and remain finite')
+        key=(session,device)
+        identity=(metadata.get('source_id'),optical_id,metadata.get('calibration_id'),session,metadata.get('generation'))
+        payload=cloud.summary()
+        # PointCloud metadata is measurement-only; explicitly discard image
+        # payload aliases rather than retaining a native/preview image buffer.
+        for name in ('frame','image','preview','native_frame','raw_frame','preview_frame','frame_jpeg_base64'):
+            payload.pop(name,None)
+        payload.update(optical_intrinsics_id=optical_id, xyz_mm=cloud.xyz_mm, uv=cloud.uv,
+                       strength=cloud.strength,width_px=cloud.width_px)
+        payload=freeze(payload)
+        size=_memory_size(payload)
+        count=len(cloud.xyz_mm)
+        with self._lock:
+            if self._identity != identity:
+                if self._entries:
+                    self._invalidated_key=self._entries[-1][0]
+                self._entries.clear()
+                self._points=self._bytes=0
+                self._identity=identity
+                self._epoch+=1
+            if self._entries and key[1] <= self._entries[-1][0][1]:
+                if key==self._entries[-1][0]:
+                    return False
+                raise ValueError('Native published device frame ID regressed')
+            if count>self.max_points or size>self.max_bytes:
+                self._evicted_key=key
+                self._error='A native stripe exceeds history point/byte budget'
+                return False
+            self._published_total+=1
+            self._entries.append((key,payload,count,size))
+            self._points+=count
+            self._bytes+=size
+            self._error=None
+            while len(self._entries)>self.capacity or self._points>self.max_points or self._bytes>self.max_bytes:
+                old,_,points,byte_count=self._entries.popleft()
+                self._evicted_key=old
+                self._evicted_total+=1
+                self._points-=points
+                self._bytes-=byte_count
+        return True
+
+    def status(self):
+        """Compact diagnostics only: no stripe arrays or reader cursor changes."""
+        with self._lock:
+            return dict(capacity=self.capacity,stored_frames=len(self._entries),stored_points=self._points,
+                payload_bytes=self._bytes,max_points=self.max_points,max_bytes=self.max_bytes,
+                oldest_device_id=self._entries[0][0][1] if self._entries else None,
+                newest_device_id=self._entries[-1][0][1] if self._entries else None,
+                acquisition_session_id=self._identity[3] if self._identity else None,
+                generation=self._identity[4] if self._identity else None,epoch=self._epoch,
+                published_total=self._published_total,evicted_total=self._evicted_total,
+                last_evicted_key=self._evicted_key,error=self._error)
+
+    def snapshot(self, after_key=None, *, now=None):
+        now=time.monotonic() if now is None else now
+        with self._lock:
+            identity=self._identity
+            session=identity[3] if identity else None
+            if type(after_key) is int:
+                after_key=(session,after_key)
+            if after_key is not None and (not isinstance(after_key,(tuple,list)) or len(after_key)!=2 or not isinstance(after_key[0],str) or type(after_key[1]) is not int):
+                raise ValueError('Native cursor must be (acquisition_session_id,device_frame_id)')
+            after_key=tuple(after_key) if after_key is not None else None
+            session_changed=bool(after_key is not None and session is not None and after_key[0]!=session)
+            overrun=session_changed
+            for lost in (self._evicted_key,self._invalidated_key):
+                if after_key is not None and lost is not None and after_key[0]==lost[0] and after_key[1]<lost[1]:
+                    overrun=True
+            fresh=tuple((key,cloud) for key,cloud,_,_ in self._entries
+                        if 0 <= now-cloud['read_started'] <= self.max_age_s)
+            if after_key is not None and fresh and not session_changed and after_key[1]>fresh[-1][0][1]:
+                overrun=True
+            selected=tuple(cloud for key,cloud in fresh if after_key is None or session_changed or key[1]>after_key[1])
+            return dict(clouds=selected,overrun=overrun,session_changed=session_changed,
+                oldest_key=fresh[0][0] if fresh else None,newest_key=fresh[-1][0] if fresh else None,
+                retained_keys=tuple(key for key,_,_,_ in self._entries),capacity=self.capacity,
+                acquisition_session_id=session,generation=identity[4] if identity else None,
+                epoch=self._epoch,stored_frames=len(self._entries),stored_points=self._points,
+                payload_bytes=self._bytes,max_points=self.max_points,max_bytes=self.max_bytes,
+                stale=bool(self._entries and not fresh),error=self._error)
