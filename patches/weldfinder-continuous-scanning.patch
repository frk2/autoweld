+"""Stage timings retain native acquisition identity; no real camera or server."""
+
+import json
+import time
+
+import numpy as np
+from test_pipeline_performance import pipeline, wait_for
+
+__all__ = ['pipeline']
+
+
+def cloud_with_timings(pipeline):
+    cloud = pipeline.snapshot(include_calibration=False)['pointcloud']
+    return cloud is not None and 'processing' in cloud.metadata
+
+
+def test_discovery_timings_preserve_frame_identity_and_do_not_run_board_or_overlay(pipeline):
+    wait_for(lambda: cloud_with_timings(pipeline))
+    cloud = pipeline.snapshot(include_calibration=False)['pointcloud']
+    timing = cloud.metadata['processing']
+    for key in ('sequence', 'generation', 'read_started', 'received'):
+        assert timing[key] == cloud.metadata[key]
+    assert timing['read_started'] <= timing['received'] <= timing['analysis_started'] <= timing['published_monotonic']
+    assert timing['queue_wait_ms'] >= 0
+    assert timing['checkerboard_ms'] == timing['overlay_ms'] == 0
+    assert timing['exposure_ms'] >= 0 and timing['xyz_ms'] > 0
+    assert timing['total_analysis_ms'] >= timing['exposure_ms']+timing['xyz_ms']
+    assert timing['age_at_publish_s'] == timing['published_monotonic']-cloud.metadata['read_started']
+    json.dumps(cloud.to_dict(), allow_nan=False)
+
+
+def test_slow_live_checkerboard_cost_is_visible_in_exact_cloud_publication(pipeline, monkeypatch):
+    def board(frame, settings, **kwargs):
+        time.sleep(.04)
+        return {'full': False, 'corners': None, 'grid': [0, 0], 'search_scale': .5,
+                'corners_count': 0, 'total_corners': 35, 'cells': 0, 'total_cells': 24,
+                'focus': 0., 'preview': np.zeros((240, 320, 3), np.uint8)}
+    monkeypatch.setattr('weldfinder.pipeline.board_observation', board)
+    pipeline.submit('board_detection', enabled=True).result(timeout=3)
+    def board_timed():
+        cloud = pipeline.snapshot(include_calibration=False)['pointcloud']
+        return cloud is not None and cloud.metadata.get('processing', {}).get('checkerboard_ms', 0) >= 30.
+    wait_for(board_timed)
+    cloud = pipeline.snapshot(include_calibration=False)['pointcloud']
+    timing = cloud.metadata['processing']
+    assert timing['checkerboard_ms'] >= 30.
+    assert timing['total_analysis_ms'] >= timing['checkerboard_ms']+timing['xyz_ms']
+    assert timing['age_at_publish_s'] >= timing['checkerboard_ms']/1000.
+    sequence = cloud.metadata['sequence']
+    pipeline.submit('board_detection', enabled=False).result(timeout=3)
+    wait_for(lambda: cloud_with_timings(pipeline))
+    fresh = pipeline.snapshot(include_calibration=False)['pointcloud']
+    assert fresh.metadata['generation'] > cloud.metadata['generation']
+    assert fresh.metadata['sequence'] > sequence
+    assert fresh.metadata['processing']['checkerboard_ms'] == 0
