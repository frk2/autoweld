+    if count < 2 or np.all(np.diff(scan) >= 1):
+        # Native extraction has at most one usable return per integer scanline.
+        # Thus only max_scan_gap_px subsequent indices can be neighbors. Count
+        # these bounded diagonals in arrays rather than one Python loop/point.
