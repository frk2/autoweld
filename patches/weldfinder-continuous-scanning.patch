@@ -0,0 +1,61 @@
+"""Native measurement regressions for batching scanline/run calculations."""
+
+import numpy as np
+import pytest
+
+from weldfinder.config import Detection
+from weldfinder.detection import extract
+
+
+@pytest.mark.parametrize('axis', ['columns', 'rows'])
+def test_variable_run_centroids_preserve_native_float32_weight_sum(axis):
+    image = np.zeros((35, 6), np.uint8)
+    image[2:5, 0] = [41, 52, 17]
+    image[2:9, 1] = [12, 44, 87, 33, 18, 22, 14]
+    image[7:18, 2] = [15, 60, 130, 57, 30, 16, 18, 22, 19, 25, 14]
+    image[2:4, 3] = [199, 240]
+    image[19:27, 3] = [20, 110, 128, 70, 60, 18, 13, 12]
+    image[3:9, 4] = [12, 25, 180, 150, 13, 10]
+    image[10:18, 5] = [15, 25, 50, 190, 120, 25, 15, 12]
+    if axis == 'rows':
+        image = image.T.copy()
+    config = Detection(threshold=7.982650117094364, relative_threshold=.20406525697339178,
+                       min_width=2, max_width=28, remove_background=False,
+                       reject_saturated=False, axis=axis)
+    stripe = extract(image, config)
+    # Original native detector measurements, including two returns on scan 3.
+    expected = np.array([[0., 2.7551670561165], [1., 4.38601447784208],
+        [2., 9.187780971370485], [3., 2.547561888889762], [3., 21.20457457617906],
+        [4., 5.453418661061338], [5., 13.201134379803364]])
+    if axis == 'rows':
+        expected = expected[:, ::-1]
+    np.testing.assert_allclose(stripe.uv, expected, atol=1e-12, rtol=0)
+    np.testing.assert_array_equal(stripe.strength, [52., 87., 130., 240., 128., 180., 190.])
+    np.testing.assert_array_equal(stripe.width, [3, 5, 4, 2, 4, 2, 3])
+    assert stripe.ambiguous_scans == 1
+    assert stripe.mask.sum() == 5865
+
+
+@pytest.mark.parametrize('axis', ['columns', 'rows'])
+def test_many_native_returns_keep_every_component_across_batch_boundaries(axis):
+    image = np.zeros((65, 300), np.uint8)
+    image[1::2] = 200
+    if axis == 'rows':
+        image = image.T.copy()
+    stripe = extract(image, Detection(axis=axis, threshold=30., min_width=1,
+                                     max_width=24, remove_background=False))
+    assert len(stripe.uv) == 9600 and stripe.ambiguous_scans == 300
+    along = np.repeat(np.arange(300), 32)
+    across = np.tile(np.arange(1, 65, 2), 300)
+    expected = np.column_stack((along, across) if axis == 'columns' else (across, along))
+    np.testing.assert_array_equal(stripe.uv, expected)
+    np.testing.assert_array_equal(stripe.width, np.ones(9600, int))
+    assert stripe.mask.sum() == 9600*255
+
+
+def test_peak_must_reach_full_precision_configured_threshold():
+    image = np.zeros((10, 10), np.uint8)
+    image[3:6] = 100
+    stripe = extract(image, Detection(threshold=np.nextafter(100., np.inf),
+                                     min_width=1, max_width=24, remove_background=False))
+    assert not len(stripe.uv)
diff --git a/app/tests/test_exposure_events.py b/app/tests/test_exposure_events.py
new file mode 100644
index 0000000..89cdbd7
--- /dev/null
+++ b/app/tests/test_exposure_events.py
@@ -0,0 +1,247 @@
+"""Mocked C SDK device events and strict per-image exposure pairing."""
+import ctypes as ct
+from types import SimpleNamespace
+
+import pytest
+
+from test_clock_mapping import raw, tracker_with_samples
+from weldfinder.spinnaker import SpinnakerCamera
+
+
+def camera_fixture():
+    calls=[]
+    values={'EventExposureEndFrameID':50,'EventExposureEndTimestamp':2_490_000_000}
+    camera=object.__new__(SpinnakerCamera)
+    camera._init_exposure_events()
+    camera.camera,camera.nodemap=ct.c_void_p(1),ct.c_void_p(2)
+    def call(name,*args):
+        calls.append(name)
+        if name=='spinDeviceEventHandlerCreate':
+            ct.cast(args[0],ct.POINTER(ct.c_void_p))[0]=ct.c_void_p(3)
+    camera.sdk=SimpleNamespace(call=call,get_integer=lambda _,name:values[name],
+        set_enum=lambda *args:None,get_enum=lambda *args:'On')
+    return camera,calls,values
+
+
+def configure(camera):
+    info={'nodes':{name:{'available':True,'readable':True} for name in
+            ('EventExposureEndTimestamp','EventExposureEndFrameID')},'errors':{}}
+    camera._configure_exposure_events(info)
