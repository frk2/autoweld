+"""Bounded camera-clock calibration from host-bracketed SDK latch commands.
+
+The mapping is a locally affine clock model, never a frame receipt-time offset.
+Its feasible interval includes every retained latch transaction and the camera's
+reported timestamp quantization. Inconsistent clocks, stale calibration and
+unbounded/loose extrapolations remain unavailable for motion pairing.
+"""
+
+import math
+import uuid
+from collections import deque
+
+
+def _clip(polygon, a, b, limit):
+    """Intersect a convex (rate, offset) polygon with a*x+b*y <= limit."""
+    if not polygon:
+        return []
+    result = []
+    previous = polygon[-1]
+    previous_value = a*previous[0]+b*previous[1]-limit
+    for current in polygon:
+        current_value = a*current[0]+b*current[1]-limit
+        if (current_value <= 0) != (previous_value <= 0):
+            fraction = previous_value/(previous_value-current_value)
+            result.append((previous[0]+fraction*(current[0]-previous[0]),
+                           previous[1]+fraction*(current[1]-previous[1])))
+        if current_value <= 0:
+            result.append(current)
+        previous, previous_value = current, current_value
+    return result
+
+
+class CameraClockMap:
+    def __init__(self, *, max_samples=32, min_samples=4, min_span_s=.2,
+                 max_extrapolation_s=.25, max_latch_age_s=.25, max_uncertainty_s=.002):
+        self.samples = deque(maxlen=max_samples)
+        self.min_samples, self.min_span_s = min_samples, min_span_s
+        self.max_extrapolation_s, self.max_latch_age_s = max_extrapolation_s, max_latch_age_s
+        self.max_uncertainty_s = max_uncertainty_s
+        self.mapping_id = uuid.uuid4().hex
+        self.revision = 0
+        self.polygon = []
+        self.camera_origin_ns = None
+        self.host_origin_s = None
+        self.error = None
+
+    def add(self, sample):
+        stamp = sample.get('camera_timestamp_ns')
+        before, after = sample.get('host_monotonic_before_s'), sample.get('host_monotonic_after_s')
+        quantum = sample.get('timestamp_increment_ns')
+        if (type(stamp) is not int or not 0 <= stamp < 2**64 or type(quantum) is not int or quantum <= 0
+                or type(before) not in (int, float) or type(after) not in (int, float)
+                or not math.isfinite(before) or not math.isfinite(after) or before > after):
+            self.error = 'Invalid host-bracketed camera latch sample'
+            self.polygon = []
+            return False
+        if self.samples and (stamp <= self.samples[-1]['camera_timestamp_ns']
+                             or before < self.samples[-1]['host_monotonic_before_s']):
+            self.error = 'Camera or host latch clock regressed'
+            self.polygon = []
+            self.samples.clear()
+            return False
+        self.revision += 1
+        self.samples.append(dict(camera_timestamp_ns=stamp, host_monotonic_before_s=float(before),
+                                 host_monotonic_after_s=float(after), timestamp_increment_ns=quantum))
+        self._fit()
+        return bool(self.polygon)
+
+    def _fit(self):
+        self.polygon, self.error = [], None
+        if len(self.samples) < self.min_samples:
+            return
+        first, last = self.samples[0], self.samples[-1]
+        span = (last['camera_timestamp_ns']-first['camera_timestamp_ns'])*1e-9
+        if span < self.min_span_s:
+            return
+        q0, q1 = first['timestamp_increment_ns']*1e-9, last['timestamp_increment_ns']*1e-9
+        camera_minimum, camera_maximum = span-q0-q1, span+q0+q1
+        if camera_minimum <= 0:
+            return
+        host_minimum = last['host_monotonic_before_s']-first['host_monotonic_after_s']
+        host_maximum = last['host_monotonic_after_s']-first['host_monotonic_before_s']
+        rate_low, rate_high = max(0., host_minimum/camera_maximum), host_maximum/camera_minimum
+        if not 0 < rate_low <= rate_high or not math.isfinite(rate_high):
+            self.error = 'Latch samples do not define a positive finite clock rate'
+            return
+        self.camera_origin_ns = first['camera_timestamp_ns']
+        self.host_origin_s = first['host_monotonic_before_s']
+        offset_low = -rate_high*q0
+        offset_high = first['host_monotonic_after_s']-self.host_origin_s+rate_high*q0
+        polygon = [(rate_low, offset_low), (rate_high, offset_low),
+                   (rate_high, offset_high), (rate_low, offset_high)]
+        for sample in self.samples:
+            x = (sample['camera_timestamp_ns']-self.camera_origin_ns)*1e-9
+            q = sample['timestamp_increment_ns']*1e-9
+            low = sample['host_monotonic_before_s']-self.host_origin_s
+            high = sample['host_monotonic_after_s']-self.host_origin_s
+            # The true latch counter can lie one reported quantum either side.
+            polygon = _clip(polygon, -(x+q), -1., -low)
+            polygon = _clip(polygon, x-q, 1., high)
+        self.polygon = polygon
+        if not polygon:
+            self.error = 'Latch intervals are inconsistent with the locally affine clock model'
+
+    def status(self):
+        if not self.samples:
+            return {'status': 'unavailable', 'mapping_id': None, 'uncertainty_s': None}
+        return {'status': 'calibrated' if self.polygon else 'inconsistent' if self.error else 'warming',
+                'mapping_id': self.mapping_id, 'revision': self.revision, 'uncertainty_s': None,
+                'sample_count': len(self.samples), 'model': 'locally_affine_latch_interval_envelope',
+                'source': 'TimestampLatch/TimestampLatchValue host-monotonic transaction brackets',
+                'error': self.error}
+
+    def map_timestamp(self, stamp_ns, *, now, quantum_ns):
+        result = self.status()
+        if not self.polygon:
+            return result
+        if (type(stamp_ns) is not int or type(quantum_ns) is not int or quantum_ns <= 0
+                or type(now) not in (int, float) or not math.isfinite(now)):
+            return {**result, 'status': 'unavailable', 'error': 'Invalid camera timestamp or evaluation clock'}
+        newest = self.samples[-1]
+        age = now-newest['host_monotonic_after_s']
+        if age < 0 or age > self.max_latch_age_s:
+            return {**result, 'status': 'stale', 'error': 'Camera clock latch calibration is stale or in the future'}
+        minimum, maximum = self.samples[0]['camera_timestamp_ns'], newest['camera_timestamp_ns']
+        extrapolation = max(minimum-stamp_ns, stamp_ns-maximum, 0)*1e-9
+        if extrapolation > self.max_extrapolation_s:
+            return {**result, 'status': 'unavailable', 'error': 'Camera timestamp exceeds bounded clock extrapolation'}
+        x, q = (stamp_ns-self.camera_origin_ns)*1e-9, quantum_ns*1e-9
+        low = min(rate*(x-q)+offset for rate, offset in self.polygon)+self.host_origin_s
+        high = max(rate*(x+q)+offset for rate, offset in self.polygon)+self.host_origin_s
+        uncertainty = (high-low)/2
+        if (not math.isfinite(low) or not math.isfinite(high) or low > high
+                or uncertainty > self.max_uncertainty_s):
+            return {**result, 'status': 'uncertain', 'uncertainty_s': uncertainty,
+                    'error': 'Camera clock mapping exceeds the timing uncertainty limit'}
+        return {**result, 'status': 'qualified', 'host_clock_domain': 'host_monotonic',
+                'host_bounds_s': [low, high], 'host_timestamp_s': (low+high)/2,
+                'uncertainty_s': uncertainty, 'latch_age_s': age, 'extrapolation_s': extrapolation,
+                'rate_bounds': [min(v[0] for v in self.polygon), max(v[0] for v in self.polygon)],
+                'camera_timestamp_increment_ns': quantum_ns,
+                'calibration_camera_ns_bounds': [minimum, maximum],
+                'calibration_host_s_bounds': [self.samples[0]['host_monotonic_before_s'],
+                                              newest['host_monotonic_after_s']]}
