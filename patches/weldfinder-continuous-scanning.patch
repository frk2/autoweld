+                         & (np.abs(uv[shift:, perpendicular]-uv[:-shift, perpendicular]) <= noise.max_jump_px))
+            neighbors[:-shift] += connected
+            neighbors[shift:] += connected
+        return neighbors >= noise.min_neighbors
+    # Preserve behavior for non-native callers with repeated/fractional scans.
     for i in range(count):
         stop = np.searchsorted(scan, scan[i] + noise.max_scan_gap_px, side='right')
         connected = np.flatnonzero(np.abs(uv[i+1:stop, perpendicular] - uv[i, perpendicular])
