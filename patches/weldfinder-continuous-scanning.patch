@@ -0,0 +1,108 @@
+"""Analysis intent uses one fake acquisition owner and unchanged native gates."""
+
+import copy
+
+import pytest
+from test_calibration_camera_adapter import FakeCamera, measured_board, wait_for
+from weldfinder.calibration_camera import CalibrationCamera
+
+__all__ = ['measured_board']
+
+
+@pytest.mark.parametrize('mode', [None, True, 1, '', 'preview', ['laser']])
+def test_invalid_analysis_mode_never_opens_or_starts_camera(tmp_path, mode):
+    owner = CalibrationCamera(tmp_path, factory=FakeCamera)
+    try:
+        with pytest.raises(ValueError, match='checkerboard or laser'):
+            owner.set_analysis_mode(mode)
+        assert owner.analysis_mode == 'checkerboard'
+        assert owner.pipeline.thread is None and owner.pipeline.camera is None
+    finally:
+        owner.close()
+
+
+def test_laser_intent_before_stream_suppresses_board_work_and_survives_reopen(tmp_path, monkeypatch):
+    calls = []
+    monkeypatch.setattr('weldfinder.pipeline.board_observation', lambda *a, **k: calls.append(True))
+    owner = CalibrationCamera(tmp_path, factory=FakeCamera)
+    try:
+        state = owner.set_analysis_mode('laser')
+        assert state['analysis_mode'] == 'laser' and not state['board_detection_enabled']
+        assert owner.pipeline.thread is None and owner.pipeline.camera is None
+        for _ in range(2):
+            owner.stream(True)
+            wait_for(lambda: owner.state(include_frame=False)['fresh'])
+            state = owner.state(include_frame=False)
+            assert state['analysis_mode'] == 'laser' and not state['board_detection_enabled']
+            assert not state['board']['found'] and state['board']['corners'] == []
+            assert not owner.pipeline.observation['board_detection_ran']
+            owner.stream(False)
+        assert not calls
+    finally:
+        owner.close()
+
+
+@pytest.mark.parametrize('mode', ['checkerboard', 'laser'])
+def test_startup_applies_intent_after_finder_restore_selects_discovery(tmp_path, measured_board, monkeypatch, mode):
+    owner = CalibrationCamera(tmp_path, factory=FakeCamera)
+    owner._finder_controls_configured = True
+    restored = []
+    def restore(request):
+        restored.append(request)
+        owner.pipeline.submit('pointcloud_configure', enabled=True).result(timeout=3)
+    monkeypatch.setattr(owner, '_laser_configure_finder', restore)
+    try:
+        owner.set_analysis_mode(mode)
+        owner.stream(True)
+        assert restored
+        assert owner.pipeline.board_detection_enabled == (mode == 'checkerboard')
+        assert owner.pipeline.calibration_mode == (mode == 'checkerboard')
+    finally:
+        owner.close()
+
+
+def test_switching_modes_keeps_one_owner_and_settings_and_duplicate_mode_is_noop(tmp_path, measured_board):
+    owner = CalibrationCamera(tmp_path, factory=FakeCamera)
+    opened_before = FakeCamera.opened
+    try:
+        owner.stream(True)
+        wait_for(lambda: owner.state(include_frame=False)['board']['found'])
+        initial = owner.pipeline.snapshot(include_calibration=False)
+        controls = dict(initial['controls'])
+        detection = copy.deepcopy(initial['pointcloud_status']['detection'])
+        generation = initial['generation']
+        owner.set_analysis_mode('laser')
+        assert owner.pipeline.generation == generation+1
+        assert owner.pipeline.observation is None or owner.pipeline.observation['generation'] == generation+1
+        wait_for(lambda: owner.state(include_frame=False)['fresh'])
+        state = owner.state(include_frame=False)
+        assert not state['board_detection_enabled'] and state['board']['corners'] == []
+        generation = state['generation']
+        for _ in range(3):
+            owner.set_analysis_mode('laser')
+        assert owner.pipeline.generation == generation
+        assert owner.pipeline.snapshot(include_calibration=False)['controls'] == controls
+        assert owner.pipeline.snapshot(include_calibration=False)['pointcloud_status']['detection'] == detection
+        owner.set_analysis_mode('checkerboard')
+        wait_for(lambda: owner.state(include_frame=False)['board']['found'])
+        assert owner.pipeline.generation == generation+1
+        generation = owner.pipeline.generation
+        owner.set_analysis_mode('checkerboard')
+        assert owner.pipeline.generation == generation
+        assert FakeCamera.opened == opened_before+1
+    finally:
+        owner.close()
+
+
+def test_failed_mode_change_preserves_preference(tmp_path, measured_board, monkeypatch):
+    owner = CalibrationCamera(tmp_path, factory=FakeCamera)
+    try:
+        owner.stream(True)
+        def reject(*args, **kwargs):
+            raise RuntimeError('Synthetic analysis switch rejected')
+        monkeypatch.setattr(owner.pipeline, 'submit', reject)
+        with pytest.raises(RuntimeError, match='switch rejected'):
+            owner.set_analysis_mode('laser')
+        assert owner.analysis_mode == 'checkerboard'
+    finally:
+        owner.close()
diff --git a/app/tests/test_clock_mapping.py b/app/tests/test_clock_mapping.py
new file mode 100644
index 0000000..89edcd4
--- /dev/null
+++ b/app/tests/test_clock_mapping.py
@@ -0,0 +1,185 @@
+"""Offline bounded latch/exposure timing; never opens a camera."""
+import ctypes as ct
+from types import SimpleNamespace
+
+import pytest
+
+from weldfinder.clock_mapping import CameraClockMap
+from weldfinder.frame_timing import FrameTiming
+from weldfinder.spinnaker import SDK, SpinnakerCamera
+
+
+def sample(index, *, rate=1.00004, bias=100., width=.0002):
+    stamp = int((1.+index*.1)*1e9)
+    host = bias+stamp*1e-9*rate
+    return dict(camera_timestamp_ns=stamp, host_monotonic_before_s=host-width*.3,
+                host_monotonic_after_s=host+width*.7, timestamp_increment_ns=480)
+
+
+def tracker_with_samples():
+    tracker = FrameTiming()
+    for i in range(16):
+        tracker.clock_map.add(sample(i))
+    return tracker
+
+
+def raw(**changes):
+    return dict(camera_frame_id=50, camera_timestamp_ns=2_490_000_000,
+                camera_exposure_us=500., camera_timestamp_increment_ns=480,
+                chunk_frame_id=50, chunk_timestamp_ns=2_490_000_000,
+                sensor_shutter_mode='Global', timestamp_semantics_verified=True,
+                camera_timestamp_semantics='exposure_end',
+                timestamp_semantics_provenance={'kind':'camera_node'}, **changes)
+
+
+def test_true_affine_clock_inside_variable_latch_envelope_and_stable_session_id():
+    clock = CameraClockMap()
+    for i in range(30):
+        clock.add(sample(i, width=.0001+(i%4)*.0001))
+    result = clock.map_timestamp(3_850_000_000, now=104., quantum_ns=480)
+    assert result['status'] == 'qualified'
+    truth = 100.+3.85*1.00004
+    assert result['host_bounds_s'][0] <= truth <= result['host_bounds_s'][1]
+    assert result['uncertainty_s'] < .001
+    mapping_id, revision = result['mapping_id'], result['revision']
+    clock.add(sample(30))
+    newer = clock.map_timestamp(4_000_000_000, now=104.1, quantum_ns=480)
+    assert newer['mapping_id'] == mapping_id and newer['revision'] > revision
+    assert CameraClockMap().mapping_id != mapping_id
+
+
+def test_warmup_stale_and_extrapolation_fail_closed():
+    clock = CameraClockMap()
+    clock.add(sample(0))
+    assert clock.map_timestamp(1_000_000_000, now=101.01, quantum_ns=480)['status'] == 'warming'
+    for i in range(1,6):
+        clock.add(sample(i))
+    assert clock.map_timestamp(1_500_000_000, now=102., quantum_ns=480)['status'] == 'stale'
+    assert clock.map_timestamp(2_000_000_000, now=101.51, quantum_ns=480)['status'] == 'unavailable'
+
+
+def test_inconsistent_clock_and_regression_do_not_qualify():
+    clock = CameraClockMap()
+    for i in range(4):
+        clock.add(sample(i))
+    bad = sample(4)
+    bad['host_monotonic_before_s'] += .02
+    bad['host_monotonic_after_s'] += .02
+    clock.add(bad)
+    assert clock.status()['status'] == 'inconsistent'
+    assert clock.map_timestamp(1_400_000_000, now=101.5, quantum_ns=480)['status'] != 'qualified'
+    clock.add(sample(0))
+    assert not clock.samples and not clock.polygon
+
+
+def test_actual_frame_exposure_and_midpoint_with_bounded_uncertainty():
+    tracker = tracker_with_samples()
+    timing = tracker.observe(raw(), 102.49, 102.51, {'exposure_us': 9000.})
+    assert timing['motion_pairing_supported']
+    assert timing['sensor_shutter_mode'] == 'global'
+    assert timing['exposure_duration_provenance'] == 'image_chunk'
+    assert timing['exposure_duration_us'] == 500.
+    assert timing['exposure_host_end_s']-timing['exposure_host_start_s'] == pytest.approx(.0005)
+    assert timing['exposure_host_mid_s'] == timing['exposure_host_midpoint_s']
+    truth_mid = 100.+2.49*1.00004-.00025
+    assert abs(timing['exposure_host_mid_s']-truth_mid) <= timing['exposure_time_uncertainty_s']
+
+
+@pytest.mark.parametrize('field,value', [('sensor_shutter_mode','Rolling'),
+    ('timestamp_semantics_verified',False),('camera_timestamp_semantics','image_timestamp_event_unknown'),
+    ('camera_exposure_us',None)])
+def test_unknown_or_rolling_or_not_per_image_timing_never_pairs(field,value):
+    data=raw()
+    data[field]=value
+    timing=tracker_with_samples().observe(data,102.49,102.51,{'exposure_us':500.})
+    assert not timing['motion_pairing_supported']
+    assert timing['exposure_host_mid_s'] is None
+
+
+def test_start_event_and_frame_timestamp_do_not_change_with_processing_delay():
+    data=raw()
+    data['camera_timestamp_semantics']='exposure_start'
+    timing=tracker_with_samples().observe(data,102.49,102.51,{})
+    assert timing['motion_pairing_supported']
+    assert timing['exposure_host_start_s'] == timing['clock_mapping']['host_timestamp_s']
+    packet={'timing':timing,'processed_monotonic':150.}
+    assert packet['timing']['exposure_host_mid_s'] < 103.
+
+
+def test_sdk_chunk_values_are_read_from_owned_image():
+    sdk=object.__new__(SDK)
+    def call(name,*args):
+        values={'spinImageGetFrameID':5,'spinImageGetTimeStamp':1000}
+        if name in values:
+            ct.cast(args[-1],ct.POINTER(ct.c_uint64))[0]=values[name]
+        elif name=='spinImageChunkDataGetIntValue':
+            ct.cast(args[-1],ct.POINTER(ct.c_int64))[0] = 1000 if args[1]==b'ChunkTimestamp' else 5
+        else:
+            ct.cast(args[-1],ct.POINTER(ct.c_double))[0]=700.
+    sdk.call=call
+    result=sdk.image_metadata(None,include_chunks=True)
+    assert result['camera_exposure_us']==700.
+    assert result['chunk_timestamp_ns']==result['camera_timestamp_ns']
+    assert result['chunk_frame_id']==result['camera_frame_id']
+
+
+def test_owner_discovers_optional_nodes_and_enables_image_chunks():
+    calls=[]
+    sdk=SimpleNamespace(string=lambda *args:'firmware',
+        node_access=lambda *args:dict(available=True,readable=True,writable=True),
+        get_integer=lambda *args:480,
+        get_enum=lambda _,name: 'Global' if name=='SensorShutterMode' else 'EndOfExposure',
+        set_boolean=lambda *args:calls.append(args),set_enum=lambda *args:calls.append(args))
+    camera=object.__new__(SpinnakerCamera)
+    camera.sdk,camera.nodemap,camera.name,camera.source_id=sdk,None,'fixture','fixture:1'
+    camera.timing_info=camera._configure_timing()
+    info=camera.timing_capabilities()
+    assert info['timestamp_latch_available'] and info['timestamp_semantics_verified']
+    assert info['chunks_enabled']==['Timestamp','FrameID','ExposureTime']
+    assert calls[0]==(None,'ChunkModeActive',True)
+    info['chunks_enabled'].clear()
+    assert len(camera.timing_capabilities()['chunks_enabled'])==3
+
+
+def test_missing_optional_sdk_nodes_preserves_ordinary_acquisition_capability():
+    camera=object.__new__(SpinnakerCamera)
+    camera.sdk,camera.nodemap,camera.name,camera.source_id=SimpleNamespace(),None,'fixture','fixture:1'
+    info=camera._configure_timing()
+    assert not info['timestamp_semantics_verified'] and not info['timestamp_latch_available']
+    assert info['chunks_enabled']==[] and info['errors']
+
+
+def test_public_timing_query_uses_existing_owner_queue_only():
+    from weldfinder.calibration_camera import CalibrationCamera
+    queued=[]
+    class Future:
+        def result(self,timeout):
+            assert timeout==5
+            return {'capabilities':{'model':'fixture'}}
+    camera=object.__new__(CalibrationCamera)
+    camera.pipeline=SimpleNamespace(submit=lambda action: queued.append(action) or Future())
+    assert camera.timing_capabilities()=={'capabilities':{'model':'fixture'}}
+    assert queued==['timing_capabilities']
+
+
+def test_pipeline_timing_action_returns_owner_cached_capabilities():
+    from weldfinder.pipeline import CameraPipeline
+    pipeline=object.__new__(CameraPipeline)
+    pipeline.camera=SimpleNamespace(source_id='fixture',timing_capabilities=lambda:{'model':'fixture'})
+    pipeline.generation=5
+    pipeline.frame_timing=FrameTiming()
+    from weldfinder.cloud_history import NativeCloudHistory
+    pipeline.cloud_history=NativeCloudHistory()
+    result=pipeline._action('timing_capabilities',{})
+    assert result['capabilities']=={'model':'fixture'}
+    assert result['acquisition_session_id']==pipeline.frame_timing.session_id
+    with pytest.raises(ValueError,match='no arguments'):
+        pipeline._action('timing_capabilities',{'ignored':True})
+
+
+def test_loose_host_brackets_remain_unqualified():
+    clock=CameraClockMap()
+    for index in range(8):
+        clock.add(sample(index,width=.02))
+    result=clock.map_timestamp(1_690_000_000,now=101.72,quantum_ns=480)
+    assert result['status']=='uncertain' and result['uncertainty_s']>.002
