+def test_indexed_map_failure_falls_back_to_categories_and_releases_handles():
+    from weldfinder.spinnaker import SDK
+    sdk=object.__new__(SDK)
+    names={1:'Root',2:'EventControl',3:'ChunkDataControl',4:'EventExposureEndFrameID',
+           5:'EventExposureEndTimestamp',6:'ChunkFrameID'}
+    children={1:[2,3],2:[4,5],3:[6]}
+    released=[]
+    def integer(pointer,value,kind=ct.c_size_t):
+        ct.cast(pointer,ct.POINTER(kind))[0]=value
+    def call(name,*args):
+        node=args[0].value if isinstance(args[0],ct.c_void_p) else args[0]
+        if name=='spinNodeMapGetNumNodes':
+            integer(args[1],6)
+        elif name=='spinNodeMapGetNodeByIndex':
+            raise RuntimeError('indexed-map SDK failure')
+        elif name=='spinNodeMapGetNode':
+            integer(args[2],next(key for key,value in names.items() if value.encode()==args[1]),ct.c_void_p)
+        elif name=='spinNodeGetName':
+            args[1].value=names[node].encode()
+        elif name=='spinNodeGetType':
+            integer(args[1],10 if node in children else 2,ct.c_int)
+        elif name=='spinCategoryGetNumFeatures':
+            integer(args[1],len(children[node]))
+        elif name=='spinCategoryGetFeatureByIndex':
+            integer(args[2],children[node][args[1]],ct.c_void_p)
+        elif name.startswith('spinNodeIs'):
+            integer(args[1],name!='spinNodeIsWritable',ct.c_ubyte)
+        elif name=='spinNodeToString':
+            args[1].value=b'7318695'
+        elif name in ('spinCategoryReleaseNode','spinNodeMapReleaseNode'):
+            released.append(args[1].value)
+        else:
+            raise AssertionError(name)
+    sdk.call=call
+    result=sdk.timing_nodes(ct.c_void_p(100))
+    assert result['EventExposureEndFrameID']['value']=='7318695'
+    assert result['ChunkFrameID']['available']
+    diagnostics=result['__enumeration_diagnostics__']
+    assert diagnostics['reported_node_count']==6
+    assert diagnostics['errors'][0]['index']==0
+    assert 'category_fallback' in diagnostics['method']
+    assert all(node in released for node in range(1,7))
