+"""Publication history tests are synthetic and never open SDK devices."""
+import copy
+
+import numpy as np
+import pytest
+
+from weldfinder.cloud_history import NativeCloudHistory
+from weldfinder.pointcloud import PointCloud
+
+
+def cloud(frame, count=2, *, session='session',generation=1):
+    return PointCloud(np.zeros((count,3)),np.zeros((count,2)),np.ones(count),np.ones(count),
+        metadata=dict(read_started=10.+frame*.01,source_id='camera',calibration_id='laser',
+            generation=generation,sequence=frame,acquisition_session_id=session,
+            frame_product={'kind':'single_frame'},timing={'device_frame_id':frame}))
+
+
+def test_every_publication_retained_between_slower_reader_ticks():
+    history=NativeCloudHistory()
+    for frame in range(60):
+        history.publish(cloud(frame),'optics')
+    result=history.snapshot(('session',49),now=11.)
+    assert [x['sequence'] for x in result['clouds']]==list(range(50,60))
+    assert not result['overrun'] and result['newest_key']==('session',59)
+    assert result['stored_frames']==60
+    assert history.snapshot(('session',59),now=11.)['clouds']==()
+
+
+def test_cloud_is_immutable_cached_native_data_but_deepcopy_is_independent_mutable():
+    history=NativeCloudHistory()
+    original=cloud(1)
+    history.publish(original,'optics')
+    saved=history.snapshot(now=10.5)['clouds'][0]
+    assert isinstance(saved,dict) and saved is history.snapshot(now=10.5)['clouds'][0]
+    with pytest.raises(TypeError):
+        saved['timing']['device_frame_id']=7
+    with pytest.raises(ValueError):
+        saved['xyz_mm'][0,0]=7
+    original.xyz_mm[0,0]=12
+    assert saved['xyz_mm'][0,0]==0
+    copied=copy.deepcopy(saved)
+    copied['timing']['device_frame_id']=8
+    copied['xyz_mm'][0,0]=8
+    assert saved['timing']['device_frame_id']==1 and saved['xyz_mm'][0,0]==0
+    assert 'frame' not in saved and 'preview' not in saved
+
+
+def test_count_point_and_byte_evictions_report_actual_cursor_overrun():
+    history=NativeCloudHistory(capacity=3,max_points=6)
+    for frame in range(5):
+        history.publish(cloud(frame),'optics')
+    result=history.snapshot(('session',0),now=10.5)
+    assert result['overrun'] and result['stored_frames']==3 and result['stored_points']==6
+    assert not history.snapshot(('session',1),now=10.5)['overrun']  # Last eviction already consumed.
+    large=NativeCloudHistory(max_points=100)
+    for frame in range(10):
+        large.publish(cloud(frame,count=30),'optics')
+    assert large.snapshot(now=10.5)['stored_frames']==3
+    size=history.snapshot(now=10.5)['payload_bytes']//3
+    byte_limited=NativeCloudHistory(max_bytes=size+100)
+    for frame in range(3):
+        byte_limited.publish(cloud(frame),'optics')
+    state=byte_limited.snapshot(('session',0),now=10.5)
+    assert state['payload_bytes']<=size+100 and state['stored_frames']==1 and state['overrun']
+
+
+def test_invalidation_new_session_and_stale_frames_are_explicit():
+    history=NativeCloudHistory()
+    history.publish(cloud(1),'optics')
+    history.clear('Disconnected')
+    assert not history.snapshot(now=10.5)['clouds']
+    history.publish(cloud(2,session='new'),'optics')
+    result=history.snapshot(('session',1),now=10.5)
+    assert result['overrun'] and result['session_changed']
+    assert history.snapshot(now=20.)['stale'] and not history.snapshot(now=20.)['clouds']
+
+
+def test_duplicate_regression_and_invalid_channels_do_not_expand_ring():
+    history=NativeCloudHistory()
+    assert history.publish(cloud(3),'optics')
+    assert not history.publish(cloud(3),'optics')
+    with pytest.raises(ValueError,match='regressed'):
+        history.publish(cloud(2),'optics')
+    bad=cloud(4)
+    bad.xyz_mm[0,0]=np.nan
+    with pytest.raises(ValueError,match='finite'):
+        history.publish(bad,'optics')
+
+
+def test_pipeline_publishes_each_native_cloud_before_any_ui_reader(tmp_path):
+    import hashlib
+    import time
+    from test_pipeline_performance import calibration,wait_for
+    from weldfinder.camera_settings import CameraSettings
+    from weldfinder.pipeline import CameraPipeline
+    class Camera:
+        source_id='fixture:performance'
+        def __init__(self,serial):
+            self.controls={'exposure_us':500.,'gain_db':0.}
+            self.counter=0
+        def read_with_metadata(self):
+            time.sleep(.02)
+            self.counter+=1
+            image=np.full((240,320),10,np.uint8)
+            image[118:123,10:310]=160
+            return image,dict(camera_frame_id=self.counter,chunk_frame_id=1000+self.counter,
+                              camera_timestamp_ns=time.monotonic_ns())
+        def close(self):
+            pass
+    key=hashlib.sha256(Camera.source_id.encode()).hexdigest()[:16]
+    calibration().save(tmp_path/'runtime/flir/data'/f'calibration-{key}.json')
+    pipeline=CameraPipeline(tmp_path,factory=Camera)
+    try:
+        pipeline.submit('connect',settings=CameraSettings()).result(timeout=3)
+        wait_for(lambda:pipeline.cloud_history.status()['stored_frames']>=8)
+        result=pipeline.recent_laser_clouds()
+        ids=[item['timing']['device_frame_id'] for item in result['clouds']]
+        assert len(ids)>=8 and all(a<b for a,b in zip(ids,ids[1:]))
+        assert all(item['optical_intrinsics_id'] for item in result['clouds'])
+        assert pipeline.snapshot()['native_ring']['published_total']>=8
+        cutoff=result['newest_key']
+        wait_for(lambda:pipeline.cloud_history.status()['newest_device_id']>cutoff[1])
+        assert all(item['timing']['device_frame_id']>cutoff[1] for item in pipeline.recent_laser_clouds(cutoff)['clouds'])
+        pipeline.submit('disconnect').result(timeout=3)
+        assert not pipeline.recent_laser_clouds()['clouds']
+    finally:
+        pipeline.close()
