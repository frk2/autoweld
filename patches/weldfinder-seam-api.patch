+import copy
+import json
+
+import numpy as np
+import pytest
+from scipy.spatial.transform import Rotation
+
+from weldfinder.seam import SeamSettings, find_weld_seam
+
+
+def cloud(kind='valley', nonuniform=False, noise=0.):
+    x = np.linspace(-20, 20, 1001)
+    if nonuniform:
+        x = 20*np.sign(x)*np.abs(x/20)**1.5
+    baseline = .003*x*x + .04*x
+    if kind == 'valley':
+        baseline += 1.5*np.maximum(1-np.abs(x-1)/2., 0)
+    elif kind == 'step':
+        baseline += .8*(x > 1)
+    elif kind == 'double':
+        baseline += 1.5*np.maximum(1-np.abs(x-7)/2., 0)
+        baseline += 1.5*np.maximum(1-np.abs(x+7)/2., 0)
+    elif kind == 'curve':
+        baseline = 12.7-np.sqrt(12.7**2-(x/2)**2)
+    baseline += np.random.default_rng(1).normal(0, noise, len(x))
+    xyz = np.column_stack([x, np.zeros(len(x)), 150+baseline])
+    return {'xyz_mm': xyz.tolist(), 'uv': np.column_stack([np.arange(len(x)), baseline*5+300]).tolist(),
+                'source_id': 'fixture', 'sequence': 7, 'generation': 4, 'acquisition_session_id': 'one',
+                'calibration_id': 'exact', 'read_started': 42., 'received': 42.01, 'timing': {'midpoint': 42.005},
+                'units': 'mm', 'coordinate_frame': 'camera'}
+
+
+def test_valley_centroid_pose_and_native_provenance():
+    native = cloud(noise=.015)
+    before = copy.deepcopy(native)
+    result = find_weld_seam(native)
+    assert result['status'] == 'found', result
+    assert result['quality']['feature_kind'] == 'valley'
+    assert abs(result['seam_point_mm'][0]-1) < .12
+    pose = np.array(result['camera_from_torch'])
+    seam = np.array(result['seam_point_mm'])
+    np.testing.assert_allclose(pose[:3, :3].T@pose[:3, :3], np.eye(3), atol=1e-10)
+    assert np.linalg.det(pose[:3, :3]) == pytest.approx(1.)
+    np.testing.assert_allclose(seam-pose[:3, 3], pose[:3, 2]*150, atol=1e-10)
+    assert len(result['flank_lines_mm']) == 2
+    assert result['provenance']['timing'] == native['timing']
+    assert native == before
+    json.dumps(result, allow_nan=False)
+
+
+@pytest.mark.parametrize('kind', ['flat', 'curve'])
+def test_plain_smooth_surfaces_are_not_seams(kind):
+    result = find_weld_seam(cloud(kind))
+    assert result['status'] == 'no_seam', result
+    assert result['quality']['good']
+    assert result['camera_from_torch'] is None
+
+
+def test_step_is_supported_by_contiguous_native_pixels():
+    result = find_weld_seam(cloud('step'))
+    assert result['status'] == 'found', result
+    assert result['quality']['feature_kind'] == 'step'
+    assert result['seam_point_mm'][0] == pytest.approx(1, abs=.1)
+    assert result['seam_point_mm'][2] == pytest.approx(150.443, abs=.06)
+
+
+def test_missing_native_pixels_cannot_be_seam_or_end():
+    native = cloud('step')
+    for field in ('xyz_mm', 'uv'):
+        del native[field][495:505]
+    result = find_weld_seam(native)
+    assert result['status'] == 'invalid'
+    assert 'gap' in result['quality']['reason']
+
+
+def test_multiple_features_need_measured_association():
+    native = cloud('double')
+    result = find_weld_seam(native)
+    assert result['status'] == 'ambiguous', result
+    assert not result['found']
+    selected = find_weld_seam(native, previous_point_mm=[7, 0, 151])
+    assert selected['status'] == 'found', selected
+    assert selected['seam_point_mm'][0] == pytest.approx(7, abs=.15)
+    lost = find_weld_seam(native, previous_point_mm=[0, 0, 150])
+    assert lost['status'] == 'ambiguous'
+
+
+def test_nonuniform_sampling_does_not_pull_centroid():
+    a = find_weld_seam(cloud())
+    b = find_weld_seam(cloud(nonuniform=True))
+    assert a['found'] and b['found'], (a, b)
+    np.testing.assert_allclose(a['seam_point_mm'], b['seam_point_mm'], atol=.03)
+
+
+def test_rotated_profile_yields_rotated_pose():
+    native = cloud()
+    a = find_weld_seam(native)
+    r = Rotation.from_rotvec([.05, -.1, .3]).as_matrix()
+    native['xyz_mm'] = (np.array(native['xyz_mm'])@r.T).tolist()
+    b = find_weld_seam(native)
+    assert a['found'] and b['found'], (a, b)
+    np.testing.assert_allclose(b['seam_point_mm'], r@a['seam_point_mm'], atol=1e-8)
+    np.testing.assert_allclose(np.array(b['camera_from_torch'])[:3, :3],
+                               r@np.array(a['camera_from_torch'])[:3, :3], atol=1e-8)
+
+
+@pytest.mark.parametrize('field,value', [('units', 'm'), ('coordinate_frame', 'world'),
+                                       ('xyz_mm', [[1, 2, float('nan')]]), ('uv', [])])
+def test_bad_geometry_invalid(field, value):
+    native = cloud()
+    native[field] = value
+    assert find_weld_seam(native)['status'] == 'invalid'
+
+
+def test_settings_validation_and_explicit_zero_clearance():
+    with pytest.raises(ValueError):
+        find_weld_seam(cloud(), settings={'torch_standoff_mm': float('nan')})
+    result = find_weld_seam(cloud(), settings=SeamSettings(torch_standoff_mm=0.))
+    np.testing.assert_allclose(np.array(result['camera_from_torch'])[:3, 3], result['seam_point_mm'])
+
+
+def test_broad_inside_corner_and_bounded_missing_root_are_supported():
+    native = cloud('flat')
+    p = np.array(native['xyz_mm'])
+    p[:, 2] = 150-.6*np.abs(p[:, 0]-1)
+    native['xyz_mm'] = p.tolist()
+    # Root is obscured but both long planar flanks remain observed.
+    hidden = np.abs(p[:, 0]-1) < .25
+    for field in ('xyz_mm', 'uv'):
+        native[field] = np.asarray(native[field])[~hidden].tolist()
+    result = find_weld_seam(native)
+    assert result['status'] == 'found', result
+    assert result['quality']['feature_kind'] == 'inside_corner'
+    assert result['quality']['centroid_method'] == 'supported_flank_intersection'
+    assert result['quality']['inferred_root']
+    np.testing.assert_allclose(result['seam_point_mm'], [1, 0, 150], atol=.01)
+    assert result['quality']['corner_angle_deg'] == pytest.approx(61.9275, abs=.01)
+
+
+def test_large_unobserved_root_is_not_fabricated():
+    native = cloud('flat')
+    p = np.array(native['xyz_mm'])
+    p[:, 2] = 150-.6*np.abs(p[:, 0]-1)
+    native['xyz_mm'] = p.tolist()
+    hidden = np.abs(p[:, 0]-1) < 3
+    for field in ('xyz_mm', 'uv'):
+        native[field] = np.asarray(native[field])[~hidden].tolist()
+    assert find_weld_seam(native)['status'] == 'invalid'
+
+
+def test_gap_on_flat_surface_cannot_indicate_disappearance():
+    native = cloud('flat')
+    for field in ('xyz_mm', 'uv'):
+        del native[field][400:410]
+    assert find_weld_seam(native)['status'] == 'invalid'
+
+
+def test_rough_native_profile_is_not_disappearance():
+    result = find_weld_seam(cloud('flat', noise=.4))
+    assert result['status'] == 'invalid'
+    assert 'rough' in result['quality']['reason']
+
+
+def test_pointcloud_object_and_public_exports():
+    from weldfinder import SeamSettings as PublicSettings
+    from weldfinder import find_weld_seam as public_find
+    from weldfinder.pointcloud import PointCloud
+    data = cloud()
+    native = PointCloud(np.array(data['xyz_mm']), np.array(data['uv']), np.ones(1001),
+                        np.ones(1001), {'source_id': 'fixture', 'sequence': 7})
+    result = public_find(native, settings=PublicSettings())
+    assert result['found']
+    assert result['provenance']['sequence'] == 7
+
+
+def test_obtuse_profile_corner_preserves_native_flank_branch_identity():
+    native = cloud('flat')
+    p = np.array(native['xyz_mm'])
+    # A >90 degree tangent change puts opposite-plate points into the same
+    # tangent-projection interval. They must not contaminate the flank fit.
+    p[:, 2] = 150-1.2*np.abs(p[:, 0]-1)
+    native['xyz_mm'] = p.tolist()
+    result = find_weld_seam(native)
+    assert result['status'] == 'found', result
+    np.testing.assert_allclose(result['seam_point_mm'], [1, 0, 150], atol=.01)
+    assert result['quality']['corner_angle_deg'] == pytest.approx(100.3889, abs=.01)
+    assert max(result['quality']['flank_rms_mm']) < .001
+
+
+def test_recorded_step_and_corner_algorithms_share_one_physical_root():
+    from pathlib import Path
+
+    fixture = json.loads(Path(__file__).with_name('seam_duplicate_flanks.json').read_text())
+    for record in fixture['records']:
+        result = find_weld_seam(record['cloud'], previous_point_mm=record['prior_camera_mm'])
+        assert result['status'] == 'found', (record['observation'], result)
+        assert result['quality']['feature_kind'] == 'inside_corner'
+        assert result['quality']['raw_candidate_count'] == 2
+        assert result['quality']['candidate_count'] == 1
+        duplicates = result['quality']['duplicate_candidates']
+        assert len(duplicates) == 1
+        assert duplicates[0]['reason'] == 'same_two_geometric_flanks'
+        assert max(result['quality']['flank_rms_mm']) <= SeamSettings().max_flank_rms_mm
+        # A prior is not required to establish that these are duplicate fits.
+        assert find_weld_seam(record['cloud'])['status'] == 'found'
+
+
+def test_two_real_features_within_prior_radius_still_ambiguous():
+    native = cloud('flat')
+    p = np.array(native['xyz_mm'])
+    x = p[:, 0]
+    p[:, 2] += 1.5*np.maximum(1-np.abs(x-3)/.8, 0)
+    p[:, 2] += 1.5*np.maximum(1-np.abs(x+3)/.8, 0)
+    native['xyz_mm'] = p.tolist()
+    result = find_weld_seam(native, previous_point_mm=[0, 0, 151])
+    assert result['status'] == 'ambiguous', result
+    assert result['quality']['associated_candidates'] == 2
+    assert result['quality']['duplicate_candidates'] == []
+
+
+def test_geometric_dedup_requires_both_flanks_not_just_nearby_points():
+    from weldfinder.seam import _duplicate_step_corner
+
+    corner = {'point': np.array([0., 0., 150.]),
+              'lines': np.array([[[-3., 0., 147.], [-1., 0., 149.]],
+                                 [[1., 0., 149.], [3., 0., 147.]]]),
+              'flank_rms_mm': [.01, .01]}
+    step = copy.deepcopy(corner)
+    step['point'] += [.5, 0, .5]
+    assert _duplicate_step_corner(step, corner) is not None
+    step['lines'][1] += [0, 0, .5]
+    assert _duplicate_step_corner(step, corner) is None
