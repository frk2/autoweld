diff --git a/app/weldfinder/seam.py b/app/weldfinder/seam.py
new file mode 100644
--- /dev/null
+++ b/app/weldfinder/seam.py
@@ -0,0 +1,416 @@
+"""Geometric weld features on one native, calibrated laser profile.
+
+No robot, acquisition, registration or world-coordinate dependency. Interpolation
+is used only to locate a feature; reported geometry is fitted to original XYZ.
+"""
+
+from copy import deepcopy
+from dataclasses import asdict, dataclass
+
+import numpy as np
+from scipy.ndimage import gaussian_filter1d
+from scipy.signal import find_peaks, peak_widths
+
+
+@dataclass(frozen=True)
+class SeamSettings:
+    min_prominence_mm: float = .3
+    max_feature_width_mm: float = 8.
+    min_flank_span_mm: float = 1.5
+    max_flank_rms_mm: float = .15
+    max_scan_gap_px: float = 3.
+    association_radius_mm: float = 4.
+    torch_standoff_mm: float = 150.
+    min_points: int = 48
+
+    def validate(self):
+        limits = {'min_prominence_mm': (.05, 10.), 'max_feature_width_mm': (.3, 30.),
+                  'min_flank_span_mm': (.5, 10.), 'max_flank_rms_mm': (.01, 1.),
+                  'max_scan_gap_px': (1., 10.), 'association_radius_mm': (.1, 20.),
+                  'torch_standoff_mm': (0., 300.)}
+        for key, (low, high) in limits.items():
+            value = getattr(self, key)
+            if isinstance(value, bool) or not np.isscalar(value) or not np.isfinite(value) or not low <= value <= high:
+                raise ValueError(f'{key} must be finite in [{low}, {high}]')
+        if type(self.min_points) is not int or not 16 <= self.min_points <= 10000:
+            raise ValueError('min_points must be an integer 16..10000')
+        return self
+
+
+def _unit(value):
+    size = np.linalg.norm(value)
+    if size < 1e-9:
+        raise ValueError('Degenerate profile direction')
+    return value / size
+
+
+def _fit(x, values, weights):
+    a = np.column_stack([np.ones(len(x)), x])
+    c = np.linalg.lstsq(a * np.sqrt(weights[:, None]), values * np.sqrt(weights[:, None]), rcond=None)[0]
+    error = np.sqrt(np.average(np.sum((values - a @ c)**2, axis=1), weights=weights))
+    return c, float(error)
+
+
+def _geometry_line(points, weights):
+    center = np.average(points, axis=0, weights=weights)
+    _, _, vt = np.linalg.svd((points-center)*np.sqrt(weights[:, None]), full_matrices=False)
+    direction = vt[0]
+    if np.dot(direction, points[-1]-points[0]) < 0:
+        direction = -direction
+    coordinate = (points-center) @ direction
+    residual = points-center-coordinate[:, None]*direction
+    rms = float(np.sqrt(np.average(np.sum(residual**2, axis=1), weights=weights)))
+    endpoints = center + np.array([coordinate.min(), coordinate.max()])[:, None]*direction
+    return center, direction, endpoints, rms
+
+
+def _duplicate_step_corner(step, corner):
+    """Identify two algorithms observing the same pair of converging flanks.
+
+    A sharp native jump across a V can trigger the step detector as well as the
+    corner detector. Only both matching geometric lines establish equivalence;
+    proximity of seam points or a prior alone never merges separate features.
+    """
+    if np.linalg.norm(step['point']-corner['point']) > 4.:
+        return None
+    diagnostics = []
+    for index in range(2):
+        a, b = step['lines'][index], corner['lines'][index]
+        span_a, span_b = np.linalg.norm(a[1]-a[0]), np.linalg.norm(b[1]-b[0])
+        direction_a, direction_b = _unit(a[1]-a[0]), _unit(b[1]-b[0])
+        angle = float(np.arccos(np.clip(np.dot(direction_a, direction_b), -1., 1.)))
+        rms_sum = step['flank_rms_mm'][index]+corner['flank_rms_mm'][index]
+        # Three residual scales, propagated over the shorter measured support;
+        # absolute angular limits prevent uncertain fits merging unrelated sides.
+        angular_limit = float(np.clip(3*np.arctan2(rms_sum, min(span_a, span_b)),
+                                      np.deg2rad(2.), np.deg2rad(8.)))
+        root_offset = float(np.linalg.norm(np.cross(corner['point']-a[0], direction_a)))
+        offset_limit = max(.15, 3*rms_sum)
+        if angle > angular_limit or root_offset > offset_limit:
+            return None
+        diagnostics.append({'angle_deg': float(np.rad2deg(angle)),
+                                'angle_limit_deg': float(np.rad2deg(angular_limit)),
+                                'root_to_step_flank_mm': root_offset, 'offset_limit_mm': offset_limit})
+    return diagnostics
+
+
+def _provenance(data):
+    fields = ('source_id', 'camera_id', 'image_size', 'sequence', 'generation', 'acquisition_session_id',
+              'calibration_id', 'optical_intrinsics_id', 'read_started', 'read_completed', 'received',
+              'controls', 'timing', 'processing', 'native_validation', 'frame_id')
+    metadata = data.get('metadata') or {}
+    return {key: deepcopy(data.get(key, metadata.get(key))) for key in fields
+            if key in data or key in metadata}
+
+
+def find_weld_seam(cloud, *, settings=None, previous_point_mm=None):
+    """Return a camera-mm seam centroid, two red flank lines and torch reference.
+
+    ``cloud`` is a native PointCloud or its ``to_dict()`` payload. A valid stripe
+    with no supported feature returns no_seam. Missing returns, poor geometry and
+    ambiguity never count as no_seam. Freshness/identity matching to a robot pose
+    belongs to the caller. The torch origin is 150 mm outward from the measured
+    centroid by default, +Z toward the weld along the two-flank normal bisector;
+    this is a sensing/replay reference, not a qualified contact torch offset.
+    """
+    settings = SeamSettings(**settings) if isinstance(settings, dict) else settings or SeamSettings()
+    settings.validate()
+    data = cloud.to_dict() if hasattr(cloud, 'to_dict') else cloud
+    if not isinstance(data, dict):
+        raise TypeError('cloud must be a native PointCloud or dictionary')
+    result = {'schema_version': 1, 'status': 'invalid', 'found': False, 'units': 'mm', 'coordinate_frame': 'camera',
+                  'seam_point_mm': None, 'camera_from_torch': None, 'stripe_direction_camera': None,
+                  'scan_direction_camera': None, 'surface_normal_camera': None, 'flank_lines_mm': [],
+                  'quality': {'good': False}, 'provenance': _provenance(data), 'settings': asdict(settings)}
+
+    def invalid(reason, **quality):
+        result['quality'].update(reason=reason, **quality)
+        return result
+
+    if data.get('units', 'mm') != 'mm' or data.get('coordinate_frame', 'camera') != 'camera':
+        return invalid('Native camera millimetres required; no implicit unit/frame conversion')
+    try:
+        p = np.asarray(data.get('xyz_mm'), float)
+        uv = np.asarray(data.get('uv'), float)
+    except (ValueError, TypeError):
+        return invalid('Malformed native XYZ/UV')
+    if p.ndim != 2 or p.shape[1:] != (3,) or uv.shape != (len(p), 2):
+        return invalid('Aligned native Nx3 XYZ and Nx2 UV required')
+    if not settings.min_points <= len(p) <= 20000 or not np.isfinite(p).all() or not np.isfinite(uv).all():
+        return invalid('Insufficient or nonfinite native stripe', input_count=len(p))
+    if np.any(p[:, 2] <= 0):
+        return invalid('Profile is behind camera')
+    axis = int(np.argmax(np.ptp(uv, axis=0)))
+    order = np.argsort(uv[:, axis], kind='stable')
+    p, uv = p[order], uv[order]
+    scan_steps = np.diff(uv[:, axis])
+    if np.any(scan_steps <= 0):
+        return invalid('Repeated scan coordinates are ambiguous')
+    has_scan_gaps = bool(np.max(scan_steps) > settings.max_scan_gap_px + 1e-6)
+    # A contiguous but noisy stripe cannot establish that a valley ended.
+    local = (p[:-2]+p[2:])/2
+    roughness = float(np.median(np.linalg.norm(p[1:-1]-local, axis=1)))
+    if roughness > settings.max_flank_rms_mm:
+        return invalid('Native stripe is too rough to establish a seam or disappearance', roughness_mm=roughness)
+    center = np.mean(p, axis=0)
+    _, singular, vt = np.linalg.svd(p-center, full_matrices=False)
+    stripe = vt[0]
+    if np.dot(stripe, p[-1]-p[0]) < 0:
+        stripe = -stripe
+    # Laser profiles are planar. Use the measured minor in-plane direction for
+    # depth; a straight stripe falls back to its camera-facing radial direction.
+    radial = _unit(center - stripe*np.dot(center, stripe))
+    depth = vt[1] if singular[1] > 1e-6 else radial
+    if np.dot(depth, radial) < 0:
+        depth = -depth
+    if singular[2] / np.sqrt(len(p)) > .15:
+        return invalid('XYZ is not a single laser plane')
+    # Metric arc coordinate remains monotonic through a vertical step or steep
+    # corner; PCA projection alone can reverse at exactly the sought feature.
+    x = np.r_[0., np.cumsum(np.linalg.norm(np.diff(p, axis=0), axis=1))]
+    x -= x.mean()
+    y = (p-center) @ depth
+    if np.any(np.diff(x) <= 0):
+        return invalid('Repeated XYZ prevents an ordered metric profile')
+    span = float(np.ptp(x))
+    if span < 2*settings.min_flank_span_mm + settings.max_feature_width_mm/2:
+        return invalid('Stripe has insufficient flank extent', span_mm=span)
+    weights = np.empty(len(x))
+    weights[1:-1] = (x[2:]-x[:-2])/2
+    weights[0], weights[-1] = (x[1]-x[0])/2, (x[-1]-x[-2])/2
+    normalized = (x-x.mean())/span
+    design = np.column_stack([np.ones(len(x)), normalized, normalized**2])
+    robust = np.ones(len(x))
+    for _ in range(8):
+        w = np.sqrt(weights*robust)
+        coef = np.linalg.lstsq(design*w[:, None], y*w, rcond=None)[0]
+        residual = y-design@coef
+        scale = max(.025, 1.4826*np.median(np.abs(residual-np.median(residual))))
+        robust = np.minimum(1., 1.5*scale/np.maximum(np.abs(residual), 1e-12))
+    dx = float(np.clip(np.median(np.diff(x)), .02, .1))
+    grid = np.linspace(x[0], x[-1], min(20001, max(64, int(span/dx)+1)))
+    dx = grid[1]-grid[0]
+    profile = gaussian_filter1d(np.interp(grid, x, residual), max(.5, .08/dx))
+    peaks, props = find_peaks(profile, prominence=settings.min_prominence_mm)
+    candidates = []
+    if len(peaks):
+        widths = peak_widths(profile, peaks, rel_height=.8)
+        for k, peak in enumerate(peaks):
+            left = float(np.interp(widths[2][k], np.arange(len(grid)), grid))
+            right = float(np.interp(widths[3][k], np.arange(len(grid)), grid))
+            if .2 <= right-left <= settings.max_feature_width_mm:
+                candidates.append({'kind': 'valley', 'left': left, 'right': right,
+                                       'prominence': float(props['prominences'][k]), 'x': float(grid[peak])})
+    # A genuine sharp height step must have contiguous native scan support and
+    # quiet fitted flanks on both sides; an omitted pixel interval is not a step.
+    smooth_y = gaussian_filter1d(np.interp(grid, x, y), max(.5, .06/dx))
+    gradient = np.gradient(smooth_y, dx)
+    slow = gaussian_filter1d(gradient, max(1., .7/dx))
+    derivative = np.abs(gradient-slow)
+    steps, _ = find_peaks(derivative, prominence=settings.min_prominence_mm/.5,
+                          distance=max(1, int(.5/dx)))
+    for peak in steps:
+        position = float(grid[peak])
+        if any(c['left']-.5 <= position <= c['right']+.5 for c in candidates):
+            continue
+        candidates.append({'kind': 'step', 'left': position-.15, 'right': position+.15,
+                               'prominence': float(derivative[peak]*.5), 'x': position})
+    # Preserve real abrupt steps instead of treating their metric arc as an
+    # unmeasured interpolated ramp. Native scan continuity is still mandatory.
+    for k in np.flatnonzero(np.linalg.norm(np.diff(p, axis=0), axis=1) >= settings.min_prominence_mm):
+        position = (x[k]+x[k+1])/2
+        if scan_steps[k] > settings.max_scan_gap_px or any(c['left']-.5 <= position <= c['right']+.5 for c in candidates):
+            continue
+        candidates.append({'kind': 'step', 'left': float(x[k]), 'right': float(x[k+1]),
+                               'prominence': float(np.linalg.norm(p[k+1]-p[k])), 'x': float(position)})
+    # Broad inside corners have two long straight sides, not a narrow notch.
+    # Fit 3D lines geometrically: noisy arc parameterization must not distort
+    # their normals or intersection. Smooth curvature must fit a quadratic much
+    # better than a sharp two-line corner before this alternative can qualify.
+    corner = None
+    smooth_rms = float(np.sqrt(np.average(residual**2, weights=weights)))
+    for split in np.unique(np.linspace(max(8, int(len(x)*.1)),
+                                       min(len(x)-8, int(len(x)*.9)), 241).astype(int)):
+        boundary = (x[split-1]+x[split])/2
+        masks = (x < boundary-.5, x > boundary+.5)
+        if any(mask.sum() < 8 or np.ptp(x[mask]) < 2*settings.min_flank_span_mm for mask in masks):
+            continue
+        lines = [_geometry_line(p[mask], weights[mask]) for mask in masks]
+        score = np.sqrt(sum(line[3]**2*weights[mask].sum() for mask, line in zip(masks, lines))/sum(weights[m].sum() for m in masks))
+        if score > .35*max(smooth_rms, .001):
+            continue
+        slopes = [np.dot(line[1], depth)/np.dot(line[1], stripe) for line in lines]
+        angle = np.arctan(slopes[0])-np.arctan(slopes[1])
+        if angle < np.deg2rad(12.):
+            continue
+        a, b = lines
+        parameters = np.linalg.lstsq(np.column_stack([a[1], -b[1]]), b[0]-a[0], rcond=None)[0]
+        limits = np.array([a[0]+parameters[0]*a[1], b[0]+parameters[1]*b[1]])
+        point = limits.mean(axis=0)
+        if np.linalg.norm(limits[1]-limits[0]) > .2 or np.linalg.norm(point-p[split]) > 2.:
+            continue
+        # Broad fits locate the joint; qualify the actual adjacent measured
+        # flanks, not distant curvature or blemishes elsewhere on each plate.
+        local_masks = []
+        for side, line in zip((-1, 1), lines):
+            along = (p-point) @ line[1] * side
+            # Near a right-angle corner the opposite plate can have the same
+            # tangent projection. Preserve the ordered native branch identity.
+            branch = np.arange(len(x)) < split if side < 0 else np.arange(len(x)) >= split
+            local_masks.append(branch & (along >= .5) & (along <= max(4., 2*settings.min_flank_span_mm)))
+        if any(mask.sum() < 8 for mask in local_masks):
+            continue
+        lines = [_geometry_line(p[mask], weights[mask]) for mask in local_masks]
+        if max(line[3] for line in lines) > settings.max_flank_rms_mm:
+            continue
+        masks = local_masks
+        a, b = lines
+        parameters = np.linalg.lstsq(np.column_stack([a[1], -b[1]]), b[0]-a[0], rcond=None)[0]
+        limits = np.array([a[0]+parameters[0]*a[1], b[0]+parameters[1]*b[1]])
+        point = limits.mean(axis=0)
+        if np.linalg.norm(limits[1]-limits[0]) > .2:
+            continue
+        local_slopes = [np.dot(line[1], depth)/np.dot(line[1], stripe) for line in lines]
+        angle = np.arctan(local_slopes[0])-np.arctan(local_slopes[1])
+        if angle < np.deg2rad(12.):
+            continue
+        nearest = int(np.argmin(np.linalg.norm(p-point, axis=1)))
+        crossing = float(x[nearest])
+        root_gap = float(np.linalg.norm(p[min(nearest+1, len(p)-1)]-p[max(0, nearest-1)]))
+        if np.linalg.norm(p[nearest]-point) > 1.5:
+            continue
+        candidate = {'kind': 'inside_corner', 'left': crossing-.15, 'right': crossing+.15,
+                         'prominence': float(smooth_rms), 'x': crossing, 'corner_geometry': lines,
+                         'corner_masks': masks, 'corner_point': point, 'corner_angle_deg': float(np.rad2deg(angle)),
+                         'observed_root_gap_mm': root_gap, 'corner_score': float(score)}
+        if corner is None or score < corner['corner_score']:
+            corner = candidate
+    if corner is not None:
+        candidates = [c for c in candidates if abs(c['x']-corner['x']) > 2.]
+        candidates.append(corner)
+    qualified = []
+    unsupported = 0
+    for candidate in candidates:
+        left, right = candidate['left'], candidate['right']
+        masks = candidate.get('corner_masks', ((x >= left-settings.min_flank_span_mm) & (x <= left-.1),
+                 (x >= right+.1) & (x <= right+settings.min_flank_span_mm)))
+        if any(mask.sum() < 5 or np.ptp(x[mask]) < settings.min_flank_span_mm*.7 for mask in masks):
+            unsupported += 1
+            continue
+        if candidate['kind'] == 'inside_corner':
+            fits = []
+            for mask, line in zip(masks, candidate['corner_geometry']):
+                slope = (line[2][1]-line[2][0])/np.ptp(x[mask])
+                fits.append((np.array([line[2][0]-x[mask].min()*slope, slope]), line[3]))
+        else:
+            fits = [_fit(x[mask], p[mask], weights[mask]) for mask in masks]
+        if max(fit[1] for fit in fits) > settings.max_flank_rms_mm:
+            unsupported += 1
+            continue
+        inside = (x >= left) & (x <= right)
+        if inside.sum() < 3 and candidate['kind'] == 'valley':
+            continue
+        if candidate['kind'] != 'inside_corner':
+            support = np.flatnonzero(masks[0] | inside | masks[1])
+            if np.any(np.diff(uv[support[0]:support[-1]+1, axis]) > settings.max_scan_gap_px + 1e-6):
+                unsupported += 1
+                continue
+        if candidate['kind'] == 'inside_corner':
+            point = candidate['corner_point']
+        elif candidate['kind'] == 'valley':
+            endpoints = np.array([fits[0][0][0]+left*fits[0][0][1], fits[1][0][0]+right*fits[1][0][1]])
+            bridge = endpoints[0] + ((x[inside]-left)/(right-left))[:, None]*(endpoints[1]-endpoints[0])
+            depression = (p[inside]-bridge) @ depth
+            mass = np.maximum(depression, 0)*weights[inside]
+            if mass.sum() < 1e-6 or depression.max() < settings.min_prominence_mm:
+                continue
+            point = np.average(p[inside], axis=0, weights=mass)
+        else:
+            # A step has two observed limits; centroid is their geometric midpoint.
+            position = candidate['x']
+            limits = [fit[0][0]+position*fit[0][1] for fit in fits]
+            if np.linalg.norm(limits[1]-limits[0]) < settings.min_prominence_mm:
+                continue
+            point = np.mean(limits, axis=0)
+        tangents = [_unit(fit[0][1]) for fit in fits]
+        normals = [_unit(-depth + stripe*np.dot(tangent, depth)/max(np.dot(tangent, stripe), .1))
+                   for tangent in tangents]
+        normal = _unit(np.sum(normals, axis=0))
+        transverse = _unit(np.sum(tangents, axis=0))
+        transverse = _unit(transverse-normal*np.dot(transverse, normal))
+        torch_z = -normal
+        torch_y = _unit(np.cross(torch_z, transverse))
+        transverse = _unit(np.cross(torch_y, torch_z))
+        pose = np.eye(4)
+        pose[:3, :3] = np.column_stack([transverse, torch_y, torch_z])
+        pose[:3, 3] = point + normal*settings.torch_standoff_mm
+        lines = []
+        for mask, (coef, _) in zip(masks, fits):
+            lines.append([coef[0]+min(x[mask])*coef[1], coef[0]+max(x[mask])*coef[1]])
+        qualified.append({**candidate, 'point': point, 'normal': normal, 'stripe': transverse,
+                          'advance': torch_y, 'pose': pose, 'lines': np.asarray(lines),
+                          'flank_rms_mm': [fit[1] for fit in fits]})
+    raw_candidate_count = len(qualified)
+    duplicates = []
+    corners = [candidate for candidate in qualified if candidate['kind'] == 'inside_corner']
+    unique = []
+    for candidate in qualified:
+        duplicate = None
+        if candidate['kind'] == 'step':
+            for corner_candidate in corners:
+                equivalence = _duplicate_step_corner(candidate, corner_candidate)
+                if equivalence is not None:
+                    duplicate = {'discarded_kind': 'step', 'retained_kind': 'inside_corner',
+                                     'reason': 'same_two_geometric_flanks',
+                                     'discarded_point_mm': candidate['point'].tolist(),
+                                     'retained_point_mm': corner_candidate['point'].tolist(), 'flanks': equivalence}
+                    break
+        if duplicate is None:
+            unique.append(candidate)
+        else:
+            duplicates.append(duplicate)
+    qualified = unique
+    result['quality'].update(input_count=len(p), span_mm=span, candidate_count=len(qualified),
+                             raw_candidate_count=raw_candidate_count, duplicate_candidates=duplicates)
+    if previous_point_mm is not None:
+        prior = np.asarray(previous_point_mm, float)
+        if prior.shape != (3,) or not np.isfinite(prior).all():
+            raise ValueError('previous_point_mm must be finite camera XYZ millimetres')
+        result['quality']['association_prior_camera_mm'] = prior.tolist()
+        result['quality']['candidate_prior_distances_mm'] = [float(np.linalg.norm(c['point']-prior)) for c in qualified]
+        qualified = [c for c in qualified if np.linalg.norm(c['point']-prior) <= settings.association_radius_mm]
+        result['quality']['associated_candidates'] = len(qualified)
+        if not qualified and result['quality']['candidate_count']:
+            result.update(status='ambiguous')
+            result['quality']['reason'] = 'Features outside association radius; refusing surface switch'
+            return result
+    if not qualified:
+        if has_scan_gaps:
+            return invalid('Native scan gap cannot establish disappearance', max_scan_gap_px=float(np.max(scan_steps)))
+        if unsupported:
+            return invalid('Candidate sharp feature lacks good flanking support', unsupported_candidates=unsupported)
+        result.update(status='no_seam')
+        result['quality'].update(good=True, reason='Valid contiguous stripe without supported sharp feature')
+        return result
+    if len(qualified) > 1:
+        result.update(status='ambiguous')
+        result['quality']['reason'] = 'Multiple supported weld features; provide a measured prior'
+        return result
+    selected = qualified[0]
+    result.update(status='found', found=True, seam_point_mm=selected['point'].tolist(),
+                  camera_from_torch=selected['pose'].tolist(),
+                  stripe_direction_camera=selected['stripe'].tolist(),
+                  surface_normal_camera=selected['normal'].tolist(),
+                  scan_direction_camera=selected['advance'].tolist(), flank_lines_mm=selected['lines'].tolist())
+    result['quality'].update(good=True, reason='Supported two-flank native feature',
+                             feature_kind=selected['kind'], prominence_mm=selected['prominence'],
+                             width_mm=selected['right']-selected['left'],
+                             flank_rms_mm=selected['flank_rms_mm'],
+                             centroid_method=('native_spacing_weighted_depression' if selected['kind'] == 'valley'
+                                              else 'supported_flank_intersection' if selected['kind'] == 'inside_corner'
+                                              else 'fitted_step_limits_midpoint'),
+                             inferred_root=selected['kind'] == 'inside_corner',
+                             observed_root_gap_mm=selected.get('observed_root_gap_mm'),
+                             corner_angle_deg=selected.get('corner_angle_deg'),
+                             accuracy_qualified=False)
+    return result
