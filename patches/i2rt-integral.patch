index 0000000..8e0ca93
--- /dev/null
+++ b/i2rt/robots/gravity_feedforward.py
@@ -0,0 +1,24 @@
+"""Local linearization of SDK inverse-dynamics gravity; no hardware access."""
+import numpy as np
+
+
+class LinearGravity:
+    def __init__(self, gravity_at, reference, radius=0.15):
+        self.reference = np.asarray(reference, dtype=float).copy()
+        self.radius = float(radius)
+        self.base = np.asarray(gravity_at(self.reference), dtype=float).copy()
+        eps = 1e-4
+        columns = []
+        for axis in np.eye(len(self.reference)):
+            plus = np.asarray(gravity_at(self.reference + eps * axis)).copy()
+            minus = np.asarray(gravity_at(self.reference - eps * axis)).copy()
+            columns.append((plus - minus) / (2 * eps))
+        self.jacobian = np.column_stack(columns)
+        if not np.isfinite(self.base).all() or not np.isfinite(self.jacobian).all():
+            raise ValueError("Gravity model must be finite")
+
+    def evaluate(self, q, exact):
+        delta = np.asarray(q) - self.reference
+        if np.max(np.abs(delta)) > self.radius:
+            return np.asarray(exact).copy(), "sdk_fallback"
+        return self.base + self.jacobian @ delta, "linear"
