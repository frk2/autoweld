new file mode 100644
index 0000000..c76074a
--- /dev/null
+++ b/i2rt/robots/waypoint_motion.py
@@ -0,0 +1,87 @@
+"""Rest-to-rest joint references; no hardware I/O or robot-specific kinematics."""
+
+from dataclasses import dataclass
+
+import numpy as np
+from scipy.interpolate import CubicSpline
+
+
+def time_scale(u: float | np.ndarray) -> tuple:
+    """Seventh-degree scaling and derivatives; v/a/jerk vanish at both ends."""
+    u = np.clip(np.asarray(u, dtype=float), 0.0, 1.0)
+    return (
+        35 * u**4 - 84 * u**5 + 70 * u**6 - 20 * u**7,
+        140 * u**3 - 420 * u**4 + 420 * u**5 - 140 * u**6,
+        420 * u**2 - 1680 * u**3 + 2100 * u**4 - 840 * u**5,
+        840 * u - 5040 * u**2 + 8400 * u**3 - 4200 * u**4,
+    )
+
+
+@dataclass
+class JointPath:
+    knots: np.ndarray
+    positions: np.ndarray
+    duration: float
+
+    def __post_init__(self):
+        self.knots = np.array(self.knots, dtype=float, copy=True)
+        self.positions = np.array(self.positions, dtype=float, copy=True)
+        if (
+            self.knots.ndim != 1
+            or len(self.knots) < 2
+            or self.positions.ndim != 2
+            or len(self.positions) != len(self.knots)
+            or not np.isfinite(self.positions).all()
+            or not np.isfinite(self.knots).all()
+            or np.any(np.diff(self.knots) <= 0)
+            or self.knots[0] != 0
+            or self.knots[-1] != 1
+        ):
+            raise ValueError("Expected finite joint path at increasing knots from 0 to 1")
+        if not np.isfinite(self.duration) or self.duration <= 0:
+            raise ValueError("Motion duration must be finite and positive")
+        self.duration = float(self.duration)
+        self.spline = CubicSpline(self.knots, self.positions, axis=0)
+
+    def sample(self, elapsed: float) -> tuple[np.ndarray, np.ndarray, np.ndarray, np.ndarray]:
+        s, ds, dds, ddds = time_scale(elapsed / self.duration)
+        qs, qss, qsss = (self.spline(s, order) for order in (1, 2, 3))
+        q = self.spline(s)
+        v = qs * ds / self.duration
+        a = (qss * ds**2 + qs * dds) / self.duration**2
+        j = (qsss * ds**3 + 3 * qss * ds * dds + qs * ddds) / self.duration**3
+        return q, v, a, j
+
+
+@dataclass
+class FeedJointPath(JointPath):
+    """Constant parameter speed between smooth acceleration/deceleration ramps."""
+    ramp_fraction: float = 0.1
+
+    def __post_init__(self):
+        super().__post_init__()
+        if not np.isfinite(self.ramp_fraction) or not 0 < self.ramp_fraction < .5:
+            raise ValueError('Feed ramp fraction must be in (0, .5)')
+        self.ramp_fraction = float(self.ramp_fraction)
+
+    def phase(self, elapsed):
+        u = float(np.clip(elapsed / self.duration, 0, 1))
+        r = self.ramp_fraction
+        v = 1 / (1-r)
+        if r <= u <= 1-r:
+            return (v*(u-r/2), v/self.duration, 0., 0.)
+        reverse = u > .5
+        x = (1-u if reverse else u)/r
+        f = 2.5*x**4 - 3*x**5 + x**6
+        df = 10*x**3 - 15*x**4 + 6*x**5
+        ddf = 30*x**2 - 60*x**3 + 30*x**4
+        dddf = 60*x - 180*x**2 + 120*x**3
+        s = 1-r*v*f if reverse else r*v*f
+        return (s, v*df/self.duration, (-1 if reverse else 1)*v*ddf/r/self.duration**2,
+                v*dddf/r**2/self.duration**3)
+
+    def sample(self, elapsed):
+        s, ds, dds, ddds = self.phase(elapsed)
+        qs, qss, qsss = (self.spline(s, n) for n in (1, 2, 3))
+        return (self.spline(s), qs*ds, qss*ds**2 + qs*dds,
+                qsss*ds**3 + 3*qss*ds*dds + qs*ddds)
