index 0000000..726ea34
--- /dev/null
+++ b/i2rt/motor_drivers/position_speed.py
@@ -0,0 +1,65 @@
+"""Disabled-only position-speed commissioning through the SDK; no Flash writes."""
+
+import math
+
+from i2rt.motor_config_tool.dm_motor_registers import read_register, write_register
+from i2rt.motor_drivers.utils import MotorType
+
+SURVEY_REGISTERS = ("CTRL_MODE", "Gr", "PMAX", "VMAX", "TMAX", "ACC", "DEC",
+                    "MAX_SPD", "TIMEOUT", "Damp", "KP_ASR", "KI_ASR", "KP_APR", "KI_APR")
+
+
+def prepare_modes(channel, motor_list, modes):
+    """Survey ALL motors before changing ANY mode. Fail disabled on partial transitions.
+
+    Existing onboard gains and acceleration/deceleration are only read, never tuned.
+    A successful RAM read-back is necessary, but the first seeded control exchange
+    must still succeed: older firmware may require a power cycle.
+    """
+    from i2rt.motor_drivers.dm_driver import DMSingleMotorCanInterface
+
+    if set(modes) != {i for i, _ in motor_list} or any(m not in ("MIT", "POS_VEL") for m in modes.values()):
+        raise ValueError("Explicit MIT/POS_VEL mode required for every motor")
+    interface = DMSingleMotorCanInterface(channel=channel, name="position_speed_setup")
+    survey = {}
+    try:
+        for motor_id, motor_type in motor_list:
+            state = interface.read_motor_status(motor_id, motor_type)
+            # 0xD is the disabled comm-timeout latch left by the old SDK close.
+            # All other faults and any enabled motor refuse the transition.
+            if state.error_code not in ("0x0", "0xd") or abs(state.velocity) > .05:
+                raise RuntimeError(f"Motor {motor_id}: mode transition requires disabled, stationary feedback")
+            values = {reg: read_register(interface, motor_id, reg) for reg in SURVEY_REGISTERS}
+            survey[motor_id] = values
+            values["status_before"] = state.error_code
+            const = MotorType.get_motor_constants(motor_type)
+            for reg, expected in (("PMAX", const.POSITION_MAX), ("VMAX", const.VELOCITY_MAX), ("TMAX", const.TORQUE_MAX)):
+                if not math.isclose(values[reg], expected, rel_tol=1e-4):
+                    raise RuntimeError(f"Motor {motor_id}: {reg}={values[reg]} differs from SDK {expected}")
+            if modes[motor_id] == "POS_VEL":
+                for reg in ("ACC", "MAX_SPD", "Damp", "KP_ASR", "KP_APR"):
+                    if not math.isfinite(values[reg]) or values[reg] <= 0:
+                        raise RuntimeError(f"Motor {motor_id}: position-speed needs positive {reg}; got {values[reg]}")
+                if not math.isfinite(values["DEC"]) or values["DEC"] == 0:
+                    raise RuntimeError(f"Motor {motor_id}: missing deceleration setting")
+                if values["TIMEOUT"] <= 0:
+                    raise RuntimeError(f"Motor {motor_id}: position-speed needs an enabled firmware watchdog")
+        # Finish the old SDK's timeout shutdown explicitly, with no enable frame.
+        for motor_id, motor_type in motor_list:
+            if survey[motor_id]["status_before"] == "0xd":
+                interface.motor_modes = {motor_id: "POS_VEL" if survey[motor_id]["CTRL_MODE"] == 2 else "MIT"}
+                interface.motor_off(motor_id)
+                interface.clean_error(motor_id)
+                if interface.read_motor_status(motor_id, motor_type).error_code != "0x0":
+                    raise RuntimeError(f"Motor {motor_id}: timeout latch did not clear while disabled")
+        for motor_id, _ in motor_list:
+            expected = 2 if modes[motor_id] == "POS_VEL" else 1
+            if survey[motor_id]["CTRL_MODE"] != expected:
+                write_register(interface, motor_id, "CTRL_MODE", expected)
+            actual = read_register(interface, motor_id, "CTRL_MODE")
+            if actual != expected:
+                raise RuntimeError(f"Motor {motor_id}: mode read-back {actual}, expected {expected}; left disabled")
+            survey[motor_id]["selected_mode"] = actual
+        return survey
+    finally:
+        interface.close()
diff --git a/i2rt/robots/position_speed_robot.py b/i2rt/robots/position_speed_robot.py
new file mode 100644
index 0000000..a6eff09
--- /dev/null
+++ b/i2rt/robots/position_speed_robot.py
@@ -0,0 +1,89 @@
+"""YAM position/speed cascades, optionally keeping J4/J5 in MIT with gravity.
+
+The firmware speed field is a positive ceiling, NOT signed velocity feedforward.
+All existing path, oscillation and execution-watchdog logic runs in the base SDK.
+"""
+
+import numpy as np
+from i2rt.robots.motor_chain_robot import MotorChainRobot
+
+
+class PositionSpeedRobot(MotorChainRobot):
+    def __init__(self, *args, mit_arm_joint_indices=(), **kwargs):
+        if tuple(mit_arm_joint_indices) not in ((), (3, 4)):
+            raise ValueError('Supported mixed arm configuration is J4/J5 MIT only')
+        self.mit_arm_joint_indices = tuple(mit_arm_joint_indices)
+        self.position_speed_limit = .15  # Conservative initial per-joint ceiling, rad/s.
+        kwargs.update(use_gravity_comp=bool(self.mit_arm_joint_indices),
+                      use_coulomb_friction=False, zero_gravity_mode=False)
+        super().__init__(*args, **kwargs)
+
+    def configure_position_speed_limit(self, limit):
+        if not np.isfinite(limit) or not 0 < limit <= 1.:
+            raise ValueError("Position-speed commissioning ceiling must be in (0, 1] rad/s")
+        with self._command_lock:
+            self.position_speed_limit = float(limit)
+
+    def _update_joint_state(self, motor_torques, joint_commands, encoder_infos=None):
+        n = self._gripper_index if self._gripper_index is not None else len(self.motor_chain)
+        mit = getattr(self, 'mit_arm_joint_indices', ())
+        pos_indices = np.array([j for j in range(n) if j not in mit], dtype=int)
+        # POS_VEL joints use only checked position and a positive speed ceiling.
+        # MIT joints retain native PD, signed planned velocity and gravity torque.
+        motor_torques = motor_torques.copy()
+        motor_torques[pos_indices] = 0.
+        joint_commands.kp[pos_indices] = 0.
+        joint_commands.kd[pos_indices] = 0.
+        joint_commands.vel[pos_indices] = self.position_speed_limit
+        joint_commands.compensate_quantization = False
+        if self._torque_terms is not None and mit:
+            terms = self._torque_terms.copy()
+            for key in ('gravity_nm', 'gravity_load_nm', 'friction_nm', 'p_estimate_nm',
+                        'd_estimate_nm', 'i_nm', 'command_nm', 'feedforward_sent_nm', 'total_estimate_nm'):
+                if key in terms:
+                    terms[key] = np.asarray(terms[key]).copy()
+                    terms[key][pos_indices] = 0.
+            terms.update(controller='MIXED_J45', onboard_loop_terms_available=False,
+                         host_terms_valid_arm_joints=[j+1 for j in mit],
+                         gravity_enabled=self.use_gravity_comp, friction_enabled=False,
+                         speed_limit_rad_s=[None if j in mit else self.position_speed_limit for j in range(n)])
+            self._torque_terms = terms
+        elif self._torque_terms is not None:
+            self._torque_terms = {"timestamp": self._joint_state.timestamp,
+                "controller": "POS_VEL", "onboard_loop_terms_available": False,
+                "gravity_enabled": False, "friction_enabled": False,
+                "motor_reported_nm": self._joint_state.eff.copy(),
+                "speed_limit_rad_s": [self.position_speed_limit]*n}
+        self._last_motor_torques = motor_torques.copy()
+        if self._motion_fault is not None:
+            self._motion_fault["response"] = ("Latched mixed-mode hold at measured pose (J4/J5 factory MIT PD)"
+                                               if mit else "Latched position-speed hold at measured pose")
+        return super()._update_joint_state(motor_torques, joint_commands, encoder_infos)
+
+    def command_joint_pos_pid(self, joint_pos, ki, integral_limit, **kwargs):
+        if np.any(np.asarray(ki) != 0):
+            raise ValueError("Position-speed has no host integral torque input")
+        return super().command_joint_pos_pid(joint_pos, ki, integral_limit, **kwargs)
+
+    def configure_gravity(self, factors, *, model="sdk", reference=None):
+        if getattr(self, 'mit_arm_joint_indices', ()):
+            return super().configure_gravity(factors, model=model, reference=reference)
+        raise RuntimeError("Position-speed has no torque feedforward; use MIT for gravity compensation")
+
+    def get_gravity_info(self):
+        info = super().get_gravity_info()
+        info['active_arm_joints'] = ([j+1 for j in getattr(self, 'mit_arm_joint_indices', ())]
+                                     if self.use_gravity_comp else [])
+        return info
+
+    def configure_friction(self, *, enabled=True, **kwargs):
+        if enabled:
+            raise RuntimeError("Position-speed has no friction torque feedforward")
+        self.use_coulomb_friction = False
+
