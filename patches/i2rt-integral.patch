index 0000000..b0fe34c
--- /dev/null
+++ b/i2rt/robots/integral_control.py
@@ -0,0 +1,23 @@
+"""Optional integral torque correction; existing motor-side PD remains unchanged."""
+
+import numpy as np
+
+
+def integral_torque(
+    error: np.ndarray,
+    ki: np.ndarray,
+    dt: float,
+    previous: np.ndarray,
+    limit: np.ndarray,
+    *,
+    deadband: float = 0.0,
+) -> np.ndarray:
+    """Integrate position error in rad*s, returning bounded torque in Nm.
+
+    Clamping the stored torque prevents windup. A stalled/invalid feedback interval
+    clears the correction rather than integrating unobserved motion.
+    """
+    if not np.isfinite(dt) or dt <= 0.0 or dt > 0.05 or not np.isfinite(error).all():
+        return np.zeros_like(previous)
+    error = np.where(np.abs(error) > deadband, error, 0.0)
+    return np.where(ki > 0, np.clip(previous + ki * error * dt, -limit, limit), 0.0)
diff --git a/i2rt/robots/oscillation_guard.py b/i2rt/robots/oscillation_guard.py
new file mode 100644
index 0000000..40f33f0
--- /dev/null
+++ b/i2rt/robots/oscillation_guard.py
@@ -0,0 +1,103 @@
+"""Detect repeated fast arm reversals from fresh encoder feedback; no hardware I/O."""
+from collections import deque
+
+import numpy as np
+
+
+class OscillationGuard:
+    def __init__(self, joints=6, window_s=1.0, speed_rad_s=0.15,
+                 excursion_deg=0.3, reversals=6):
+        self.joints = joints
+        self.window_s = window_s
+        self.speed_rad_s = speed_rad_s
+        self.excursion_rad = np.deg2rad(excursion_deg)
+        self.reversals = reversals
+        self.reset()
+
+    def reset(self):
+        self.last_timestamp = None
+        self.samples = deque()
+        self.turns = [deque() for _ in range(self.joints)]
+        self.direction = np.zeros(self.joints)
+        self.turn_position = None
+
+    def observe(self, timestamp, position, velocity):
+        q = np.asarray(position)[:self.joints]
+        v = np.asarray(velocity)[:self.joints]
+        if not np.isfinite(timestamp) or not np.isfinite(q).all() or not np.isfinite(v).all():
+            return None
+        if self.last_timestamp is not None:
+            if timestamp <= self.last_timestamp:
+                return None  # Re-reading one CAN sample must never count as a reversal.
+            if timestamp - self.last_timestamp > min(self.window_s, .1):
+                self.reset()
+        self.last_timestamp = timestamp
+        self.samples.append((timestamp, q.copy()))
+        while len(self.samples) > 1 and self.samples[1][0] <= timestamp - self.window_s:
+            self.samples.popleft()
+        if self.turn_position is None:
+            self.turn_position = q.copy()
+        for j in range(self.joints):
+            while self.turns[j] and timestamp - self.turns[j][0] > self.window_s:
+                self.turns[j].popleft()
+            if abs(v[j]) < self.speed_rad_s:
+                continue  # Hysteresis ignores velocity sign noise near zero.
+            direction = np.sign(v[j])
+            if self.direction[j] and direction != self.direction[j]:
+                if abs(q[j] - self.turn_position[j]) >= np.deg2rad(0.1):
+                    self.turns[j].append(timestamp)
+                    self.turn_position[j] = q[j]
+            elif not self.direction[j]:
+                self.turn_position[j] = q[j]
+            self.direction[j] = direction
+            if len(self.turns[j]) >= self.reversals and timestamp - self.samples[0][0] >= self.window_s:
+                midpoint = timestamp - self.window_s / 2
+                early = [sample[1][j] for sample in self.samples if sample[0] < midpoint]
+                late = [sample[1][j] for sample in self.samples if sample[0] >= midpoint]
+                early_turns = sum(t < midpoint for t in self.turns[j])
+                late_turns = sum(t >= midpoint for t in self.turns[j])
+                if not early or not late or early_turns < 3 or late_turns < 3:
+                    continue
+                early_span, late_span = float(np.ptp(early)), float(np.ptp(late))
+                # Require ongoing, non-decaying oscillation in both halves of the window.
+                # A large waypoint transient followed by settling must not count.
+                if min(early_span, late_span) >= self.excursion_rad and late_span >= .7 * early_span:
+                    return {"joint": j + 1, "timestamp": float(timestamp),
+                            "reversals": len(self.turns[j]), "window_s": self.window_s,
+                            "excursion_deg": float(np.rad2deg(max(early_span, late_span))),
+                            "early_span_deg": float(np.rad2deg(early_span)),
+                            "late_span_deg": float(np.rad2deg(late_span)),
+                            "speed_rad_s": float(v[j]),
+                            "reason": f"Sustained oscillation on J{j + 1}"}
+        return None
+
+
+class QuietWindow:
+    """Recovery requires a full second of fresh, position-stable, low-speed samples."""
+    def __init__(self):
+        self.reset()
+
+    def reset(self):
+        self.samples = deque()
+        self.ready = False
+
+    def observe(self, timestamp, position, velocity):
+        q = np.asarray(position)[:6]
+        v = np.asarray(velocity)[:6]
+        if not np.isfinite(timestamp) or not np.isfinite(q).all() or not np.isfinite(v).all():
+            self.reset()
+            return False
+        if self.samples:
+            if timestamp <= self.samples[-1][0]:
+                return self.ready
+            if timestamp - self.samples[-1][0] > .1:
+                self.reset()
+        self.samples.append((timestamp, q.copy(), v.copy()))
+        while len(self.samples) > 1 and self.samples[1][0] <= timestamp - 1.0:
+            self.samples.popleft()
+        self.ready = bool(
+            timestamp - self.samples[0][0] >= 1.0
+            and np.max(np.ptp([r[1] for r in self.samples], axis=0)) <= np.deg2rad(.1)
+            and np.max(np.abs([r[2] for r in self.samples])) <= .1
+        )
+        return self.ready
diff --git a/i2rt/robots/gravity_feedforward.py b/i2rt/robots/gravity_feedforward.py
