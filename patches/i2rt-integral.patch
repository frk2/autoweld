new file mode 100644
index 0000000..92ba0bc
--- /dev/null
+++ b/i2rt/motor_drivers/mit_command.py
@@ -0,0 +1,36 @@
+"""MIT command quantization compensation; native motor P/D still close the loop."""
+
+import math
+
+from i2rt.motor_drivers.utils import float_to_uint, uint_to_float
+
+
+def mit_codes(pos, vel, kp, kd, torque, const, *, compensate=False):
+    """Return five wire codes. Legacy encoding is preserved unless explicitly enabled.
+
+    With compensation, the torque field supplies the residual reference torque
+    lost to position/velocity quantization. This is algebraically the same motor
+    PD law, not an extra feedback controller. No dither or gain increase is used.
+    Residuals use the encoded gains; gain quantization is not compensated with
+    delayed host feedback. Saturation always wins over compensation.
+    """
+    fields = [(pos, const.POSITION_MIN, const.POSITION_MAX, 16),
+              (vel, const.VELOCITY_MIN, const.VELOCITY_MAX, 12),
+              (kp, const.KP_MIN, const.KP_MAX, 12),
+              (kd, const.KD_MIN, const.KD_MAX, 12)]
+    if not all(math.isfinite(float(x)) for x in (pos, vel, kp, kd, torque)):
+        raise ValueError("MIT commands must be finite")
+    if not compensate:
+        return tuple(float_to_uint(*f) for f in fields) + (
+            float_to_uint(torque, const.TORQUE_MIN, const.TORQUE_MAX, 12),)
+
+    def nearest(value, lo, hi, bits):
+        return int(math.floor((min(hi, max(lo, value))-lo) * ((1 << bits)-1) / (hi-lo) + .5))
+
+    codes = tuple(nearest(*f) for f in fields)
+    p, v, p_gain, d_gain = [uint_to_float(c, *f[1:]) for c, f in zip(codes, fields)]
+    bounded_pos = min(const.POSITION_MAX, max(const.POSITION_MIN, pos))
+    bounded_vel = min(const.VELOCITY_MAX, max(const.VELOCITY_MIN, vel))
+    torque = min(const.TORQUE_MAX, max(const.TORQUE_MIN, torque))
+    torque += p_gain * (bounded_pos-p) + d_gain * (bounded_vel-v)
+    return codes + (nearest(torque, const.TORQUE_MIN, const.TORQUE_MAX, 12),)
