+"""Rest-to-rest joint references; no hardware I/O or robot-specific kinematics."""
+
+from dataclasses import dataclass
+
+import numpy as np
+from scipy.interpolate import CubicSpline
+
+
+def time_scale(u: float | np.ndarray) -> tuple:
+    """Seventh-degree scaling and derivatives; v/a/jerk vanish at both ends."""
+    u = np.clip(np.asarray(u, dtype=float), 0.0, 1.0)
+    return (
+        35 * u**4 - 84 * u**5 + 70 * u**6 - 20 * u**7,
+        140 * u**3 - 420 * u**4 + 420 * u**5 - 140 * u**6,
+        420 * u**2 - 1680 * u**3 + 2100 * u**4 - 840 * u**5,
+        840 * u - 5040 * u**2 + 8400 * u**3 - 4200 * u**4,
+    )
+
+
+@dataclass
+class JointPath:
+    knots: np.ndarray
+    positions: np.ndarray
+    duration: float
+
+    def __post_init__(self):
+        self.knots = np.array(self.knots, dtype=float, copy=True)
+        self.positions = np.array(self.positions, dtype=float, copy=True)
+        if (
+            self.knots.ndim != 1
+            or len(self.knots) < 2
+            or self.positions.ndim != 2
+            or len(self.positions) != len(self.knots)
+            or not np.isfinite(self.positions).all()
+            or not np.isfinite(self.knots).all()
+            or np.any(np.diff(self.knots) <= 0)
+            or self.knots[0] != 0
+            or self.knots[-1] != 1
+        ):
+            raise ValueError("Expected finite joint path at increasing knots from 0 to 1")
+        if not np.isfinite(self.duration) or self.duration <= 0:
+            raise ValueError("Motion duration must be finite and positive")
+        self.duration = float(self.duration)
+        self.spline = CubicSpline(self.knots, self.positions, axis=0)
+
+    def sample(self, elapsed: float) -> tuple[np.ndarray, np.ndarray, np.ndarray, np.ndarray]:
+        s, ds, dds, ddds = time_scale(elapsed / self.duration)
+        qs, qss, qsss = (self.spline(s, order) for order in (1, 2, 3))
+        q = self.spline(s)
+        v = qs * ds / self.duration
+        a = (qss * ds**2 + qs * dds) / self.duration**2
+        j = (qsss * ds**3 + 3 * qss * ds * dds + qs * ddds) / self.duration**3
+        return q, v, a, j
+
+
+@dataclass
+class FeedJointPath(JointPath):
+    """Constant parameter speed between smooth acceleration/deceleration ramps."""
+    ramp_fraction: float = 0.1
+
+    def __post_init__(self):
+        super().__post_init__()
+        if not np.isfinite(self.ramp_fraction) or not 0 < self.ramp_fraction < .5:
+            raise ValueError('Feed ramp fraction must be in (0, .5)')
+        self.ramp_fraction = float(self.ramp_fraction)
+
+    def phase(self, elapsed):
+        u = float(np.clip(elapsed / self.duration, 0, 1))
+        r = self.ramp_fraction
+        v = 1 / (1-r)
+        if r <= u <= 1-r:
+            return (v*(u-r/2), v/self.duration, 0., 0.)
+        reverse = u > .5
+        x = (1-u if reverse else u)/r
+        f = 2.5*x**4 - 3*x**5 + x**6
+        df = 10*x**3 - 15*x**4 + 6*x**5
+        ddf = 30*x**2 - 60*x**3 + 30*x**4
+        dddf = 60*x - 180*x**2 + 120*x**3
+        s = 1-r*v*f if reverse else r*v*f
+        return (s, v*df/self.duration, (-1 if reverse else 1)*v*ddf/r/self.duration**2,
+                v*dddf/r**2/self.duration**3)
+
+    def sample(self, elapsed):
+        s, ds, dds, ddds = self.phase(elapsed)
+        qs, qss, qsss = (self.spline(s, n) for n in (1, 2, 3))
+        return (self.spline(s), qs*ds, qss*ds**2 + qs*dds,
+                qsss*ds**3 + 3*qss*ds*dds + qs*ddds)
diff --git a/i2rt/robots/encoder_teaching.py b/i2rt/robots/encoder_teaching.py
new file mode 100644
index 0000000..e23a896
--- /dev/null
+++ b/i2rt/robots/encoder_teaching.py
@@ -0,0 +1,159 @@
+"""Read-only six-axis YAM feedback for manual commissioning.
+
+This does not construct DMChainCanInterface/MotorChainRobot, run startup repair,
+change a motor mode/zero/register, or enable/disable/command a motor. The caller
+must hold its sole-owner CAN lock before constructing this object.
+"""
+from __future__ import annotations
+
+import math
+import time
+import uuid
+from dataclasses import asdict
+from typing import Any, Callable
+
+import numpy as np
+
+from i2rt.motor_config_tool.dm_motor_registers import read_register, read_register_sample
+from i2rt.motor_drivers.dm_driver import DMSingleMotorCanInterface
+from i2rt.motor_drivers.utils import MotorType
+from i2rt.robots.utils import ArmType, _load_arm_config
+
+MOTOR_IDS = (1, 2, 3, 4, 5, 6)
+READ_REGISTERS = ('Gr', 'PMAX', 'VMAX')
+MAX_FRAME_AGE_S = .5
+MAX_CONTINUITY_GAP_S = .25
+
+
+class ReadOnlyArmEncoder:
+    """Exactly six SDK status requests per read, with fixed non-normalized mapping.
+
+    Position comes from native read-only xout register81, preserving its CAN
+    reply timestamp and bytes. Packed0xCC feedback (which can track p_m instead)
+    stays separate. PMAX qualifies that packed field, never xout's wrap period.
+    Mechanical winding/zero are not
+    independently established by a protocol field: explicit software anchor and
+    continuous bounded manual observation are required for endpoint capture.
+    """
+    def __init__(self, channel: str = 'can0', *, interface: Any = None,
+                 register_reader: Callable = read_register, output_reader: Callable = read_register_sample, offsets_rad: Any = None,
+                 max_manual_speed_rad_s: float = .5) -> None:
+        hw = _load_arm_config(ArmType.YAM)
+        if tuple(mid for mid, _ in hw.motor_list) != MOTOR_IDS:
+            raise ValueError('Read-only commissioning requires exactly YAM motor IDs1-6')
+        self.motor_list = tuple(hw.motor_list)
+        self.directions = np.asarray(hw.directions, float)
+        self.offsets = np.zeros(6) if offsets_rad is None else np.asarray(offsets_rad, float)
+        if self.offsets.shape != (6,) or not np.isfinite(self.offsets).all():
+            raise ValueError('Six explicit finite fixed mapping offsets required')
+        if not np.isfinite(max_manual_speed_rad_s) or not 0 < max_manual_speed_rad_s <= 2:
+            raise ValueError('Manual continuity speed bound must be in (0,2] rad/s')
+        self.max_manual_speed = float(max_manual_speed_rad_s)
+        self.session = uuid.uuid4().hex
+        self.sequence = 0
+        self.reference = None
+        self.previous = None
+        self.continuity_error = None
+        self.interface = interface or DMSingleMotorCanInterface(channel=channel, name='six_axis_read_only')
+        self.survey = {}
+        self.output_reader = output_reader
+        try:
+            for mid, kind in self.motor_list:
+                values = {name: float(register_reader(self.interface, mid, name)) for name in READ_REGISTERS}
+                expected = dict(Gr=MotorType.get_gear_ratio(kind),
+                                PMAX=MotorType.get_motor_constants(kind).POSITION_MAX,
+                                VMAX=MotorType.get_motor_constants(kind).VELOCITY_MAX)
+                if any(not math.isfinite(values[key]) or not math.isclose(values[key], value, rel_tol=1e-4)
+                       for key, value in expected.items()):
+                    raise RuntimeError(f'Motor{mid}: native feedback type/scaling mismatch; no parameters changed')
+                self.survey[str(mid)] = values
+        except Exception:
+            self.interface.close()
+            raise
+
+    def read(self, *, include_motor_position: bool = False) -> dict:
+        try:
+            frames = [asdict(self.interface.read_motor_status(mid, kind, quiet_disabled=True)) for mid, kind in self.motor_list]
+            output = [self.output_reader(self.interface, mid, 'xout') for mid in MOTOR_IDS]
+            motor_position = [self.output_reader(self.interface, mid, 'p_m') for mid in MOTOR_IDS] if include_motor_position else None
+        except Exception:
+            self.invalidate('Status query failed; encoder continuity is unknown')
+            raise
+        now = time.time()
+        if tuple(frame['id'] for frame in frames) != MOTOR_IDS:
+            raise RuntimeError('Incomplete or foreign six-axis encoder response')
+        raw = np.array([sample['value'] for sample in output], float)
+        stamps = np.array([sample['timestamp'] for sample in output], float)
+        status_stamps = np.array([frame['timestamp'] for frame in frames], float)
+        if any(sample['motor_id'] != mid or sample['address'] != 81 for mid, sample in zip(MOTOR_IDS, output, strict=True)):
+            self.invalidate('Foreign output encoder register response')
+            raise RuntimeError(self.continuity_error)
+        velocity = np.array([frame['velocity'] for frame in frames], float)
+        if (not np.isfinite([raw, stamps, status_stamps, velocity]).all() or np.any(now-stamps < -.05)
+                or np.any(now-stamps > MAX_FRAME_AGE_S) or np.any(now-status_stamps > MAX_FRAME_AGE_S)
+                or np.any(now-status_stamps < -.05)):
+            self.invalidate('Stale, invalid or future encoder frame')
+            raise RuntimeError(self.continuity_error)
+        if self.reference is not None and any(str(frame['error_code']).lower() != '0x0' for frame in frames):
+            self.invalidate('Motor no longer clean-disabled; begin a new anchored session')
+        pmax = np.array([self.survey[str(mid)]['PMAX'] for mid in MOTOR_IDS])
+        # PMAX scales the separate packed status/command field, not register81.
+        # Never infer an output-encoder wrap period from PMAX.
+        noise_allowance = np.deg2rad(.1)
+        if self.previous is not None and self.reference is not None:
+            dt = stamps-self.previous['timestamps']
+            delta = raw-self.previous['raw_output_rad']
+            if (np.any(dt <= 0) or np.any(dt > MAX_CONTINUITY_GAP_S)
+                    or np.any(abs(velocity) > self.max_manual_speed)
+                    or np.any(abs(delta) > self.max_manual_speed*dt+noise_allowance)):
+                self.invalidate('Encoder gap, wrap or manual speed ambiguity; start a new anchored session')
+        self.sequence += 1
+        sample = dict(schema='i2rt.six-axis-read-only.v1', session=self.session, sequence=self.sequence,
+                      motor_ids=list(MOTOR_IDS), motor_types=[kind for _, kind in self.motor_list],
+                      raw_protocol_position_u16=[frame.get('position_raw_u16') for frame in frames],
+                      position_source='xout81_output_encoder', raw_output_rad=raw,
+                      native_xout=output, native_p_m=motor_position,
+                      sdk_feedback_position_rad=[frame['position'] for frame in frames],
+                      mapped_joint_rad=(raw-self.offsets)*self.directions,
+                      joint_velocity_rad_s=velocity*self.directions, timestamps=stamps,
+                      physical_timestamp=float(min(stamps.min(), status_stamps.min())),
+                      status_timestamps=status_stamps, status=[frame['error_code'] for frame in frames],
+                      temperatures=dict(mos_c=[frame['temperature_mos'] for frame in frames],
+                                        rotor_c=[frame['temperature_rotor'] for frame in frames]),
+                      disabled=all(str(frame['error_code']).lower() == '0x0' for frame in frames),
+                      mapping=dict(offsets_rad=self.offsets.tolist(), directions=self.directions.tolist(),
+                                   boot_normalization='none', frame='YAM output-encoder model joint axes', units='rad',
+                                   position_source='native read-only xout register81',
+                                   units_provenance='Manufacturer DM-J4310-2EC V1.2 manual p20 notes3/4; installed firmware/branch unqualified',
+                                   units_source='https://cdn.shopify.com/s/files/1/0673/6848/5000/files/DM-J4310-2EC_V1.2_User_Manual_V1.2.pdf?v=1776532217',
+                                   command_coordinate_mapping_qualified=False),
+                      winding=dict(state='invalid' if self.continuity_error else 'anchored-continuous' if self.reference is not None else 'unanchored',
+                                   relative_turns=[0]*6, native_field_span_rad=(2*pmax).tolist(),
+                                   firmware_wrap_period_rad=None, unwrap_policy='none; discontinuities reject',
+                                   absolute_mechanical_winding='unqualified', error=self.continuity_error,
+                                   anchor=self.reference, max_gap_s=MAX_CONTINUITY_GAP_S,
+                                   max_manual_speed_rad_s=self.max_manual_speed),
+                      native_survey=self.survey, motion_enabled=False, commands_allowed=False,
+                      qualification='read-only encoder evidence; not physical readiness or motion approval')
+        self.previous = sample
+        return sample
+
+    def anchor(self, *, reference_id: str, operator_confirmed: bool) -> str:
+        if operator_confirmed is not True or not isinstance(reference_id, str) or not reference_id.strip():
+            raise ValueError('Explicit manual branch/reference identity confirmation required')
+        if self.previous is None or not self.previous['disabled']:
+            raise RuntimeError('Fresh disabled six-axis feedback required before software anchor')
+        if time.time()-self.previous['physical_timestamp'] > MAX_FRAME_AGE_S:
+            raise RuntimeError('Anchor feedback is stale')
+        self.session = uuid.uuid4().hex
+        self.reference = dict(id=reference_id.strip(), raw_output_rad=self.previous['raw_output_rad'].tolist(),
+                              timestamps=self.previous['timestamps'].tolist(), software_only=True)
+        self.continuity_error = None
+        self.sequence = 0
+        return self.session
+
+    def invalidate(self, reason: str) -> None:
+        self.continuity_error = str(reason)
+
+    def close(self) -> None:
+        self.interface.close()  # Socket shutdown only; never motor_off.
diff --git a/i2rt/robots/gripper_motion.py b/i2rt/robots/gripper_motion.py
new file mode 100644
index 0000000..d391bae
--- /dev/null
+++ b/i2rt/robots/gripper_motion.py
@@ -0,0 +1,38 @@
+"""Normalized gripper position reference; contact force stays in the SDK limiter."""
+
+import math
+from dataclasses import dataclass
+
+
+@dataclass
+class GripperRamp:
+    position: float
+    target: float
+    speed: float
+    updated: float
+    paused: bool = False
+
+    def __post_init__(self):
+        if not all(math.isfinite(v) for v in (self.position, self.target, self.speed, self.updated)):
+            raise ValueError("Gripper parameters must be finite")
+        if not 0 <= self.position <= 1 or not 0 <= self.target <= 1 or not 0 < self.speed <= 1:
+            raise ValueError("Gripper positions must be in [0, 1], speed in (0, 1] stroke/s")
+
+    @property
+    def active(self):
+        return not self.paused and abs(self.target - self.position) > 1e-12
+
+    def advance(self, now, *, fresh=True, max_interval=.02):
+        dt = max(0., now - self.updated)
+        self.updated = now
+        if not fresh or self.paused:
+            return self.position
+        if max_interval is not None:
+            dt = min(dt, max_interval)
+        delta = self.target - self.position
+        self.position += math.copysign(min(abs(delta), self.speed * dt), delta)
+        return self.position
+
+    def info(self):
+        return {"active": self.active, "target_normalized": self.target,
+                "reference_normalized": self.position, "speed_stroke_s": self.speed, "paused": self.paused}
diff --git a/i2rt/robots/arm_mode_switch.py b/i2rt/robots/arm_mode_switch.py
new file mode 100644
index 0000000..d3612ef
--- /dev/null
+++ b/i2rt/robots/arm_mode_switch.py
@@ -0,0 +1,192 @@
+"""SDK-owned, powered six-axis mode transitions with measured hold and rollback.
+
+No OFF, ON, error-clear, zero or Flash command is sent. The CAN exchange owner
+serializes register and control messages; every changed axis is seeded immediately.
+"""
+import copy
+import threading
+import time
+
+import numpy as np
+
+from i2rt.motor_config_tool.dm_motor_registers import read_register, write_register
+from i2rt.motor_drivers.dm_driver import MotorCmd
+from i2rt.robots.motor_chain_robot import JointCommands
+
+
+def switch_arm_control_mode(robot, mode):
+    if mode not in ('MIT', 'POS_VEL'):
+        raise ValueError('Arm mode must be MIT or POS_VEL')
+    chain = robot.motor_chain
+    if [mid for mid, _ in chain.motor_list] != list(range(1, 7)):
+        raise RuntimeError('Powered mode switching requires exactly motors 1–6')
+    if robot.get_motion_fault() or not chain.running or chain.enable_auto_recovery:
+        raise RuntimeError('Mode switching requires healthy SDK control without automatic recovery')
+    if not hasattr(robot, '_arm_mode_lock'):
+        robot._arm_mode_lock = threading.Lock()
+    with robot._arm_mode_lock:
+        modes = {mid: ('POS_VEL' if mid in chain.position_speed_motor_ids else 'MIT') for mid, _ in chain.motor_list}
+        if all(value == mode for value in modes.values()):
+            return
+        # Leaving free-drive first becomes MIT measured-pose PD. The CAN thread
+        # continues delivering this hold while the host waits for settling.
+        with robot._command_lock:
+            with robot._state_lock:
+                q = robot._joint_state.pos.copy()
+            hold = JointCommands.init_all_zero(6)
+            hold.pos = robot.remapper.to_robot_joint_pos_space(q)
+            hold.kp, hold.kd = robot._kp.copy(), robot._kd.copy()
+            robot._commands = hold
+            robot._joint_motion = robot._motion_reference = None
+            robot._integral_torque.fill(0)
+            trial = getattr(robot, '_gravity_trial', None)
+            if trial is not None and trial['active']:
+                trial.update(active=False, reason='explicit mode change')
+        deadline = time.monotonic() + 1.5
+        while True:
+            with robot._state_lock:
+                state = copy.deepcopy(robot._joint_state)
+            if not 0 <= time.time()-state.timestamp <= .2:
+                raise RuntimeError('Fresh SDK feedback required for a powered mode switch')
+            if np.max(np.abs(state.vel)) <= .05:
+                break
+            if time.monotonic() >= deadline:
+                raise RuntimeError('Measured-pose hold did not become stationary; mode unchanged')
+            time.sleep(.01)
+        changed = []
+        old_gravity = robot.use_gravity_comp
+        try:
+            robot.pause_control_server(deadline=time.monotonic()+.5)
+            if robot.get_motion_fault():
+                raise RuntimeError('SDK fault appeared while stopping; mode unchanged')
+            with chain._exchange_lock:
+                interface = chain.motor_interface
+                states = [interface.read_motor_status(mid, kind) for mid, kind in chain.motor_list]
+                if any(s.error_code != '0x1' or abs(s.velocity) > .05
+                       or not 0 <= time.time()-s.timestamp <= .2 for s in states):
+                    raise RuntimeError('All six motors must be freshly enabled and stationary')
+                with robot._state_lock:
+                    q = robot._joint_state.pos.copy()
+                    gravity = robot.kdl.compute_gravity(q).copy()
+                gravity *= robot.gravity_comp_factor
+                commands = []
+                for idx, ((mid, kind), state) in enumerate(zip(chain.motor_list, states, strict=True)):
+                    actual = int(read_register(interface, mid, 'CTRL_MODE'))
+                    expected_old = 2 if modes[mid] == 'POS_VEL' else 1
+                    if actual != expected_old:
+                        raise RuntimeError(f'Motor {mid} firmware mode differs from SDK; no transition')
+                    commands.append(MotorCmd(pos=chain._joint_position_real_to_sim_idx(state.position, idx),
+                        vel=robot.position_speed_limit if modes[mid] == 'POS_VEL' else 0.,
+                        kp=0. if modes[mid] == 'POS_VEL' else robot._kp[idx],
+                        kd=0. if modes[mid] == 'POS_VEL' else robot._kd[idx],
+                        torque=0. if modes[mid] == 'POS_VEL' else gravity[idx]))
+                # No more register surveys after the first mode mutation. Keep
+                # each reset-to-zero firmware interval to one write + seed.
+                for idx, ((mid, kind), state) in enumerate(zip(chain.motor_list, states, strict=True)):
+                    if modes[mid] == mode:
+                        continue
+                    changed.append(idx)  # Includes a write whose reply may be lost.
+                    write_register(interface, mid, 'CTRL_MODE', 1 if mode == 'MIT' else 2)
+                    interface.motor_modes[mid] = mode
+                    if mode == 'MIT':
+                        chain.position_speed_motor_ids.discard(mid)
+                    else:
+                        chain.position_speed_motor_ids.add(mid)
+                    cmd = MotorCmd(pos=commands[idx].pos,
+                        vel=robot.position_speed_limit if mode == 'POS_VEL' else 0.,
+                        kp=robot._kp[idx] if mode == 'MIT' else 0.,
+                        kd=robot._kd[idx] if mode == 'MIT' else 0.,
+                        torque=gravity[idx] if mode == 'MIT' else 0.)
+                    commands[idx] = cmd
+                    result = interface.set_control(mid, kind, state.position, cmd.vel,
+                        cmd.kp, cmd.kd, cmd.torque*chain.motor_direction[idx], ignore_error=True)
+                    if result.error_code != '0x1':
+                        raise RuntimeError(f'Motor {mid} did not preserve enabled state on {mode} switch')
+                    if int(read_register(interface, mid, 'CTRL_MODE')) != (1 if mode == 'MIT' else 2):
+                        raise RuntimeError(f'Motor {mid} mode readback failed')
+                    # Refresh all axes between register exchanges, preserving the
+                    # firmware watchdog even on slow hosts. Each uses its own mode.
+                    refreshed = chain._set_commands(commands)
+                    with chain.state_lock:
+                        chain.state = refreshed
+                        chain._update_absolute_positions(refreshed)
+                with chain.command_lock:
+                    chain.commands = commands
+                    chain._command_updated = time.monotonic()
+                # Host feedback must describe the final, freshly refreshed CAN
+                # cycle before clients can start a torque commissioning probe.
+                refreshed_state = robot._motor_state_to_joint_state(chain.read_states())
+                with robot._state_lock:
+                    robot._joint_state = refreshed_state
+                hold.pos = robot.remapper.to_robot_joint_pos_space(refreshed_state.pos)
+                with robot._command_lock:
+                    robot.use_gravity_comp = mode == 'MIT'
+                    robot.mit_arm_joint_indices = tuple(range(6)) if mode == 'MIT' else ()
+                    robot._commands = hold
+                robot._mode_transition = {'ok': True, 'mode': mode, 'timestamp': time.time(),
+                    'power_preserved': True, 'changed_motor_ids': [i+1 for i in changed]}
+        except Exception as exc:
+            rollback_errors = []
+            with chain._exchange_lock:
+                interface = chain.motor_interface
+                for idx in reversed(changed):
+                    mid, kind = chain.motor_list[idx]
+                    try:
+                        prior = modes[mid]
+                        write_register(interface, mid, 'CTRL_MODE', 1 if prior == 'MIT' else 2)
+                        interface.motor_modes[mid] = prior
+                        if prior == 'MIT':
+                            chain.position_speed_motor_ids.discard(mid)
+                        else:
+                            chain.position_speed_motor_ids.add(mid)
+                        result = interface.set_control(mid, kind, states[idx].position,
+                            robot.position_speed_limit if prior == 'POS_VEL' else 0.,
+                            robot._kp[idx] if prior == 'MIT' else 0.,
+                            robot._kd[idx] if prior == 'MIT' else 0.,
+                            gravity[idx]*chain.motor_direction[idx] if prior == 'MIT' else 0., ignore_error=True)
+                        if result.error_code != '0x1':
+                            raise RuntimeError('Enabled-state rollback could not be verified')
+                        if int(read_register(interface, mid, 'CTRL_MODE')) != (1 if prior == 'MIT' else 2):
+                            raise RuntimeError('Restored mode readback failed')
+                    except Exception as rollback:
+                        rollback_errors.append(f'J{mid}: {rollback}')
+                        # A lost write reply does not prove that RAM stayed in
+                        # the target mode. Resurvey and seed the actual protocol
+                        # before publishing any replacement chain commands.
+                        try:
+                            actual = int(read_register(interface, mid, 'CTRL_MODE'))
+                            if actual not in (1, 2):
+                                raise RuntimeError(f'Unexpected firmware mode {actual}')
+                            retained = 'MIT' if actual == 1 else 'POS_VEL'
+                            interface.motor_modes[mid] = retained
+                            if retained == 'MIT':
+                                chain.position_speed_motor_ids.discard(mid)
+                            else:
+                                chain.position_speed_motor_ids.add(mid)
+                            result = interface.set_control(mid, kind, states[idx].position,
+                                0. if retained == 'MIT' else robot.position_speed_limit,
+                                robot._kp[idx] if retained == 'MIT' else 0.,
+                                robot._kd[idx] if retained == 'MIT' else 0.,
+                                gravity[idx]*chain.motor_direction[idx] if retained == 'MIT' else 0., ignore_error=True)
+                            if result.error_code != '0x1':
+                                raise RuntimeError('Retained mode hold not verified enabled')
+                        except Exception as resurvey:
+                            rollback_errors.append(f'J{mid} retained mode unverified: {resurvey}')
+                robot.use_gravity_comp = old_gravity or bool(set(range(1, 7))-chain.position_speed_motor_ids)
+                robot.mit_arm_joint_indices = tuple(i for i in range(6) if i+1 not in chain.position_speed_motor_ids)
+                if changed:
+                    restored = []
+                    for idx, (mid, _) in enumerate(chain.motor_list):
+                        mit = mid not in chain.position_speed_motor_ids
+                        restored.append(MotorCmd(pos=chain._joint_position_real_to_sim_idx(states[idx].position, idx),
+                            vel=0. if mit else robot.position_speed_limit,
+                            kp=robot._kp[idx] if mit else 0., kd=robot._kd[idx] if mit else 0.,
+                            torque=gravity[idx] if mit else 0.))
+                    with chain.command_lock:
+                        chain.commands = restored
+                        chain._command_updated = time.monotonic()
+            robot._mode_transition = {'ok': False, 'requested_mode': mode, 'timestamp': time.time(),
+                'error': str(exc), 'rollback_errors': rollback_errors}
+            raise RuntimeError(f'Mode transition failed; retaining measured hold: {exc}; rollback={rollback_errors}') from exc
+        finally:
+            robot.resume_control_server()
diff --git a/i2rt/robots/payload_gravity.py b/i2rt/robots/payload_gravity.py
new file mode 100644
index 0000000..8136a11
--- /dev/null
+++ b/i2rt/robots/payload_gravity.py
@@ -0,0 +1,40 @@
+"""Static installed-payload configuration on an existing SDK model."""
+import time
+
+import mujoco
+import numpy as np
+
+
+def configure_payload(robot, mass_kg, com_flange_m):
+    mass, com = float(mass_kg), np.asarray(com_flange_m, float)
+    if not np.isfinite(mass) or not .005 <= mass <= 3 or com.shape != (3,) or not np.isfinite(com).all() or np.linalg.norm(com) > .25:
+        raise ValueError('Payload requires mass 0.005–3 kg and finite flange COM within 0.25 m')
+    if robot.get_motion_fault():
+        raise RuntimeError('Acknowledge SDK fault before changing payload')
+    obs = robot.get_observations()
+    if np.max(np.abs(obs['joint_vel'][:6])) > .05:
+        raise RuntimeError('Payload configuration requires a stationary robot')
+    model = robot.kdl.model if hasattr(robot, 'kdl') else robot._model
+    body = mujoco.mj_name2id(model, mujoco.mjtObj.mjOBJ_BODY, 'gripper')
+    if body < 0:
+        raise ValueError('Installed wrist flange body missing')
+    # Static fitting identifies no rotational inertia. Use an explicit conservative
+    # isotropic nominal tensor rather than claiming a measured dynamic model.
+    inertia = np.full(3, mass * .06**2 / 6)
+    paused = hasattr(robot, 'pause_control_server')
+    if paused:
+        robot.pause_control_server(deadline=time.monotonic()+.5)
+    try:
+        model.body_mass[body] = mass
+        model.body_ipos[body] = com
+        model.body_iquat[body] = [1., 0., 0., 0.]
+        model.body_inertia[body] = inertia
+        data = mujoco.MjData(model)
+        mujoco.mj_setConst(model, data)
+        robot._linear_gravity = None
+        robot._installed_payload = {'mass_kg': mass, 'com_flange_m': com.tolist(),
+            'diaginertia_kg_m2': inertia.tolist(), 'inertia_provenance': 'nominal isotropic; static fit does not identify inertia'}
+        return dict(robot._installed_payload)
+    finally:
+        if paused:
+            robot.resume_control_server()
diff --git a/i2rt/motor_drivers/mit_command.py b/i2rt/motor_drivers/mit_command.py
new file mode 100644
index 0000000..92ba0bc
--- /dev/null
+++ b/i2rt/motor_drivers/mit_command.py
@@ -0,0 +1,36 @@
+"""MIT command quantization compensation; native motor P/D still close the loop."""
+
+import math
+
+from i2rt.motor_drivers.utils import float_to_uint, uint_to_float
+
+
+def mit_codes(pos, vel, kp, kd, torque, const, *, compensate=False):
+    """Return five wire codes. Legacy encoding is preserved unless explicitly enabled.
+
+    With compensation, the torque field supplies the residual reference torque
+    lost to position/velocity quantization. This is algebraically the same motor
+    PD law, not an extra feedback controller. No dither or gain increase is used.
+    Residuals use the encoded gains; gain quantization is not compensated with
+    delayed host feedback. Saturation always wins over compensation.
+    """
+    fields = [(pos, const.POSITION_MIN, const.POSITION_MAX, 16),
+              (vel, const.VELOCITY_MIN, const.VELOCITY_MAX, 12),
+              (kp, const.KP_MIN, const.KP_MAX, 12),
+              (kd, const.KD_MIN, const.KD_MAX, 12)]
+    if not all(math.isfinite(float(x)) for x in (pos, vel, kp, kd, torque)):
+        raise ValueError("MIT commands must be finite")
+    if not compensate:
+        return tuple(float_to_uint(*f) for f in fields) + (
+            float_to_uint(torque, const.TORQUE_MIN, const.TORQUE_MAX, 12),)
+
+    def nearest(value, lo, hi, bits):
+        return int(math.floor((min(hi, max(lo, value))-lo) * ((1 << bits)-1) / (hi-lo) + .5))
+
+    codes = tuple(nearest(*f) for f in fields)
+    p, v, p_gain, d_gain = [uint_to_float(c, *f[1:]) for c, f in zip(codes, fields)]
+    bounded_pos = min(const.POSITION_MAX, max(const.POSITION_MIN, pos))
+    bounded_vel = min(const.VELOCITY_MAX, max(const.VELOCITY_MIN, vel))
+    torque = min(const.TORQUE_MAX, max(const.TORQUE_MIN, torque))
+    torque += p_gain * (bounded_pos-p) + d_gain * (bounded_vel-v)
+    return codes + (nearest(torque, const.TORQUE_MIN, const.TORQUE_MAX, 12),)
diff --git a/i2rt/motor_drivers/position_speed.py b/i2rt/motor_drivers/position_speed.py
new file mode 100644
index 0000000..2b11147
--- /dev/null
+++ b/i2rt/motor_drivers/position_speed.py
@@ -0,0 +1,92 @@
+"""Disabled-only position-speed commissioning through the SDK; no Flash writes."""
+
+import math
+
+from i2rt.motor_config_tool.dm_motor_registers import read_register, write_register
+from i2rt.motor_drivers.utils import MotorType
+
+SURVEY_REGISTERS = ("CTRL_MODE", "Gr", "PMAX", "VMAX", "TMAX", "OT_Value", "ACC", "DEC",
+                    "MAX_SPD", "TIMEOUT", "Damp", "KP_ASR", "KI_ASR", "KP_APR", "KI_APR")
+
+
+def prepare_modes(channel, motor_list, modes, *, allow_timeout_recovery=True, write_modes=True, require_selected=True):
+    """Survey ALL motors before changing ANY mode. Fail disabled on partial transitions.
+
+    Existing onboard gains and acceleration/deceleration are only read, never tuned.
+    A successful RAM read-back is necessary, but the first seeded control exchange
+    must still succeed: older firmware may require a power cycle.
+    """
+    from i2rt.motor_drivers.dm_driver import DMSingleMotorCanInterface
+
+    if set(modes) != {i for i, _ in motor_list} or any(m not in ("MIT", "POS_VEL") for m in modes.values()):
+        raise ValueError("Explicit MIT/POS_VEL mode required for every motor")
+    interface = DMSingleMotorCanInterface(channel=channel, name="position_speed_setup")
+    survey = {}
+    try:
+        for motor_id, motor_type in motor_list:
+            state = interface.read_motor_status(motor_id, motor_type)
+            # 0xD is the disabled comm-timeout latch left by the old SDK close.
+            # All other faults and any enabled motor refuse the transition.
+            if state.error_code not in (("0x0", "0xd") if allow_timeout_recovery else ("0x0",)) or abs(state.velocity) > .05:
+                raise RuntimeError(f"Motor {motor_id}: mode transition requires disabled, stationary feedback")
+            values = {reg: read_register(interface, motor_id, reg) for reg in SURVEY_REGISTERS}
+            survey[motor_id] = values
+            values["status_before"] = state.error_code
+            if not math.isfinite(values['OT_Value']) or values['OT_Value'] <= 15:
+                raise RuntimeError(f"Motor {motor_id}: invalid temperature protection threshold")
+            const = MotorType.get_motor_constants(motor_type)
+            for reg, expected in (("PMAX", const.POSITION_MAX), ("VMAX", const.VELOCITY_MAX), ("TMAX", const.TORQUE_MAX)):
+                if not math.isclose(values[reg], expected, rel_tol=1e-4):
+                    raise RuntimeError(f"Motor {motor_id}: {reg}={values[reg]} differs from SDK {expected}")
+            if modes[motor_id] == "POS_VEL":
+                for reg in ("ACC", "MAX_SPD", "Damp", "KP_ASR", "KP_APR"):
+                    if not math.isfinite(values[reg]) or values[reg] <= 0:
+                        raise RuntimeError(f"Motor {motor_id}: position-speed needs positive {reg}; got {values[reg]}")
+                if not math.isfinite(values["DEC"]) or values["DEC"] == 0:
+                    raise RuntimeError(f"Motor {motor_id}: missing deceleration setting")
+                if values["TIMEOUT"] <= 0:
+                    raise RuntimeError(f"Motor {motor_id}: position-speed needs an enabled firmware watchdog")
+        # Finish the old SDK's timeout shutdown explicitly, with no enable frame.
+        for motor_id, motor_type in motor_list:
+            if survey[motor_id]["status_before"] == "0xd":
+                interface.motor_modes = {motor_id: "POS_VEL" if survey[motor_id]["CTRL_MODE"] == 2 else "MIT"}
+                interface.motor_off(motor_id)
+                interface.clean_error(motor_id)
+                if interface.read_motor_status(motor_id, motor_type).error_code != "0x0":
+                    raise RuntimeError(f"Motor {motor_id}: timeout latch did not clear while disabled")
+        for motor_id, _ in motor_list:
+            expected = 2 if modes[motor_id] == "POS_VEL" else 1
+            if survey[motor_id]["CTRL_MODE"] != expected and not write_modes and require_selected:
+                raise RuntimeError(f"Motor {motor_id}: selected mode differs; explicit disabled mode transition required")
+            if survey[motor_id]["CTRL_MODE"] != expected and write_modes:
+                write_register(interface, motor_id, "CTRL_MODE", expected)
+            actual = read_register(interface, motor_id, "CTRL_MODE")
+            if actual != expected and require_selected:
+                raise RuntimeError(f"Motor {motor_id}: mode read-back {actual}, expected {expected}; left disabled")
+            survey[motor_id]["selected_mode"] = actual
+        return survey
+    finally:
+        interface.close()
+
+
+def commit_prepared_modes(interface, motor_list, modes, *, deadline, disabled_samples):
+    """Explicit Enable phase: verify fresh disabled proof, change RAM mode only."""
+    import time
+    if len(disabled_samples) != len(motor_list) or any(
+            row['status'] != '0x0' or not 0 <= time.time()-row['timestamp'] <= .5 for row in disabled_samples):
+        raise RuntimeError('Fresh clean-disabled proof required before explicit mode commit')
+    def check():
+        if time.monotonic() > deadline:
+            raise TimeoutError('Original Enable intent expired before mode/enable commit')
+    for motor_id, _ in motor_list:
+        check()
+        expected = 2 if modes[motor_id] == 'POS_VEL' else 1
+        current = read_register(interface, motor_id, 'CTRL_MODE')
+        check()
+        if current != expected:
+            write_register(interface, motor_id, 'CTRL_MODE', expected)
+            check()
+            if read_register(interface, motor_id, 'CTRL_MODE') != expected:
+                raise RuntimeError(f'Motor {motor_id}: explicit RAM mode readback failed; no enable')
+    check()
+    interface.motor_modes = dict(modes)
diff --git a/i2rt/robots/position_speed_robot.py b/i2rt/robots/position_speed_robot.py
new file mode 100644
index 0000000..50c42b8
--- /dev/null
+++ b/i2rt/robots/position_speed_robot.py
@@ -0,0 +1,193 @@
+"""YAM position/speed cascades with powered six-axis MIT gravity switching.
+
+The firmware speed field is a positive ceiling, NOT signed velocity feedforward.
+All existing path, oscillation and execution-watchdog logic runs in the base SDK.
+"""
+
+import time
+
+import numpy as np
+from i2rt.robots.motor_chain_robot import MotorChainRobot
+
+
+class PositionSpeedRobot(MotorChainRobot):
+    def settle_measured_hold(self, timeout_s=3., window_s=.25):
+        """Wait for position-stable MIT PD, accounting for p16 velocity noise."""
+        deadline = time.monotonic()+timeout_s
+        samples = []
+        while True:
+            if self.get_motion_fault() or not self.motor_chain.running:
+                raise RuntimeError('Healthy SDK measured hold required before gravity entry')
+            with self._state_lock:
+                state = self._joint_state
+                q, v, stamp = state.pos.copy(), state.vel.copy(), state.timestamp
+            if not 0 <= time.time()-stamp <= .1:
+                samples.clear()
+            elif not samples or stamp != samples[-1][0]:
+                samples.append((stamp, time.monotonic(), q, v))
+                samples = [s for s in samples if time.monotonic()-s[1] <= window_s+.05]
+            if len(samples) >= 4 and samples[-1][1]-samples[0][1] >= window_s:
+                positions = np.array([s[2] for s in samples])
+                velocities = np.array([s[3] for s in samples])
+                if (np.max(np.ptp(positions, axis=0)) <= .0015
+                        and np.max(np.abs(positions[-1]-positions[0])) <= .0008
+                        and np.max(np.abs(np.mean(velocities, axis=0))) <= .015):
+                    return
+            if time.monotonic() >= deadline:
+                raise RuntimeError('MIT measured hold did not settle; gravity remains in powered PD hold')
+            time.sleep(.01)
+
+    def prepare_gravity_profile(self, factors, *, model='sdk', reference=None):
+        """Cache first-MIT-frame feedforward while POS_VEL remains torque-free."""
+        return self.configure_gravity(factors, model=model, reference=reference)
+
+    def get_arm_control_modes(self):
+        return ['MIT' if i in self._mit_indices() else 'POS_VEL' for i in range(6)]
+
+    def start_gravity_trial(self, duration_s=.5, max_excursion_rad=.04, max_speed_rad_s=.3):
+        """Bounded hands-off commissioning probe; expiry restores powered MIT PD."""
+        if not .05 <= duration_s <= 2 or not 0 < max_excursion_rad <= .1 or not 0 < max_speed_rad_s <= .5:
+            raise ValueError('Invalid bounded gravity trial limits')
+        if self.get_motion_fault() or len(self._mit_indices()) != 6:
+            raise RuntimeError('Gravity trial requires healthy six-axis MIT mode')
+        with self._state_lock:
+            q = self._joint_state.pos.copy()
+        self.enter_gravity_comp_idle()
+        with self._command_lock:
+            self._gravity_trial = {'active': True, 'start_q': q.tolist(), 'started': time.monotonic(),
+                'duration_s': duration_s, 'max_excursion_rad': max_excursion_rad,
+                'max_speed_rad_s': max_speed_rad_s, 'peak_excursion_rad': 0., 'peak_speed_rad_s': 0.,
+                'peak_excursion_by_joint_rad': [0.]*6, 'peak_speed_by_joint_rad_s': [0.]*6}
+
+    def update(self):
+        with self._command_lock:
+            trial = getattr(self, '_gravity_trial', None)
+            if trial is not None and trial['active']:
+                with self._state_lock:
+                    state = self._joint_state
+                    q, v, stamp = state.pos.copy(), state.vel.copy(), state.timestamp
+                delta = float(np.max(np.abs(q-np.asarray(trial['start_q']))))
+                speed = float(np.max(np.abs(v)))
+                trial['peak_excursion_rad'] = max(delta, trial['peak_excursion_rad'])
+                trial['peak_speed_rad_s'] = max(speed, trial['peak_speed_rad_s'])
+                trial['peak_excursion_by_joint_rad'] = np.maximum(
+                    trial['peak_excursion_by_joint_rad'], np.abs(q-np.asarray(trial['start_q']))).tolist()
+                trial['peak_speed_by_joint_rad_s'] = np.maximum(
+                    trial['peak_speed_by_joint_rad_s'], np.abs(v)).tolist()
+                elapsed = time.monotonic()-trial['started']
+                reason = ('stale feedback' if time.time()-stamp > .2 else
+                          'excursion limit' if delta >= trial['max_excursion_rad'] else
+                          'speed limit' if speed >= trial['max_speed_rad_s'] else
+                          'duration complete' if elapsed >= trial['duration_s'] else None)
+                if reason:
+                    from i2rt.robots.motor_chain_robot import JointCommands
+                    hold = JointCommands.init_all_zero(6)
+                    hold.pos = self.remapper.to_robot_joint_pos_space(q)
+                    hold.kp, hold.kd = self._kp.copy(), self._kd.copy()
+                    self._commands = hold
+                    self._joint_motion = self._motion_reference = None
+                    trial.update(active=False, reason=reason, elapsed_s=elapsed, final_q=q.tolist(),
+                                 response='Powered MIT PD hold at measured pose')
+        return super().update()
+
+    def switch_arm_control_mode(self, mode):
+        from i2rt.robots.arm_mode_switch import switch_arm_control_mode
+        return switch_arm_control_mode(self, mode)
+
+    def configure_payload(self, mass_kg, com_flange_m):
+        from i2rt.robots.payload_gravity import configure_payload
+        return configure_payload(self, mass_kg, com_flange_m)
+
+    def _mit_indices(self):
+        if hasattr(self.motor_chain, 'position_speed_motor_ids'):
+            n = self._gripper_index if self._gripper_index is not None else len(self.motor_chain)
+            return tuple(i for i, (mid, _) in enumerate(self.motor_chain.motor_list[:n])
+                         if mid not in self.motor_chain.position_speed_motor_ids)
+        return getattr(self, 'mit_arm_joint_indices', ())
+
+    def __init__(self, *args, mit_arm_joint_indices=(), **kwargs):
+        if tuple(mit_arm_joint_indices) not in ((), (3, 4)):
+            raise ValueError('Supported mixed arm configuration is J4/J5 MIT only')
+        self.mit_arm_joint_indices = tuple(mit_arm_joint_indices)
+        self.position_speed_limit = .15  # Conservative initial per-joint ceiling, rad/s.
+        kwargs.update(use_gravity_comp=bool(self.mit_arm_joint_indices),
+                      use_coulomb_friction=False, zero_gravity_mode=False)
+        super().__init__(*args, **kwargs)
+
+    def configure_position_speed_limit(self, limit):
+        if not np.isfinite(limit) or not 0 < limit <= 3.:
+            raise ValueError("Position-speed commissioning ceiling must be in (0, 3] rad/s")
+        with self._command_lock:
+            self.position_speed_limit = float(limit)
+
+    def _update_joint_state(self, motor_torques, joint_commands, encoder_infos=None):
+        n = self._gripper_index if self._gripper_index is not None else len(self.motor_chain)
+        mit = self._mit_indices()
+        pos_indices = np.array([j for j in range(n) if j not in mit], dtype=int)
+        # POS_VEL joints use only checked position and a positive speed ceiling.
+        # MIT joints retain native PD, signed planned velocity and gravity torque.
+        motor_torques = motor_torques.copy()
+        motor_torques[pos_indices] = 0.
+        joint_commands.kp[pos_indices] = 0.
+        joint_commands.kd[pos_indices] = 0.
+        joint_commands.vel[pos_indices] = self.position_speed_limit
+        joint_commands.compensate_quantization = False
+        if self._torque_terms is not None and len(mit) == n:
+            self._torque_terms.update(controller='MIT', onboard_loop_terms_available=True,
+                                     host_terms_valid_arm_joints=list(range(1, n+1)))
+        elif self._torque_terms is not None and mit:
+            terms = self._torque_terms.copy()
+            for key in ('gravity_nm', 'gravity_load_nm', 'friction_nm', 'p_estimate_nm',
+                        'd_estimate_nm', 'i_nm', 'command_nm', 'feedforward_sent_nm', 'total_estimate_nm'):
+                if key in terms:
+                    terms[key] = np.asarray(terms[key]).copy()
+                    terms[key][pos_indices] = 0.
+            terms.update(controller='MIXED_J45', onboard_loop_terms_available=False,
+                         host_terms_valid_arm_joints=[j+1 for j in mit],
+                         gravity_enabled=self.use_gravity_comp, friction_enabled=False,
+                         speed_limit_rad_s=[None if j in mit else self.position_speed_limit for j in range(n)])
+            self._torque_terms = terms
+        elif self._torque_terms is not None:
+            self._torque_terms = {"timestamp": self._joint_state.timestamp,
+                "controller": "POS_VEL", "onboard_loop_terms_available": False,
+                "gravity_enabled": False, "friction_enabled": False,
+                "motor_reported_nm": self._joint_state.eff.copy(),
+                "speed_limit_rad_s": [self.position_speed_limit]*n}
+        self._last_motor_torques = motor_torques.copy()
+        if self._motion_fault is not None:
+            self._motion_fault["response"] = ("Latched MIT PD hold at measured pose" if len(mit) == n else
+                "Latched mixed-mode hold at measured pose (factory MIT PD)" if mit else
+                "Latched position-speed hold at measured pose")
+        return super()._update_joint_state(motor_torques, joint_commands, encoder_infos)
+
+    def command_joint_pos_pid(self, joint_pos, ki, integral_limit, **kwargs):
+        if np.any(np.asarray(ki) != 0) and len(self._mit_indices()) != len(self.motor_chain):
+            raise ValueError("Position-speed has no host integral torque input")
+        return super().command_joint_pos_pid(joint_pos, ki, integral_limit, **kwargs)
+
+    def configure_gravity(self, factors, *, model="sdk", reference=None):
+        result = super().configure_gravity(factors, model=model, reference=reference)
+        self.use_gravity_comp = bool(self._mit_indices())
+        return result
+
+    def get_gravity_info(self):
+        info = super().get_gravity_info()
+        info['active_arm_joints'] = ([j+1 for j in self._mit_indices()]
+                                     if self.use_gravity_comp else [])
+        return info
+
+    def configure_friction(self, *, enabled=True, **kwargs):
+        if enabled:
+            raise RuntimeError("Position-speed has no friction torque feedforward")
+        self.use_coulomb_friction = False
+
+    def configure_command_quantization(self, enabled):
+        if enabled:
+            raise RuntimeError("MIT command compensation does not apply to float32 position-speed")
+
+    def enter_gravity_comp_idle(self):
+        if len(self._mit_indices()) != 6 or len(self.motor_chain) != 6:
+            raise RuntimeError("Gravity mode requires six arm motors in MIT torque mode")
+        with self._command_lock:
+            self._joint_motion = self._motion_reference = None
+        return super().enter_gravity_comp_idle()
