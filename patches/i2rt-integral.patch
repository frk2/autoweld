@@ -0,0 +1,12 @@
+"""SDK Coulomb compensation with an optional continuous zero-speed transition."""
+import numpy as np
+
+
+def friction_torque(velocity, coefficients, transition_rad_s):
+    velocity = np.asarray(velocity, dtype=float)
+    width = np.asarray(transition_rad_s, dtype=float)
+    # Width zero preserves the SDK's original sign rule exactly.
+    scale = np.sign(velocity)
+    smooth = width > 0
+    scale[smooth] = np.tanh(velocity[smooth] / width[smooth])
+    return np.asarray(coefficients) * scale
