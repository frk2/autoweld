+              | (np.abs(np.diff(uv[:, perpendicular])) > noise.max_jump_px))
+    labels = np.r_[0, np.cumsum(breaks)]
+    sizes = np.bincount(labels)
+    return sizes[labels] >= noise.min_run_points
 
 
