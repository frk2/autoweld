+"""ROI measurements retain full measured native context and calibrated projection."""
+from copy import deepcopy
+from dataclasses import asdict
+import hashlib
+import json
+
+import numpy as np
+import pytest
+
+from weldfinder.calibration import Calibration
+from weldfinder.config import Board, Detection
+from weldfinder.geometry import project_camera_points
+from weldfinder.pipeline import _native_laser_cloud
+from weldfinder.pointcloud import PointCloudNoise
+
+
+def calibration():
+    return Calibration('fixture:context', [320, 240], [[500.,0,160.],[0,500.,120.],[0,0,1.]],
+        [0.]*5,.1,asdict(Board(5,7,4.)),laser_plane=[0.,0.,1.,-150.])
+
+
+def packet(roi):
+    frame=np.full((240,320),10,np.uint8)
+    frame[118:123,10:310]=180
+    return dict(frame=frame,pointcloud_detection=Detection(threshold=30,min_width=2,roi=roi),
+        calibration=calibration(),source_id='fixture:context',pointcloud_depth_mm=(1.,2000.),
+        pointcloud_noise=PointCloudNoise(enabled=True,min_run_points=12),sequence=22,generation=4,
+        acquisition_session_id='one-measured-session',timing={'camera_frame_id':7722,'exposure_host_mid_s':1.0005},
+        read_started=1.,received=1.001,controls={'exposure_us':1000.,'gain_db':0.},calibration_id='exact:model')
+
+
+def test_roi_cloud_keeps_full_context_from_same_uncopied_frame_and_identity(monkeypatch):
+    import weldfinder.pipeline as module
+    before=packet([.3,.1,.7,.9]); original=before['frame'].copy();calls=[]
+    native=module.find_laser_point_cloud
+    def measured(frame,*args,**kwargs):
+        calls.append(id(frame))
+        return native(frame,*args,**kwargs)
+    monkeypatch.setattr(module,'find_laser_point_cloud',measured)
+    cloud=_native_laser_cloud(before).to_dict();full=cloud['full_profile']
+    assert cloud['count']==128 and full['count']==300
+    assert np.min(full['uv'],axis=0)[0]==10 and np.max(full['uv'],axis=0)[0]==309
+    assert np.min(cloud['uv'],axis=0)[0]==96 and np.max(cloud['uv'],axis=0)[0]==223
+    assert calls==[id(before['frame'])]*2
+    for key in ('source_id','sequence','generation','acquisition_session_id','calibration_id',
+                'optical_intrinsics_id','read_started','received','controls','timing','units','coordinate_frame'):
+        assert cloud[key]==full[key],key
+    assert full['role']=='full_native_profile_context' and full['not_seam_measurement']
+    assert full['measurement_roi']==[.3,.1,.7,.9] and 'full_profile' not in full
+    np.testing.assert_array_equal(before['frame'],original)
+    assert before['pointcloud_detection'].roi==[.3,.1,.7,.9]
+
+
+def test_fullframe_measurement_does_not_add_a_second_measurement_pass(monkeypatch):
+    import weldfinder.pipeline as module
+    native=module.find_laser_point_cloud;calls=[]
+    def measured(*args,**kwargs):
+        calls.append(1)
+        return native(*args,**kwargs)
+    monkeypatch.setattr(module,'find_laser_point_cloud',measured)
+    cloud=_native_laser_cloud(packet([0,0,1,1])).to_dict()
+    assert 'full_profile' not in cloud and calls==[1] and cloud['count']==300
+
+
+def test_projection_uses_matching_optics_returns_unclipped_pixels_and_explicit_prediction():
+    model=calibration();before=deepcopy(model.to_dict())
+    result=project_camera_points([[0.,0.,150.],[200.,0.,150.]],model,model.source_id,model.image_size)
+    assert result['uv'][0]==[160.,120.] and result['uv'][1][0]>320
+    assert result['inside_image']==[True,False]
+    assert result['projection_only'] and not result['measured']
+    assert result['units']=='px' and result['coordinate_frame']=='camera_image'
+    assert result['calibration_id']==hashlib.sha256(json.dumps(before,sort_keys=True,separators=(',',':'),allow_nan=False).encode()).hexdigest()
+    assert model.to_dict()==before
+    with pytest.raises(ValueError,match='camera'):
+        project_camera_points([[0,0,150]],model,'wrong:source',model.image_size)
+
+
+@pytest.mark.parametrize('points', [[[0.,0.,-1.]],[[float('nan'),0.,150.]], [0.,0.,150.]])
+def test_projection_does_not_invent_behind_or_nonfinite_pixels(points):
+    model=calibration()
+    with pytest.raises(ValueError):project_camera_points(points,model,model.source_id,model.image_size)
