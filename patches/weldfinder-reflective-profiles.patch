+def _run_mask(uv, scan, axis, noise):
+    """Remove short measured runs after local pruning, retaining every long run.
+
+    A first-pass neighbor gate can leave an orphan when its own supporting
+    points were rejected. This optional pass rejects that residual island;
+    neither coordinates nor sharp discontinuities are smoothed or bridged.
