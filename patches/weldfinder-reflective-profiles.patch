+        valid_limits = (isinstance(gain_limits, (tuple, list)) and len(gain_limits) == 2
+            and all(isinstance(v, (int, float)) and not isinstance(v, bool) and math.isfinite(v)
+                    for v in gain_limits) and gain_limits[0] <= gain_limits[1])
+        if not valid_gain or not valid_limits or not gain_limits[0] <= gain <= gain_limits[1]:
+            self.status.update(gain_state='unavailable', gain_message='Measured gain or sensor limits unavailable')
+            return result
+        low_gain, high_gain = max(config.min_gain_db, gain_limits[0]), min(config.max_gain_db, gain_limits[1])
+        self.status.update(gain_db=float(gain), gain_bounds_db=[low_gain, high_gain],
+            gain_policy='exposure_before_gain', gain_state='holding')
+        if low_gain > high_gain:
+            self.status.update(gain_state='limits', gain_message='Requested gain bounds conflict with sensor limits')
+            return result
+        low = max(config.min_us, exposure_limits[0])
+        high = min(config.max_us, exposure_limits[1], 800000/fps)
+        if low > high or self.sampled_at is None:
+            return result
+        reliable = self.status.get('reliable') is True
+        saturation = self.status.get('saturated_fraction')
