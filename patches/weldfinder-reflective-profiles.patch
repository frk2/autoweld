+"""One cached raw exposure and its own cloud; never a second camera owner."""
+import base64
+import hashlib
+import time
+from types import SimpleNamespace
+
+import cv2
+import numpy as np
+import pytest
+
+from weldfinder.calibration_camera import CalibrationCamera
+from weldfinder.pointcloud import PointCloud
+
+
+@pytest.fixture
+def owner(tmp_path):
+    def forbidden(*_args):
+        raise AssertionError('Snapshot must not acquire or open hardware')
+    camera = CalibrationCamera(tmp_path, factory=forbidden)
+    pipeline = camera.pipeline
+    camera.enabled = pipeline.connected = True
+    pipeline.camera = SimpleNamespace(source_id='fixture:snapshot')
+    pipeline.generation = 7
+    pipeline.calibration_id = 'fixture:calibration'
+    identity = dict(source_id='fixture:snapshot', generation=7, sequence=12,
+        acquisition_session_id=pipeline.frame_timing.session_id, calibration_id=pipeline.calibration_id)
+    now = time.monotonic()
+    cloud = PointCloud(np.array([[1., 2., 150.]]), np.array([[2., 1.]]), np.array([120.]),
+                       np.array([2.]), dict(identity, read_started=now))
+    pipeline.observation = dict(identity, read_started=now, received=now+.001,
+        frame=np.arange(24, dtype=np.uint8).reshape(4, 6),
+        controls={'exposure_us': 1000., 'gain_db': 0.}, controls_settled=True,
+        timing={'exposure_host_start_s': now, 'exposure_host_end_s': now+.001},
+        accepted_laser_cloud=cloud, accepted_laser_error=None,
+        laser_measurement_settings={'detection': {'threshold': 30.}})
+    pipeline.pointcloud = PointCloud(np.ones((2, 3)), np.ones((2, 2)), np.ones(2), np.ones(2),
+        dict(identity, sequence=13, read_started=now))
+    yield camera
+    # No worker was opened; avoid invoking hardware cleanup on our fake handle.
+    pipeline.camera = None
+    camera.enabled = pipeline.connected = False
+    camera.close()
+
+
+def test_lossless_native_pixels_and_exact_exposure_cloud_are_detached(owner):
+    obs = owner.pipeline.observation
+    result = owner.native_laser_snapshot()
+    png = base64.b64decode(result['frame_png_base64'])
+    decoded = cv2.imdecode(np.frombuffer(png, np.uint8), cv2.IMREAD_UNCHANGED)
+    np.testing.assert_array_equal(decoded, obs['frame'])
+    assert result['image']['sha256'] == hashlib.sha256(png).hexdigest()
+    assert result['image']['native_pixels_sha256'] == hashlib.sha256(decoded.tobytes()).hexdigest()
+    assert not result['image']['annotated'] and not result['image']['scaled'] and not result['image']['tone_mapped']
+    assert result['cloud']['sequence'] == result['metadata']['sequence'] == 12
+    assert len(result['cloud']['xyz_mm']) == 1  # Newer independently published cloud has two.
+    assert result['image']['image_size'] == [6, 4]
+    assert result['metadata']['controls_settled']
+    assert owner.pipeline.thread is None and owner.pipeline.analysis_thread is None
+    result['cloud']['xyz_mm'][0][0] = 1000.
+    result['metadata']['controls']['gain_db'] = 20.
+    assert obs['accepted_laser_cloud'].xyz_mm[0, 0] == 1.
+    assert obs['controls']['gain_db'] == 0.
+
+
+@pytest.mark.parametrize('change,error', [
+    ({'read_started': -10.}, 'fresh'),
+    ({'generation': 8}, 'identity'),
+    ({'acquisition_session_id': 'different'}, 'identity'),
+])
+def test_stale_or_other_identity_is_never_exported(owner, change, error):
+    owner.pipeline.observation.update(change)
+    with pytest.raises(ValueError, match=error):
+        owner.native_laser_snapshot()
+
+
+def test_cutoff_rejects_precapture_but_missing_cloud_still_keeps_actual_failure_image(owner):
+    start = owner.pipeline.observation['read_started']
+    with pytest.raises(ValueError, match='cutoff'):
+        owner.native_laser_snapshot(not_before_monotonic=start+.1)
+    owner.pipeline.observation.update(accepted_laser_cloud=None, accepted_laser_error='No laser plane')
+    result = owner.native_laser_snapshot()
+    assert result['cloud'] is None and result['cloud_error'] == 'No laser plane'
+    assert result['frame_png_base64']
+    assert result['diagnostic_only'] and not result['stationary_scene_qualified']
+
+
+def test_other_cloud_exposure_is_rejected(owner):
+    owner.pipeline.observation['accepted_laser_cloud'].metadata['sequence'] += 1
+    with pytest.raises(ValueError, match='another exposure'):
+        owner.native_laser_snapshot()
