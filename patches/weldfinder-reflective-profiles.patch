+def _window_noise(profiles, lines, starts, stops):
+    """Robust noise of raw neighboring-pixel differences on one shoulder."""
+    lengths = stops-starts
+    result = np.ones(len(lines), float)
+    eligible = lengths >= 4
+    if eligible.any():
+        a, n, rows = starts[eligible], lengths[eligible], lines[eligible]
+        offsets = np.arange(int(n.max()))
+        positions = np.minimum(a[:, None]+offsets, profiles.shape[1]-1)
+        samples = profiles[rows[:, None], positions].astype(float)
+        differences = np.diff(samples, axis=1)
+        differences[offsets[1:] >= n[:, None]] = np.nan
+        center = np.nanmedian(differences, axis=1)
+        sigma = 1.4826/np.sqrt(2)*np.nanmedian(np.abs(differences-center[:, None]), axis=1)
+        result[eligible] = np.maximum(1., sigma)
+    return result
+
