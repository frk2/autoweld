@@ -0,0 +1,141 @@
+"""Reflective surfaces: bounded gain, raw SNR and unmodified native support."""
+from dataclasses import replace
+
+import numpy as np
+import pytest
+
+from weldfinder.config import AutoExposure, Detection
+from weldfinder.detection import extract
+from weldfinder.exposure import ExposureController
+from weldfinder.pointcloud import PointCloudNoise, _run_mask
+from weldfinder.seam import SeamSettings
+
+
+def laser_frame(exposure, gain=0., reflectance=.01):
+    y, _x = np.mgrid[:120, :320]
+    return np.clip(8+reflectance*exposure*10**(gain/20)*np.exp(-.5*((y-35.2)/1.6)**2), 0, 255).astype(np.uint8)
+
+
+def test_gain_is_last_dim_recovery_and_returns_to_low_gain_for_bright_material():
+    controller = ExposureController()
+    config = AutoExposure(enabled=True, gain_enabled=True, max_us=10000., max_gain_db=18.)
+    detection = Detection(threshold=8, min_width=2, max_width=20)
+    controls = dict(exposure_us=1000., gain_db=0.)
+    history=[]
+    for reflectance in (.006, .08):
+        controller.reset()
+        for step in range(80):
+            before = controls.copy()
+            proposal = controller.update_controls(laser_frame(controls['exposure_us'], controls['gain_db'], reflectance=reflectance),
+                detection, config, controls, (20., 20000.), 60., step*.6, (0., 24.))
+            if proposal is not None:
+                controls.update(proposal)
+                history.append((before, controls.copy()))
+            assert 100 <= controls['exposure_us'] <= 10000.
+            assert 0 <= controls['gain_db'] <= 18
+            if controller.stable_checks >= 3:
+                break
+        assert controller.stable_checks >= 3
+        if reflectance == .006:
+            assert controls['gain_db'] >= 6
+        else:
+            assert controls['gain_db'] == 0
+    first_gain = next((before, after) for before, after in history if after['gain_db'] > before['gain_db'])
+    assert first_gain[0]['exposure_us'] >= 9800  # Exposure reaches its cap before amplification.
+
+
+def test_bright_or_ambiguous_view_does_not_ramp_gain_and_manual_gain_is_default():
+    image = laser_frame(1000., reflectance=.1)
+    image += np.roll(image-8, 40, axis=0)
+    controller = ExposureController()
+    config = AutoExposure(gain_enabled=True)
+    controls = dict(exposure_us=10000., gain_db=0.)
+    assert controller.update_controls(image, Detection(threshold=30), config, controls,
+        (20., 20000.), 60., 0., (0., 24.)) is None
+    assert controller.status['gain_state'] == 'holding'
+    assert 'No unique coherent stripe' in controller.status['gain_message']
+    controller.reset()
+    proposal = controller.update_controls(laser_frame(1000., reflectance=.1), Detection(threshold=30),
+        AutoExposure(), dict(exposure_us=1000., gain_db=14.), (20., 20000.), 60., 0., (0., 24.))
+    assert proposal is None or 'gain_db' not in proposal
+
+
+def test_inherited_gain_is_bounded_and_gain_sensor_unknown_never_guessed():
+    controller=ExposureController()
+    config=AutoExposure(gain_enabled=True,max_gain_db=12.)
+    frame=laser_frame(1000.,gain=18.,reflectance=.01)
+    proposal=controller.update_controls(frame,Detection(threshold=20),config,
+        dict(exposure_us=1000.,gain_db=18.),(20.,20000.),60.,0.,(0.,24.))
+    assert proposal['gain_db']==12. and 100 <= proposal['exposure_us'] <= 10000.
+    assert controller.update_controls(frame,Detection(threshold=20),config,
+        dict(exposure_us=1000.,gain_db=18.),(20.,20000.),60.,.1,(0.,24.)) is None
+    controller.reset()
+    proposal=controller.update_controls(frame,Detection(threshold=20),config,
+        dict(exposure_us=1000.,gain_db=18.),(20.,20000.),60.,0.,None)
+    assert proposal is None or 'gain_db' not in proposal
+    assert controller.status['gain_state']=='unavailable'
+
+
+def test_raw_local_noise_rejection_does_not_move_surviving_centroids():
+    rng=np.random.default_rng(2206)
+    y,x=np.mgrid[:160,:320]
+    frame=np.clip(60+rng.normal(0,6,(160,320)) + 85*np.exp(-.5*((y-55.3)/1.6)**2)*(x<180),0,255).astype(np.uint8)
+    detection=Detection(threshold=6,min_width=2,max_width=20)
+    raw=extract(frame,detection)
+    clean=extract(frame,replace(detection,min_snr=4.))
+    raw_noise=(raw.uv[:,0]>=180).sum()
+    clean_noise=(clean.uv[:,0]>=180).sum()
+    assert raw_noise > 100 and clean_noise < raw_noise*.2
+    assert ((clean.uv[:,0]<180)&(np.abs(clean.uv[:,1]-55.3)<1.)).sum()>150
+    original={tuple(uv):i for i,uv in enumerate(raw.uv)}
+    assert all(tuple(uv) in original for uv in clean.uv)
+    assert clean.diagnostics['snr_rejected']>100
+    assert clean.diagnostics['noise_reference']=='raw_scanline_shoulders'
+
+
+def test_short_noise_run_rejection_keeps_both_surfaces_and_sharp_edge_without_interpolation():
+    uv=np.vstack((np.column_stack((np.arange(13),np.full(13,20.))),
+                  np.column_stack((np.arange(13,100),np.full(87,45.))),
+                  np.column_stack((np.arange(120,125),np.full(5,10.))),
+                  np.column_stack((np.arange(160,181),np.full(21,30.)))))
+    noise=PointCloudNoise(enabled=True,min_run_points=12)
+    mask=_run_mask(uv,uv[:,0],'columns',noise)
+    assert mask[:100].all() and not mask[100:105].any() and mask[105:].all()
+    # Both physical flanks retained, though only one is the longest component.
+    np.testing.assert_array_equal(uv[mask][:13,1],np.full(13,20.))
+
+
+@pytest.mark.parametrize('values', [{'gain_enabled':1},{'gain_step_db':0},{'min_gain_db':20,'max_gain_db':10}])
+def test_invalid_gain_configuration_rejected(values):
+    with pytest.raises(ValueError):AutoExposure(**values).validate()
+
+
+@pytest.mark.parametrize('settings', [SeamSettings(feature_kinds=()),SeamSettings(feature_kinds=('fake',)),SeamSettings(feature_kinds=('valley','valley'))])
+def test_feature_kind_filters_are_explicit_and_validated(settings):
+    with pytest.raises(ValueError):settings.validate()
+
+
+def test_recorded_single_pass_noise_orphan_is_removed_without_moving_real_flanks():
+    import json
+    from pathlib import Path
+    sample=json.loads(Path(__file__).with_name('reflective_native_island.json').read_text())
+    uv=np.asarray(sample['uv'])
+    xyz=np.asarray(sample['xyz_mm'])
+    mask=_run_mask(uv,uv[:,0],'columns',PointCloudNoise(enabled=True,min_run_points=12))
+    glint=(uv[:,0]==596)&(uv[:,1]>300)
+    assert glint.sum()==1 and not mask[glint].any()
+    assert mask.sum()>40  # The two native return spans around the island remain.
+    assert np.all(np.isin(uv[mask,0],uv[:,0]))
+    np.testing.assert_array_equal(xyz[mask],np.asarray(sample['xyz_mm'])[mask])
+
+
+def test_explicit_feature_kind_filter_does_not_turn_missing_geometry_into_disappearance():
+    from test_seam import cloud
+    from weldfinder.seam import find_weld_seam
+    native=cloud('step')
+    assert find_weld_seam(native)['found']
+    assert not find_weld_seam(native,settings={'feature_kinds':['inside_corner']})['found']
+    for key in ('uv','xyz_mm'):
+        del native[key][495:505]
+    result=find_weld_seam(native,settings={'feature_kinds':['inside_corner']})
+    assert result['status']=='invalid' and 'gap' in result['quality']['reason']
