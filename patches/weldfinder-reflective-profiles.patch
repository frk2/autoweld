+def project_camera_points(points_mm, calibration, source_id, image_size):
+    """Project predicted camera-mm points through one matching optical model.
+
+    A projected pixel chooses a sensing ROI, never a measured return or seam.
+    Points outside the finite sensor remain explicitly outside, without clipping.
+    """
+    import hashlib
+    import json
+
+    from .optical_identity import optical_intrinsics_id
+
+    calibration.check_frame(source_id, image_size)
+    points = np.asarray(points_mm, dtype=float)
+    if (points.ndim != 2 or points.shape[1] != 3 or not np.isfinite(points).all()
+            or np.any(points[:, 2] <= 0)):
+        raise ValueError('Projection requires finite Nx3 camera millimetres in front of the camera')
+    uv = (cv2.projectPoints(points, np.zeros(3), np.zeros(3),
+        np.asarray(calibration.camera_matrix, float), np.asarray(calibration.distortion, float))[0].reshape(-1, 2)
+        if len(points) else np.empty((0, 2)))
+    if not np.isfinite(uv).all():
+        raise ValueError('Optical projection produced nonfinite native pixels')
+    inside = (uv >= 0).all(axis=1) & (uv < np.asarray(image_size)).all(axis=1)
+    model = calibration.to_dict()
+    return dict(uv=uv.tolist(), inside_image=inside.tolist(), units='px', coordinate_frame='camera_image',
+        source_id=source_id, image_size=list(image_size), optical_intrinsics_id=optical_intrinsics_id(model),
+        calibration_id=hashlib.sha256(json.dumps(model, sort_keys=True,
+            separators=(',', ':'), allow_nan=False).encode()).hexdigest(),
+        projection_only=True, measured=False)
