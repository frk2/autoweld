diff --git a/app/tests/test_reflection_selection.py b/app/tests/test_reflection_selection.py
new file mode 100644
--- /dev/null
+++ b/app/tests/test_reflection_selection.py
@@ -0,0 +1,173 @@
+"""Native optical alternatives remain measured, bounded and explicitly uncertain."""
+from dataclasses import asdict, replace
+import hashlib
+import json
+import os
+from pathlib import Path
+
+import cv2
+import numpy as np
+import pytest
+
+from weldfinder.calibration import Calibration
+from weldfinder.config import Board, Detection
+from weldfinder.detection import _window_medians, _window_noise
+from weldfinder.pipeline import _native_laser_cloud
+from weldfinder.pointcloud import PointCloudNoise, find_laser_point_cloud
+from weldfinder.reflection import compact_cloud_reflection
+
+
+def model():
+    return Calibration('synthetic:reflective', [320, 240], [[500.,0,160.],[0,500.,120.],[0,0,1.]],
+        [0.]*5,.1,asdict(Board(5,7,4.)),laser_plane=[0.,0.,1.,-150.])
+
+
+def config(**values):
+    return Detection(threshold=4,min_snr=4,min_width=2,max_width=20,reflective_mode=True,**values)
+
+
+def measure(frame, detection=None):
+    cal=model()
+    return find_laser_point_cloud(frame,detection or config(),cal,cal.source_id,
+        noise=PointCloudNoise(enabled=True,min_run_points=12),metadata=dict(source_id=cal.source_id,
+        sequence=22,generation=3,acquisition_session_id='one',calibration_id='fixed',optical_intrinsics_id='fixed-optics'))
+
+
+def frame(ridges):
+    y,x=np.mgrid[:240,:320]
+    image=np.full((240,320),10.)
+    for center,width,height,start,stop in ridges:
+        image+=height*np.exp(-.5*((y-center)/width)**2)*((x>=start)&(x<stop))
+    return np.clip(image,0,255).astype(np.uint8)
+
+
+def assert_mapping(cloud):
+    reflection=cloud.metadata['reflection']; table=reflection['candidate_table']
+    selected=reflection['selected_candidate_indices']
+    assert len(selected)==len(set(selected))==len(cloud.xyz_mm)
+    np.testing.assert_array_equal(np.asarray(table['xyz_mm']).reshape(-1,3)[selected],cloud.xyz_mm)
+    np.testing.assert_array_equal(np.asarray(table['uv']).reshape(-1,2)[selected],cloud.uv)
+    assert np.asarray(table['measurement_eligible'])[selected].all()
+    assert reflection['identity']['sequence']==cloud.metadata['sequence']
+    assert reflection['physical_primary_proven'] is False
+
+
+def test_comparable_coherent_returns_are_ambiguous_not_brightest():
+    cloud=measure(frame([(70,1.5,35,10,310),(150,1.5,150,10,310)]))
+    assert cloud.metadata['reflection']['status']=='ambiguous'
+    assert cloud.metadata['reflection']['summary']['unresolved_count']>=500
+    assert not len(cloud.xyz_mm)
+    assert_mapping(cloud)
+
+
+def test_narrow_ridge_preferred_over_broad_diffuse_return_without_moving_pixels():
+    cloud=measure(frame([(70,1.1,30,10,310),(150,8,180,10,310)]))
+    reflection=cloud.metadata['reflection']
+    assert reflection['status']=='resolved_optical'
+    assert reflection['summary']['rejected_counts']['diffuse_competing_return']>=290
