+"""Conservative optical ridge alternatives on one immutable native exposure.
+
+A narrow coherent ridge may be optically preferred to diffuse competition, but
+image statistics never prove which return is the physical primary laser path.
+"""
+from copy import deepcopy
+from dataclasses import replace
+
+import numpy as np
+
+from .detection import _window_noise, extract, intensity
+
+MAX_CANDIDATES = 8000
+MAX_TRACES = 64
+
+
+def compact_reflection(value):
+    if not isinstance(value, dict):
+        return None
+    return {key: deepcopy(value.get(key)) for key in
+            ('status', 'physical_primary_proven', 'summary', 'identity', 'parameters')}
+
+
+def compact_cloud_reflection(cloud):
+    """Shallow transport copy; never traverse dense alternative arrays here."""
+    result = dict(cloud)
+    if 'reflection' in result:
+        result['reflection'] = compact_reflection(result['reflection'])
+    if isinstance(result.get('full_profile'), dict):
+        result['full_profile'] = compact_cloud_reflection(result['full_profile'])
+    return result
+
+
+def _trace_labels(uv, scan, max_gap, max_jump):
+    parent = np.arange(len(uv))
+    def root(i):
+        while parent[i] != i:
+            parent[i] = parent[parent[i]]
+            i = parent[i]
+        return i
+    groups = np.split(np.arange(len(scan)), np.flatnonzero(np.diff(scan)) + 1)
+    for a, b in zip(groups[:-1], groups[1:]):
+        if scan[b[0]] - scan[a[0]] > max_gap:
+            continue
+        distance = abs(uv[a, None, 1] - uv[b, 1])
+        forward, backward = distance.argmin(axis=1), distance.argmin(axis=0)
+        for i, j in enumerate(forward):
+            if backward[j] == i and distance[i, j] <= max_jump:
+                parent[root(b[j])] = root(a[i])
+    _, labels = np.unique([root(i) for i in range(len(uv))], return_inverse=True)
+    return labels
+
+
+def reflective_cloud(frame, detection, calibration, source_id, *, min_depth_mm, max_depth_mm,
+                     metadata, background, noise, background_metadata):
+    from .pointcloud import PointCloud, reconstruct_laser_points, _neighbor_mask, _run_mask
+
+    # Preserve the requested signal/noise floor while retaining all optical
+    # width/saturation alternatives, rather than selecting only one ridge.
+    candidate_config = replace(detection, threshold=detection.threshold, min_width=1,
+        max_width=min(200, max(48, detection.max_width*3)), min_snr=max(2., detection.min_snr),
+        downsample=1, reject_saturated=False)
+    stripe = extract(frame, candidate_config, background)
+    detected_candidate_count = len(stripe.uv)
+    overflow = detected_candidate_count > MAX_CANDIDATES
+    keep = slice(0, MAX_CANDIDATES)
+    for field in ('uv', 'scan', 'strength', 'width', 'saturated'):
+        setattr(stripe, field, getattr(stripe, field)[keep])
+    axis = 0 if detection.axis == 'columns' else 1
+    # Canonical orientation lets the trace linker share its native-pixel rules
+    # for horizontal and vertical profiles without rotating/resizing pixels.
+    graph_uv = stripe.uv if axis == 0 else stripe.uv[:, ::-1]
+    raw = intensity(frame, detection.channel)
+    profiles = raw.T if axis == 0 else raw
+    perpendicular = stripe.uv[:, 1-axis]
+    starts = np.maximum(0, np.floor(perpendicular-stripe.width/2-2).astype(int))
+    stops = np.minimum(profiles.shape[1], np.ceil(perpendicular+stripe.width/2+3).astype(int))
+    margin = np.maximum(8, stripe.width*2)
+    rows = stripe.scan.astype(int)
+    sigma = np.maximum(_window_noise(profiles, rows, np.maximum(0, starts-margin), starts),
+                       _window_noise(profiles, rows, stops, np.minimum(profiles.shape[1], stops+margin)))
+    snr = stripe.strength / sigma
+    roi_px = np.asarray(detection.roi)*np.array([frame.shape[1], frame.shape[0]]*2)
+    lo, hi = roi_px[1-axis], roi_px[3-axis]
+    boundary = (perpendicular-stripe.width/2 <= lo+1) | (perpendicular+stripe.width/2 >= hi-1)
+    eligible = (~stripe.saturated & ~boundary & (stripe.strength >= detection.threshold)
+        & (snr >= detection.min_snr) & (stripe.width >= detection.min_width)
+        & (stripe.width <= detection.max_width))
+    hypothesis = (snr >= 2.) & ~stripe.saturated
+    # Raw native candidate IDs survive ray/depth validation. Multiple native
+    # returns are reconstructed separately and remain explicitly alternatives.
+    candidates = reconstruct_laser_points(stripe.uv, calibration, source_id,
+        [frame.shape[1], frame.shape[0]], min_depth_mm=min_depth_mm, max_depth_mm=max_depth_mm,
+        strength=stripe.strength, width_px=stripe.width, metadata=metadata)
+    lookup = {tuple(uv): i for i, uv in enumerate(stripe.uv)}
+    raw_indices = np.array([lookup[tuple(uv)] for uv in candidates.uv], dtype=int)
+    graph_uv, scan = graph_uv[raw_indices], stripe.scan[raw_indices]
+    eligible, hypothesis, boundary = eligible[raw_indices], hypothesis[raw_indices], boundary[raw_indices]
+    snr, saturated = snr[raw_indices], stripe.saturated[raw_indices]
+    n = len(candidates.uv)
+    labels = _trace_labels(graph_uv, scan, noise.max_scan_gap_px, noise.max_jump_px) if n else np.empty(0, int)
+    raw_labels = labels.copy()
+    raw_trace_count = int(labels.max()+1) if n else 0
+    traces, supported = [], np.zeros(n, bool)
+    labels = np.full(n, -1, int)
+    minimum = max(12, noise.min_run_points if noise.enabled else 0)
+    if n:
+        order = np.argsort(raw_labels, kind='stable')
+        groups = np.split(order, np.flatnonzero(np.diff(raw_labels[order]))+1)
+    else:
+        groups = []
+    trace_count = 0
+    for indices in groups:
+        if len(indices) < minimum:
+            continue
+        reliable = indices[hypothesis[indices]]
+        span = float(np.ptp(scan[indices]))
+        continuity = len(np.unique(scan[reliable]))/max(1., span/detection.sample_step+1)
+        if len(reliable) < minimum or continuity < .6:
+            continue
+        tid = trace_count
+        trace_count += 1
+        if tid >= MAX_TRACES:
+            overflow = True
+            continue
+        labels[indices] = tid
+        supported[indices] = True
+        widths = candidates.width_px[indices]
+        q25, median, q75 = np.percentile(widths, [25, 50, 75])
+        traces.append(dict(trace_id=tid, candidate_indices=indices.tolist(), count=len(indices),
+            scan_span_px=[float(scan[indices[0]]), float(scan[indices[-1]])],
+            width_median_px=float(median), width_iqr_px=float(q75-q25),
+            width_q25_px=float(q25), width_q75_px=float(q75),
+            snr_median=float(np.median(snr[indices])), continuity=float(continuity),
+            measurement_eligible_fraction=float(eligible[indices].mean()),
+            supported=True, selection_status='supported'))
+    diffuse = np.zeros(n, bool)
+    unresolved = np.zeros(n, bool)
+    # Width evidence must be strong, overlap in native scans and involve long
+    # independently coherent traces. Brightness alone never selects a return.
+    good_traces = [trace for trace in traces if trace['supported']]
+    for i, a in enumerate(good_traces):
+        ia = np.asarray(a['candidate_indices'])
+        for b in good_traces[i+1:]:
+            ib = np.asarray(b['candidate_indices'])
+            overlap = np.intersect1d(scan[ia], scan[ib])
+            if len(overlap) < max(12, .2*min(len(ia), len(ib))):
+                continue
+            narrow, broad = (a, b) if a['width_median_px'] < b['width_median_px'] else (b, a)
+            strong_width = (broad['width_median_px'] >= max(6., 2.5*narrow['width_median_px'])
+                and narrow['width_q75_px'] < broad['width_q25_px']*.6)
+            if strong_width and narrow['measurement_eligible_fraction'] >= .6:
+                indices = np.asarray(broad['candidate_indices'])
+                diffuse[indices] = True
+                broad['selection_status'] = 'diffuse_competing_return'
+                narrow['selection_status'] = 'optically_preferred_narrow_return'
+            else:
+                unresolved[ia] = unresolved[ib] = True
+                a['selection_status'] = b['selection_status'] = 'ambiguous_competing_return'
+    # Even disconnected hypotheses on a shared scan are not arbitrary surface
+    # choices. Unsupported speckles may be rejected; long coherent rivals may not.
+    available = supported & ~diffuse
+    if n:
+        scans, counts = np.unique(scan[available], return_counts=True)
+        ambiguous_scans = scans[counts > 1]
+        unresolved |= available & np.isin(scan, ambiguous_scans)
+    selected = eligible & supported & ~diffuse & ~unresolved
+    isolated = np.zeros(n, bool)
+    short_run = np.zeros(n, bool)
+    if noise.enabled:
+        selected_indices = np.flatnonzero(selected)
+        neighbor_keep = _neighbor_mask(candidates.uv[selected], scan[selected], detection.axis, noise)
+        isolated[selected_indices[~neighbor_keep]] = True
+        selected[isolated] = False
+        selected_indices = np.flatnonzero(selected)
+        run_keep = _run_mask(candidates.uv[selected], scan[selected], detection.axis, noise)
+        short_run[selected_indices[~run_keep]] = True
+        selected[short_run] = False
+    if overflow:
+        selected[:] = False
+        status = 'candidate_overflow'
+    elif unresolved.any():
+        status = 'ambiguous'
+    elif selected.any():
+        status = 'resolved_optical'
+    else:
+        status = 'no_supported_returns'
+    selected_indices = np.flatnonzero(selected)
+    rejects = dict(saturated=np.flatnonzero(saturated).tolist(),
+        low_snr_or_contrast=np.flatnonzero((snr < detection.min_snr) | (candidates.strength < detection.threshold)).tolist(),
+        width=np.flatnonzero((candidates.width_px < detection.min_width) | (candidates.width_px > detection.max_width)).tolist(),
+        roi_boundary=np.flatnonzero(boundary).tolist(),
+        insufficient_support=np.flatnonzero(~supported).tolist(),
+        noise_isolated=np.flatnonzero(isolated).tolist(),
+        noise_short_run=np.flatnonzero(short_run).tolist(),
+        diffuse_competing_return=np.flatnonzero(diffuse).tolist(),
+        ambiguous_competing_return=np.flatnonzero(unresolved).tolist())
+    identity = {key: deepcopy((metadata or {}).get(key)) for key in
+        ('source_id', 'sequence', 'generation', 'acquisition_session_id', 'calibration_id',
+         'optical_intrinsics_id', 'read_started', 'received', 'controls', 'timing')}
+    identity.update(source_id=source_id, image_size=[frame.shape[1], frame.shape[0]])
+    summary = dict(status=status, physical_primary_proven=False, method='native_multiridge_v1',
+        detected_candidate_count=detected_candidate_count, valid_candidate_count=n, raw_trace_component_count=raw_trace_count,
+        selected_count=len(selected_indices), unresolved_count=int(unresolved.sum()), trace_count=trace_count,
+        supported_trace_count=len(good_traces), preferred_trace_count=sum(t['selection_status']=='optically_preferred_narrow_return' for t in traces),
+        ambiguous_trace_count=sum(t['selection_status']=='ambiguous_competing_return' for t in traces),
+        rejected_counts={key: len(value) for key, value in rejects.items()}, overflow=bool(overflow),
+        max_candidates=MAX_CANDIDATES, max_traces=MAX_TRACES)
+    reflection = dict(schema='weldfinder.native_reflection.v1', status=status,
+        parameters=dict(roi=list(detection.roi), axis=detection.axis),
+        physical_primary_proven=False, summary=summary, identity=identity,
+        candidate_table=dict(count=n, xyz_mm=candidates.xyz_mm.tolist(), uv=candidates.uv.tolist(),
+            strength=candidates.strength.tolist(), width_px=candidates.width_px.tolist(), scan=scan.tolist(),
+            candidate_indices=list(range(n)), raw_candidate_index=raw_indices.tolist(),
+            raw_trace_id=raw_labels.tolist(), snr=snr.tolist(), saturated=saturated.tolist(),
+            trace_id=labels.tolist(), measurement_eligible=eligible.tolist()), traces=traces,
+        selected_candidate_indices=selected_indices.tolist(),
+        unresolved_candidate_indices=np.flatnonzero(unresolved).tolist(), rejected_reason_indices=rejects)
+    result = PointCloud(candidates.xyz_mm[selected], candidates.uv[selected], candidates.strength[selected],
+        candidates.width_px[selected], dict(metadata or {}, reflection=reflection),
+        dict(candidates.rejected, saturated=int(saturated.sum()), ambiguous=int(unresolved.sum()),
+             noise_isolated=int((~supported | isolated).sum()), noise_short_run=int(short_run.sum()), candidates=n,
+             reflection_diffuse=int(diffuse.sum())))
+    # Preserve the one/two-exposure product boundary exactly as the legacy path.
+    fields = ('source_id', 'image_size', 'acquisition_session_id', 'sequence', 'generation',
+              'read_started', 'received', 'controls', 'timing')
+    constituents = [dict(role='stripe', **{key: deepcopy(identity.get(key)) for key in fields})]
+    if background is not None:
+        constituents.append(dict(role='background', **{key: deepcopy((background_metadata or {}).get(key)) for key in fields}))
+    result.metadata['frame_product'] = dict(kind='single_frame' if background is None else 'background_subtracted',
+        constituents=constituents, motion_validity='not_assessed' if background is None else 'unverified_multi_frame',
+        requires_stationary_scene=background is not None)
+    return result
