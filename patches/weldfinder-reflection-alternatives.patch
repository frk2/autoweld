+def test_exact_finite_window_optimization_matches_reference():
+    rng=np.random.default_rng(71031)
+    profiles=rng.normal(20,5,(20,100)).astype(np.float32)
+    lines=np.arange(20);starts=rng.integers(0,70,20);stops=starts+rng.integers(0,30,20)
+    expected=np.array([np.median(profiles[line,a:b]) if b>a else 0 for line,a,b in zip(lines,starts,stops)],np.float32).astype(float)
+    np.testing.assert_array_equal(_window_medians(profiles,lines,starts,stops),expected)
+    noise=[]
+    for line,a,b in zip(lines,starts,stops):
+        diff=np.diff(profiles[line,a:b].astype(float))
+        noise.append(max(1,1.4826/np.sqrt(2)*np.median(abs(diff-np.median(diff)))) if b-a>=4 else 1.)
+    np.testing.assert_array_equal(_window_noise(profiles,lines,starts,stops),noise)
+
