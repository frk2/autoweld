+@pytest.mark.parametrize('roi', [[0,0,1,1], [.2,.15,.8,.45]])
+def test_native_scope_parameters_survive_compact_transport_without_aliasing(roi):
+    expected=roi.copy()
+    detection=config(roi=roi)
+    cloud=measure(frame([(70,1.5,80,10,310)]),detection)
+    reflection=cloud.metadata['reflection']
+    assert reflection['parameters']==dict(roi=roi,axis='columns')
+    compact=compact_cloud_reflection(cloud.to_dict())
+    assert compact['reflection']['parameters']==reflection['parameters']
+    detection.roi[0]=.1
+    assert reflection['parameters']['roi']==expected
+    # The caller's mutable config and transport copy cannot replace provenance.
+    before=reflection['parameters']['roi'].copy()
+    compact['reflection']['parameters']['roi'][0]=.15
+    assert reflection['parameters']['roi']==before
