+@pytest.mark.parametrize('observation,expected', [('0006','ambiguous'),('0008','resolved_optical'),
+    ('0015','resolved_optical'),('0047','resolved_optical'),('0053','ambiguous')])
+def test_recorded_native_reflection_failures(observation,expected):
+    # Integration evidence stays in AutoWeld, preserving original full PNGs.
+    evidence=os.environ.get('WELDFINDER_REFLECTION_EVIDENCE')
+    calibration_path=os.environ.get('WELDFINDER_REFLECTION_CALIBRATION')
+    if not evidence or not calibration_path:
+        pytest.skip('Set recorded evidence and calibration paths to replay original native photographs')
+    directory=Path(evidence)/f'obs-{observation}'
+    snapshot=json.loads((directory/'snapshot.json').read_text());meta=snapshot['metadata']
+    cal=Calibration.load(calibration_path)
+    identity=hashlib.sha256(json.dumps(cal.to_dict(),sort_keys=True,separators=(',',':'),allow_nan=False).encode()).hexdigest()
+    assert identity==meta['calibration_id']
+    png=(directory/'native.png').read_bytes()
+    assert hashlib.sha256(png).hexdigest()==snapshot['image']['sha256']
+    image=cv2.imdecode(np.frombuffer(png,np.uint8),cv2.IMREAD_UNCHANGED)
+    assert hashlib.sha256(image.tobytes()).hexdigest()==snapshot['image']['native_pixels_sha256']
+    detection=replace(Detection(**snapshot['measurement_settings']['detection']),roi=[0,0,1,1],reflective_mode=True)
+    cloud=find_laser_point_cloud(image,detection,cal,cal.source_id,metadata=meta,
+        noise=PointCloudNoise(**snapshot['measurement_settings']['noise']))
+    assert cloud.metadata['reflection']['status']==expected
+    assert_mapping(cloud)
+    if observation=='0015':
+        assert cloud.metadata['reflection']['summary']['rejected_counts']['diffuse_competing_return']>600
+
