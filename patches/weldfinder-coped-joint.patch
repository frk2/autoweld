+import json
+import time
+
+import numpy as np
+
+from weldfinder.calibration_camera import CalibrationCamera
+from weldfinder.pointcloud import PointCloud
+
+
+def test_native_diagnostics_reads_expired_metadata_without_sdk_or_arrays(tmp_path):
+    def forbidden_factory(*_args):
+        raise AssertionError('Diagnostics must never open a camera')
+
+    owner = CalibrationCamera(tmp_path, factory=forbidden_factory)
+    try:
+        old = time.monotonic()-10
+        pipeline = owner.pipeline
+        pipeline.latest_frame = {'frame': np.zeros((10, 10), np.uint8), 'read_started': old,
+                                     'received': old+.01, 'sequence': 12, 'generation': 3}
+        pipeline.latest_preview = {'image': np.ones((5, 5, 3)), 'read_started': old, 'sequence': 12}
+        pipeline.observation = {'frame': np.zeros((10, 10)), 'read_started': old, 'sequence': 11,
+                                    'published': old+3.5, 'analysis_ms': 3500.}
+        pipeline.pointcloud = PointCloud(np.ones((3, 3)), np.ones((3, 2)), np.ones(3), np.ones(3),
+            {'read_started': old, 'sequence': 11, 'processing': {'xyz_ms': 3500., 'total_analysis_ms': 3501.}},
+            {'ambiguous': 7})
+        before = pipeline.pointcloud
+        diagnostics = owner.native_diagnostics()
+        assert diagnostics['raw_latest_frame']['age_s'] >= 10
+        assert diagnostics['raw_observation']['analysis_ms'] == 3500.
+        assert diagnostics['raw_pointcloud']['processing']['xyz_ms'] == 3500.
+        assert diagnostics['raw_pointcloud']['count'] == 3
+        assert diagnostics['raw_pointcloud']['rejected'] == {'ambiguous': 7}
+        assert diagnostics['threads'] == {'acquisition': None, 'analysis': None}
+        assert diagnostics['queues'] == {'acquisition_commands': 0, 'analysis_commands': 0}
+        assert pipeline.pointcloud is before and pipeline.thread is None
+        assert 'frame' not in diagnostics['raw_latest_frame']
+        assert 'image' not in diagnostics['latest_preview']
+        json.dumps(diagnostics, allow_nan=False)
+        diagnostics['raw_pointcloud']['processing']['xyz_ms'] = -1
+        assert before.metadata['processing']['xyz_ms'] == 3500.
+    finally:
+        owner.close()
