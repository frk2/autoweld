+import copy
+
+import numpy as np
+import pytest
+from scipy.spatial.transform import Rotation
+
+from weldfinder.coped_joint import (
+    coping_reference_pose,
+    fit_coped_joint,
+    project_coping_seam,
+    sample_coping_curve,
+)
+
+
+def model(angle=90., offset=0., radius=(12.7, 12.7), rotation=None, translation=(0., 0., 0.)):
+    q = np.eye(3) if rotation is None else rotation
+    o = np.array(translation)
+    beta = np.deg2rad(angle)
+    return {'schema': 'weldfinder.coped_joint.v1', 'units': 'mm', 'coordinate_frame': 'camera',
+                'joint_angle_deg': angle, 'center_mm': o.tolist(), 'frame_rotation': q.tolist(),
+                'axis_offset_mm': offset, 'axis_role_ambiguous': True,
+                'axes': [{'origin_mm': o.tolist(), 'direction': q[:, 0].tolist(), 'radius_mm': radius[0]},
+                      {'origin_mm': (o+offset*q[:, 2]).tolist(),
+                           'direction': (np.cos(beta)*q[:, 0]+np.sin(beta)*q[:, 1]).tolist(), 'radius_mm': radius[1]}]}
+
+
+def intersection(theta, angle=90., offset=0., radius=(12.7, 12.7)):
+    v, w = radius[0]*np.cos(theta), radius[0]*np.sin(theta)
+    u = (np.cos(np.deg2rad(angle))*v+np.sqrt(radius[1]**2-(w-offset)**2))/np.sin(np.deg2rad(angle))
+    return np.array([u, v, w])
+
+
+def profiles(angle=90., offset=.25, noise=.025, outliers=0., seed=4, poses=12, phase_span=.65):
+    rng = np.random.default_rng(seed)
+    q = Rotation.from_rotvec([.2, -.3, .4]).as_matrix()
+    translation = np.array([15., -8., 150.])
+    result = []
+    beta = np.deg2rad(angle)
+    for i, phase in enumerate(np.linspace(-phase_span, phase_span, poses)):
+        root = intersection(phase, angle, offset)
+        u = np.linspace(root[0]+10, root[0]+.1, 70)
+        first = np.column_stack([u, np.full(len(u), root[1]), np.full(len(u), root[2])])
+        v = np.linspace(root[1]-.1, root[1]-10, 70)
+        along = (np.cos(beta)*v+np.sqrt(12.7**2-(root[2]-offset)**2))/np.sin(beta)
+        second = np.column_stack([along, v, np.full(len(v), root[2])])
+        p = np.r_[first, second]
+        p += rng.normal(0, noise, p.shape)
+        if outliers:
+            select = rng.random(len(p)) < outliers
+            p[select] += rng.normal(0, 2, (select.sum(), 3))
+        p = p@q.T+translation
+        result.append({'xyz_mm': p.tolist(), 'seam_point_mm': (q@root+translation).tolist(),
+                           'profile_id': f'profile-{i}', 'provenance': {'sequence': i, 'source_id': 'synthetic'}})
+    return result, q, translation
+
+
+@pytest.mark.parametrize('angle', [60., 90., 120.])
+def test_known_radius_angle_fit_rotation_and_heldout_profiles(angle):
+    measured, q, _translation = profiles(angle=angle)
+    original = copy.deepcopy(measured)
+    result = fit_coped_joint(measured, joint_angle_deg=angle, centerline_relation='free')
+    assert result['status'] == 'qualified', result['quality']
+    fitted = result['model']
+    expected = [q[:, 0], np.cos(np.deg2rad(angle))*q[:, 0]+np.sin(np.deg2rad(angle))*q[:, 1]]
+    for axis, direction in zip(fitted['axes'], expected):
+        assert abs(np.dot(axis['direction'], direction)) > .999
+        assert axis['radius_mm'] == 12.7
+    assert np.dot(fitted['axes'][0]['direction'], fitted['axes'][1]['direction']) == pytest.approx(
+        np.cos(np.deg2rad(angle)), abs=1e-10)
+    assert abs(abs(fitted['axis_offset_mm'])-.25) < .05
+    assert result['quality']['heldout_robust_rms_mm'] < .05
+    assert result['model']['axis_role_ambiguous']
+    assert measured == original
+    assert result['quality']['accuracy_qualified'] is False
+
+
+def test_robust_mixture_reports_outliers_without_moving_native_points():
+    measured, _, _ = profiles(outliers=.06)
+    result = fit_coped_joint(measured)
+    assert result['status'] == 'qualified', result['quality']
+    classification = result['classification']
+    assert .85 < np.mean(classification['inlier_mask']) < .99
+    assert result['quality']['inlier_rms_mm'] < .12
+    assert result['quality']['all_point_rms_mm'] > result['quality']['inlier_rms_mm']
+    assert len(classification['surface_labels']) == len(classification['residuals_mm'])
+
+
+def test_repeated_single_section_cannot_qualify_axes():
+    measured, _, _ = profiles(poses=4, phase_span=0., noise=0.)
+    result = fit_coped_joint(measured)
+    assert result['status'] in ('unobservable', 'ambiguous'), result['quality']
+    assert result['model'] is None
+
+
+def test_curve_stays_on_both_surfaces_and_predicts_only_one_root():
+    m = model(angle=60., offset=.4)
+    seed = intersection(.1, angle=60., offset=.4)
+    result = sample_coping_curve(m, seed, span_deg=80.)
+    assert result['status'] == 'complete'
+    points = np.array(result['points_mm'])
+    for axis in m['axes']:
+        delta = points-axis['origin_mm']
+        a = np.array(axis['direction'])
+        radial = delta-(delta@a)[:, None]*a
+        np.testing.assert_allclose(np.linalg.norm(radial, axis=1), 12.7, atol=1e-8)
+    assert result['predicted_only']
+    for p, center, inward in zip(points, result['centerline_points_mm'], result['inward_directions']):
+        np.testing.assert_allclose(np.array(center)-p, np.array(inward)*12.7, atol=1e-8)
+
+
+def test_equal_radius_crown_reports_cusp_instead_of_cross_normal_nan():
+    m = model()
+    result = sample_coping_curve(m, intersection(0.), span_deg=180.)
+    assert result['status'] == 'partial'
+    assert any(row['reason'] == 'crown_cusp_two_one_sided_tangents' for row in result['unresolved'])
+    assert np.isfinite(result['points_mm']).all()
+    assert result['tangents'][0] is None and result['tangents'][-1] is None
+    with pytest.raises(ValueError, match='ambiguous.*crown'):
+        sample_coping_curve(m, [0., 0., 12.7])
+
+
+def test_axis_offset_creates_explicit_nonintersection_domain():
+    m = model(offset=1.)
+    result = sample_coping_curve(m, intersection(0., offset=1.), span_deg=220.)
+    assert result['status'] == 'partial'
+    assert any(row['reason'] == 'no_real_surface_intersection' for row in result['unresolved'])
+    with pytest.raises(ValueError, match='associate'):
+        sample_coping_curve(model(offset=30.), intersection(0.))
+
+
+def test_torch_pose_points_inward_at_exact_standoff_and_matches_tangent():
+    m = model(angle=60., offset=.3)
+    seed = intersection(.3, angle=60., offset=.3)
+    pose = np.array(coping_reference_pose(m, seed))
+    center = np.array([seed[0], 0, 0])
+    inward = (center-seed)/np.linalg.norm(center-seed)
+    np.testing.assert_allclose(pose[:3, 2], inward)
+    np.testing.assert_allclose(pose[:3, 3]+150*pose[:3, 2], seed)
+    np.testing.assert_allclose(pose[:3, :3].T@pose[:3, :3], np.eye(3), atol=1e-10)
+    assert np.linalg.det(pose[:3, :3]) == pytest.approx(1.)
+
+
+def test_projection_keeps_measured_geometry_and_rejects_remote_points():
+    m = model(offset=.3)
+    seed = intersection(0., offset=.3)
+    measured = np.array([intersection(a, offset=.3) for a in [-.3, 0, .3]])
+    measured += [.04, .02, -.03]
+    measured = np.r_[measured, [[100., 100., 100.]]]
+    before = measured.copy()
+    result = project_coping_seam(m, measured, seed)
+    assert [r['associated'] for r in result['associations']] == [True, True, True, False]
+    np.testing.assert_array_equal(measured, before)
+    for row, actual in zip(result['associations'], measured):
+        np.testing.assert_array_equal(row['measured_point_mm'], actual)
+        assert row['prediction_is_measurement'] is False
+
+
+def test_model_reference_is_rigid_transform_equivariant():
+    q = Rotation.from_rotvec([.3, -.2, .1]).as_matrix()
+    translation = np.array([20., -10., 130.])
+    a, b = model(offset=.3), model(offset=.3, rotation=q, translation=translation)
+    point = intersection(.2, offset=.3)
+    first = np.array(coping_reference_pose(a, point))
+    second = np.array(coping_reference_pose(b, q@point+translation))
+    np.testing.assert_allclose(second[:3, :3], q@first[:3, :3], atol=1e-8)
+    np.testing.assert_allclose(second[:3, 3], q@first[:3, 3]+translation, atol=1e-8)
+
+
+def test_declared_frame_and_input_bounds_are_enforced():
+    measured, _, _ = profiles()
+    measured[0]['coordinate_frame'] = 'other'
+    with pytest.raises(ValueError, match='frames differ'):
+        fit_coped_joint(measured)
+    with pytest.raises(ValueError, match='joint_angle'):
+        fit_coped_joint(measured, joint_angle_deg=0.)
+    with pytest.raises(ValueError, match='3..512'):
+        fit_coped_joint(measured[:2])
+    measured = [{'xyz_mm': np.zeros((30, 3)).tolist()} for _ in range(3)]
+    result = fit_coped_joint(measured)
+    assert result['status'] == 'unobservable'
+
+
+def test_nominal_prior_is_explicit_when_small_skew_has_no_material_heldout_benefit():
+    measured, _, _ = profiles(offset=.25)
+    result = fit_coped_joint(measured)
+    assert result['status'] == 'qualified'
+    assert result['model']['axis_offset_mm'] == 0.
+    comparison = result['model_comparison']
+    assert comparison['selected'] == 'intersecting'
+    assert comparison['free']['model']['axis_offset_mm'] != 0.
+    assert comparison['heldout_improvement_mm'] < comparison['required_improvement_mm']
+    assert 'prior' in comparison['nominal_prior']
+    assert comparison['offset_uncertainty']['absolute_accuracy'] is False
+
+
+def test_material_stable_offset_can_override_intersection_prior():
+    measured, _, _ = profiles(offset=2., phase_span=.8)
+    result = fit_coped_joint(measured)
+    assert result['status'] == 'qualified', result['quality']
+    assert result['model_comparison']['selected'] == 'free'
+    assert abs(abs(result['model']['axis_offset_mm'])-2.) < .1
+    assert result['model_comparison']['offset_uncertainty']['stable_nonzero']
+
+
+def test_crown_between_sampling_nodes_is_not_silently_smooth():
+    result = sample_coping_curve(model(), intersection(.13), span_deg=180., step_deg=1.)
+    assert result['status'] == 'partial'
+    events = [e for e in result['events'] if e['reason'] == 'crown_cusp_two_one_sided_tangents']
+    assert events
+    assert any(abs(event['relative_angle_deg']-round(event['relative_angle_deg'])) > .01 for event in events)
+    assert events[0]['one_sided_tangents']['negative_side'] is not None
+    assert events[0]['one_sided_tangents']['positive_side'] is not None
+
+
+def test_classification_covers_all_original_returns_without_model_substitution():
+    measured, _, _ = profiles()
+    result = fit_coped_joint(measured, centerline_relation='intersecting')
+    assert len(result['classification']['surface_labels']) == sum(len(p['xyz_mm']) for p in measured)
+    assert len(result['classification']['profile_indices']) == sum(len(p['xyz_mm']) for p in measured)
+
+
+
+def test_three_profile_scout_cannot_skip_whole_profile_holdout():
+    measured, _, _ = profiles(poses=3, phase_span=.7)
+    result = fit_coped_joint(measured, centerline_relation='intersecting')
+    if result['status'] == 'qualified':
+        assert result['quality']['heldout_profile_ids'] == [0]
+        assert result['quality']['heldout_robust_rms_mm'] is not None
+    else:
+        assert result['model'] is None
