+import copy
+import json
+
+import numpy as np
+import pytest
+from weldfinder import select_coped_surface_returns
+
+
+def cloud(pixels):
+    pixels = np.asarray(pixels, float).reshape(-1, 2)
+    return dict(units='mm', coordinate_frame='camera', uv=pixels.tolist(),
+                xyz_mm=np.column_stack((pixels[:, 0]/20., pixels[:, 1]/20., np.full(len(pixels), 150.))).tolist(),
+                source_id='recorded-source', sequence=14, calibration_id='unchanged',
+                strength=[100.]*len(pixels), width_px=[5.]*len(pixels))
+
+
+def test_six_return_glare_island_does_not_outvote_supported_surface_runs():
+    first = [[i, 225.] for i in range(20)]
+    glare = [[i, 475.] for i in range(25, 31)]
+    second = [[i, 225.] for i in range(36, 56)]
+    native = cloud(first+glare+second)
+    before = copy.deepcopy(native)
+    selected = select_coped_surface_returns(native)
+    assert selected['status'] == 'selected'
+    assert selected['native_point_indices'] == [*range(20), *range(26, 46)]
+    assert native == before
+    diagnostics = selected['diagnostics']
+    assert diagnostics['input_point_count'] == 46
+    assert diagnostics['selected_point_count'] == 40
+    assert diagnostics['rejected_point_count'] == 6
+    assert diagnostics['native_geometry_preserved']
+    assert diagnostics['runs'] == [
+        dict(native_start_index=0, native_stop_index_exclusive=20, point_count=20, selected=True),
+        dict(native_start_index=20, native_stop_index_exclusive=26, point_count=6, selected=False),
+        dict(native_start_index=26, native_stop_index_exclusive=46, point_count=20, selected=True)]
+    # This filter never consults signal strength, nominal geometry or a seam prediction.
+    native.update(strength=[0.]*46, width_px=[100.]*46, predicted_seam=[1., 2., 3.])
+    assert select_coped_surface_returns(native)['native_point_indices'] == selected['native_point_indices']
+    json.dumps(selected, allow_nan=False)
+
+
+def test_exact_gap_and_jump_limits_remain_connected_but_larger_breaks_do_not_bridge():
+    native = cloud([[3*i, 8*i] for i in range(12)])
+    assert select_coped_surface_returns(native)['native_point_indices'] == list(range(12))
+    split = cloud([[i, 0.] for i in range(6)]+[[10+i, 0.] for i in range(6)])
+    assert select_coped_surface_returns(split)['native_point_indices'] == []
+    split = cloud([[i, 0.] for i in range(6)]+[[6+i, 8.01] for i in range(6)])
+    assert select_coped_surface_returns(split)['native_point_indices'] == []
+
+
+def test_twelve_actual_points_required_without_interpolating_missing_pixels():
+    assert select_coped_surface_returns(cloud([[i, 0] for i in range(11)]))['status'] == 'no_supported_runs'
+    assert select_coped_surface_returns(cloud([[i, 0] for i in range(12)]))['native_point_indices'] == list(range(12))
+    selected = select_coped_surface_returns(cloud([[i, 0] for i in range(6)]), min_run_points=6,
+                                           max_scan_gap_px=1., max_jump_px=0.)
+    assert selected['native_point_indices'] == list(range(6))
+    assert selected['diagnostics']['parameters'] == dict(min_run_points=6, max_scan_gap_px=1., max_jump_px=0.)
+
+
+def test_numpy_arrays_are_not_written_or_replaced():
+    native = cloud([[i, 1.] for i in range(15)])
+    native['uv'] = np.asarray(native['uv'])
+    native['xyz_mm'] = np.asarray(native['xyz_mm'])
+    native['uv'].flags.writeable = native['xyz_mm'].flags.writeable = False
+    pixels, points = native['uv'], native['xyz_mm']
+    result = select_coped_surface_returns(native, min_run_points=np.int64(12), max_scan_gap_px=np.float64(3))
+    assert native['uv'] is pixels and native['xyz_mm'] is points
+    assert result['native_point_indices'] == list(range(15))
+    assert all(type(i) is int for i in result['native_point_indices'])
+
+
+def test_empty_native_acquisition_has_no_manufactured_surface():
+    result = select_coped_surface_returns(dict(units='mm', coordinate_frame='camera', xyz_mm=[], uv=[]))
+    assert result['status'] == 'no_supported_runs'
+    assert result['native_point_indices'] == []
+    assert result['diagnostics']['connected_run_count'] == 0
+    assert result['diagnostics']['input_point_count'] == 0
+
+
+@pytest.mark.parametrize('changed', [dict(units='m'), dict(coordinate_frame='robot_base'),
+    dict(xyz_mm=[[1., 2.]]), dict(uv=[[0., 1.]]), dict(uv=[[0., -1.]]),
+    dict(xyz_mm=[[np.nan, 0., 1.]]*12), dict(uv=[[float('inf'), 0.]]*12),
+    dict(uv=[[0., 0.]]*12), dict(uv=[[12-i, 0.] for i in range(12)])])
+def test_invalid_native_arrays_frames_or_order_fail_closed(changed):
+    native = cloud([[i, 0.] for i in range(12)])
+    native.update(changed)
+    with pytest.raises(ValueError):
+        select_coped_surface_returns(native)
+
+
+@pytest.mark.parametrize('parameters', [dict(min_run_points=True), dict(min_run_points=0),
+    dict(min_run_points=12.), dict(min_run_points=400001), dict(max_scan_gap_px=False),
+    dict(max_scan_gap_px=0), dict(max_scan_gap_px=np.nan), dict(max_jump_px=-1),
+    dict(max_jump_px=np.inf), dict(max_jump_px=True)])
+def test_invalid_support_parameters_fail_closed(parameters):
+    with pytest.raises(ValueError):
+        select_coped_surface_returns(cloud([[i, 0.] for i in range(12)]), **parameters)
+
+
+def test_cloud_dictionary_and_both_native_arrays_are_required():
+    with pytest.raises(TypeError):
+        select_coped_surface_returns([])
+    with pytest.raises(ValueError):
+        select_coped_surface_returns(dict(units='mm', coordinate_frame='camera', xyz_mm=[]))
