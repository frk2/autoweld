 from .config import AutoExposure, Detection
 from .optical_identity import optical_intrinsics_id
 from .pointcloud import PointCloudNoise
+
+
+def _accepted_laser_overlay(rgb, observation):
+    """Paint only accepted UV measured on this original frame; no inference."""
+    identity = observation.get('accepted_laser_identity')
+    points = observation.get('accepted_laser_uv')
+    info = dict(status='unavailable', count=0, color_rgb=[40, 255, 80],
+                source='accepted_native_laser_uv', native_measurements_unchanged=True,
+                message=observation.get('accepted_laser_error'))
+    if identity is None or points is None:
+        return info
+    fields = ('source_id', 'sequence', 'generation', 'acquisition_session_id', 'calibration_id')
+    if any(identity.get(key) is None or identity.get(key) != observation.get(key) for key in fields):
+        info['message'] = 'Laser returns do not match preview acquisition'
+        return info
+    uv = np.asarray(points, dtype=float)
+    frame = observation['frame']
+    if uv.ndim != 2 or uv.shape[1] != 2:
+        info['message'] = 'Invalid native laser pixel array'
+        return info
+    size = np.array([frame.shape[1], frame.shape[0]])
+    valid = np.isfinite(uv).all(axis=1) & (uv >= 0).all(axis=1) & (uv < size).all(axis=1)
+    uv = uv[valid]
+    # Separate X/Y scaling matters when a reduced preview rounds its height.
+    scale = np.array([rgb.shape[1], rgb.shape[0]], dtype=float)/size
+    for point in np.rint(uv*scale).astype(int):
+        # Dots only: never bridge missing returns into an apparent laser line.
+        center = tuple(np.minimum(point, [rgb.shape[1]-1, rgb.shape[0]-1]))
+        cv2.circle(rgb, center, 2, (0, 0, 0), -1, cv2.LINE_AA)
+        cv2.circle(rgb, center, 1, (40, 255, 80), -1, cv2.LINE_AA)
+    info.update(status='measured', count=len(uv), message=None)
+    return info
 
 
