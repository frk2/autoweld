diff --git a/app/tests/test_laser_preview_overlay.py b/app/tests/test_laser_preview_overlay.py
new file mode 100644
--- /dev/null
+++ b/app/tests/test_laser_preview_overlay.py
@@ -0,0 +1,93 @@
+"""Accepted stripe pixels stay tied to their own original preview acquisition."""
+import base64
+import copy
+import time
+
+import cv2
+import numpy as np
+import pytest
+from test_laser_facade import Facade
+from weldfinder.laser_facade import _accepted_laser_overlay
+from weldfinder.pointcloud import PointCloud
+
+
+def observation():
+    identity = dict(source_id='fixture:laser', generation=4, sequence=10,
+                    acquisition_session_id='fixture:session', calibration_id='full:model')
+    return {**identity, 'accepted_laser_identity': dict(identity),
+            'frame': np.zeros((480, 640), np.uint8),
+            'preview': np.zeros((96, 160, 3), np.uint8),
+            'accepted_laser_uv': np.array([[80., 80.], [560., 400.],
+                [np.nan, 200.], [-1., 50.], [640., 100.], [50., 480.]])}
+
+
+def test_native_accepted_points_scale_per_axis_without_bridging_or_mutation():
+    obs = observation()
+    before = copy.deepcopy(obs)
+    image = obs['preview'].copy()
+    info = _accepted_laser_overlay(image, obs)
+    assert info['status'] == 'measured' and info['count'] == 2
+    assert info['source'] == 'accepted_native_laser_uv'
+    # Native 640x480 ->160x96; Y scale deliberately differs from X scale.
+    np.testing.assert_array_equal(image[16, 20], [40, 255, 80])
+    np.testing.assert_array_equal(image[80, 140], [40, 255, 80])
+    np.testing.assert_array_equal(image[48, 80], [0, 0, 0])
+    for name in ('frame', 'preview', 'accepted_laser_uv'):
+        np.testing.assert_array_equal(obs[name], before[name])
+
+
+@pytest.mark.parametrize('field', ['source_id', 'sequence', 'generation',
+                                  'acquisition_session_id', 'calibration_id'])
+def test_other_acquisition_cannot_paint_points_on_current_frame(field):
+    obs = observation()
+    obs['accepted_laser_identity'][field] = 'another acquisition'
+    image = obs['preview'].copy()
+    info = _accepted_laser_overlay(image, obs)
+    assert info['status'] == 'unavailable' and info['count'] == 0
+    assert 'do not match' in info['message']
+    assert not image.any()
+
+
+def test_preview_uses_its_own_returns_even_when_latest_cloud_is_different():
+    owner = Facade()
+    snap = owner.pipeline.state
+    obs = snap['observation']
+    retained = observation()
+    obs.update({key: retained[key] for key in ('accepted_laser_identity', 'accepted_laser_uv', 'preview')})
+    # Latest 3D cloud has advanced independently; its UV must never be painted.
+    newer = {**obs['accepted_laser_identity'], 'sequence': 11, 'read_started': time.monotonic()}
+    snap['pointcloud'] = PointCloud(np.array([[1., 2., 150.]]),
+        np.array([[320., 240.]]), np.array([200.]), np.array([3.]), newer)
+    state = owner._laser_state(snap, include_frame=True)
+    meta = state['preview_frame']
+    assert meta['sequence'] == 10 and state['cloud']['sequence'] == 11
+    assert meta['laser_points_overlay']['count'] == 2
+    image = cv2.imdecode(np.frombuffer(base64.b64decode(state['frame_jpeg_base64']), np.uint8), cv2.IMREAD_COLOR)
+    assert int(image[16, 20, 1]) > int(image[16, 20, 2]) + 50
+    assert not image[48, 80].any()
+    # Unchanged observation uses cached JPEG and compact metadata.
+    repeated = owner._laser_state(snap, include_frame=True)
+    assert repeated['frame_jpeg_base64'] == state['frame_jpeg_base64']
+    assert repeated['preview_frame']['laser_points_overlay'] == meta['laser_points_overlay']
+    assert 'accepted_laser_uv' not in meta
+    assert 'accepted_laser_identity' not in meta
+
+
+def test_zero_returns_and_unavailable_detection_are_explicit_and_stale_frame_clears():
+    owner = Facade()
+    snap = owner.pipeline.state
+    obs = snap['observation']
+    obs['accepted_laser_uv'] = np.empty((0, 2))
+    obs['accepted_laser_identity'] = {key: obs[key] for key in (
+        'source_id', 'generation', 'sequence', 'acquisition_session_id', 'calibration_id')}
+    state = owner._laser_state(snap, include_frame=True)
+    assert state['preview_frame']['laser_points_overlay']['status'] == 'measured'
+    assert state['preview_frame']['laser_points_overlay']['count'] == 0
+    obs.update(sequence=11, accepted_laser_uv=None, accepted_laser_identity=None,
+               accepted_laser_error='Camera controls settling; XYZ unavailable')
+    state = owner._laser_state(snap, include_frame=True)
+    assert state['preview_frame']['laser_points_overlay']['status'] == 'unavailable'
+    assert state['preview_frame']['laser_points_overlay']['count'] == 0
+    obs['read_started'] = time.monotonic()-2
+    state = owner._laser_state(snap, include_frame=True)
+    assert state['frame_jpeg_base64'] is None and state['preview_frame'] is None
