#13 = DIRECTION('',(0.,0.,1.));
#14 = DIRECTION('',(1.,0.,-0.));
#15 = GEOMETRIC_CURVE_SET('',(#16));
#16 = TRIMMED_CURVE('',#17,(#22,PARAMETER_VALUE(0.)),(#23,
    PARAMETER_VALUE(8.726646259974E-02)),.T.,.PARAMETER.);
#17 = CIRCLE('',#18,49.999999999986);
#18 = AXIS2_PLACEMENT_3D('',#19,#20,#21);
#19 = CARTESIAN_POINT('',(299.12737902892,-36.90613340099,
